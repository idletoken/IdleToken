# IdleToken platform Agent — standalone build.
#
# Same philosophy as Makefile.privacy (which it deliberately does not touch):
# the agent is portable C (vendored TweetNaCl + BLAKE2b, system libcurl on
# Unix and pinned static Schannel curl on Windows). No GPU, CUDA or cluster
# is needed. It reuses the privacy/net/http common
# objects by compiling them from their unmodified sources.
#
#   make -f Makefile.platform          # build build/idletoken-platform-agent
#   make -f Makefile.platform clean
#
# Oracle: scripts/platform_agent_e2e.sh (builds this, then runs the
# cross-language e2e against the real platform gateway).

CC       ?= cc
CFLAGS   ?= -O2 -std=c99 -Wall -Wextra
INCLUDES := -Iinclude -Ivendor/tweetnacl -Ivendor/blake2 -Ivendor/puff
LDLIBS   :=
include scripts/platform-http.mk
CFLAGS += $(PLATFORM_HTTP_CFLAGS)
LDLIBS += $(PLATFORM_HTTP_LIBS)

# The agent spawns one thread per connection (see the concurrency section in
# platform_agent.c). On macOS pthread lives in libc, and so it does on recent
# glibc, so omitting -pthread goes unnoticed on both -- but other libcs do need
# it, and that failure shows up at link time, far from its cause. Be explicit.
ifneq ($(OS),Windows_NT)
  CFLAGS += -pthread
  LDLIBS += -pthread
endif

# Windows needs bcrypt for BCryptGenRandom (randombytes in privacy.c).
ifeq ($(OS),Windows_NT)
  LDLIBS += -lbcrypt -lwinhttp
endif

BUILD := build/platform
BIN   := build/idletoken-platform-agent
CLIENT_PACKAGE := client/package.json
VERSION_HEADER := $(BUILD)/client-version.h

# Crypto + common objects (compiled from existing sources, unmodified).
OBJS := $(BUILD)/tweetnacl.o \
        $(BUILD)/blake2b.o \
        $(BUILD)/privacy.o \
        $(BUILD)/sodium_seal.o \
        $(BUILD)/net.o \
        $(BUILD)/http.o \
        $(BUILD)/b64.o \
        $(BUILD)/apiconv.o \
        $(BUILD)/admission.o \
        $(BUILD)/deflate_wire.o \
        $(BUILD)/puff.o \
        $(BUILD)/platform_http.o \
        $(BUILD)/platform_proxy.o \
        $(BUILD)/platform_agent.o

.PHONY: all clean httpcheck
all: $(BIN)

$(BUILD):
	@mkdir -p $(BUILD)

# One release version source for every C build.  Missing/unparseable metadata
# is a hard build failure; there is intentionally no handwritten fallback.
$(VERSION_HEADER): $(CLIENT_PACKAGE) | $(BUILD)
	@version=$$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$<" | head -1); \
	  test -n "$$version" || { echo "PLATFORM_AGENT_VERSION_FAIL: cannot read version from $<" >&2; exit 1; }; \
	  printf '#define IDLETOKEN_CLIENT_VERSION "%s"\n' "$$version" > "$@.new"; \
	  cmp -s "$@.new" "$@" 2>/dev/null || mv -f "$@.new" "$@"; \
	  rm -f "$@.new"

$(BUILD)/tweetnacl.o: vendor/tweetnacl/tweetnacl.c vendor/tweetnacl/tweetnacl.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/blake2b.o: vendor/blake2/blake2b.c vendor/blake2/blake2.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/privacy.o: src/common/privacy.c include/idletoken_privacy.h vendor/tweetnacl/tweetnacl.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/sodium_seal.o: src/common/sodium_seal.c include/idletoken_sodium_seal.h include/idletoken_privacy.h vendor/blake2/blake2.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/net.o: src/common/net.c include/idletoken_net.h include/idletoken_proto.h | $(BUILD)
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -c -o $@ $<

$(BUILD)/http.o: src/common/http.c include/idletoken_http.h | $(BUILD)
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -c -o $@ $<

$(BUILD)/b64.o: src/common/b64.c include/idletoken_b64.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/apiconv.o: src/common/apiconv.c include/idletoken_apiconv.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

# Local admission capabilities (PROV-28). The agent mints under the channel key
# the coordinator beside it published; the coordinator spends. Same object on
# both sides on purpose — a second implementation of the MAC input is a second
# chance for the two to disagree, and they would disagree silently.
$(BUILD)/admission.o: src/common/admission.c include/idletoken_admission.h include/idletoken_sha256.h include/idletoken_privacy.h | $(BUILD)
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -c -o $@ $<

# Inflate for deflated sealed payloads. Only the decompressor is vendored: the
# platform compresses (Node's zlib), the agent decompresses, so there is one
# implementation of the format on our side, not two.
$(BUILD)/puff.o: vendor/puff/puff.c vendor/puff/puff.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/deflate_wire.o: src/common/deflate_wire.c include/idletoken_deflate_wire.h include/idletoken_privacy.h vendor/puff/puff.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/platform_http.o: src/common/platform_http.c include/idletoken_platform_http.h src/common/platform_proxy.h | $(BUILD)
	$(CC) $(CFLAGS) $(INCLUDES) -c -o $@ $<

$(BUILD)/platform_proxy.o: src/common/platform_proxy.c include/idletoken_platform_http.h src/common/platform_proxy.h | $(BUILD)
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -c -o $@ $<

$(BUILD)/platform_agent.o: src/tools/platform_agent.c include/idletoken_platform_http.h include/idletoken_sodium_seal.h include/idletoken_privacy.h include/idletoken_net.h include/idletoken_http.h include/idletoken_b64.h include/idletoken_apiconv.h include/idletoken_admission.h include/idletoken_deflate_wire.h $(VERSION_HEADER) | $(BUILD)
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -include $(VERSION_HEADER) -c -o $@ $<

$(BIN): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^ $(LDLIBS)

build/platform_http_probe: src/tools/platform_http_probe.c $(BUILD)/platform_http.o $(BUILD)/platform_proxy.o $(BUILD)/apiconv.o
	$(CC) $(CFLAGS) $(INCLUDES) -o $@ $^ $(LDLIBS)

build/platform_proxy_probe: src/tools/platform_proxy_probe.c src/common/platform_proxy.c $(BUILD)/platform_http.o $(BUILD)/apiconv.o
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -o $@ src/tools/platform_proxy_probe.c $(BUILD)/platform_http.o $(BUILD)/apiconv.o $(LDLIBS)

build/platform_proxy_stress: src/tools/platform_proxy_stress.c src/common/platform_proxy.c $(BUILD)/platform_http.o $(BUILD)/apiconv.o
	$(CC) $(CFLAGS) -D_GNU_SOURCE $(INCLUDES) -o $@ src/tools/platform_proxy_stress.c $(BUILD)/platform_http.o $(BUILD)/apiconv.o $(LDLIBS)

httpcheck: $(BIN) build/platform_http_probe build/platform_proxy_probe build/platform_proxy_stress
	python3 scripts/platform_http_gate.py build/platform_http_probe
	python3 scripts/platform_proxy_gate.py build/platform_proxy_probe
	build/platform_proxy_stress
	python3 scripts/platform_stdio_gate.py $(BIN)
	python3 scripts/platform_http_behavior_gate.py $(BIN)
	python3 scripts/agent_receipt_gate.py $(BIN)

clean:
	rm -rf $(BUILD) $(BIN)
