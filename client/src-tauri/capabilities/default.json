{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capabilities: run the bundled engine binaries (worker/coordinator) and the marketplace platform agent as sidecars.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/idletoken-worker",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/idletoken-coord",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/idletoken-platform-agent",
          "sidecar": true,
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/idletoken-worker",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/idletoken-coord",
          "sidecar": true,
          "args": true
        },
        {
          "name": "binaries/idletoken-platform-agent",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
