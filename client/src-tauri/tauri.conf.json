{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdleToken",
  "version": "0.1.0",
  "identifier": "ai.idletoken.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IdleToken",
        "width": 1040,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/idletoken-worker",
      "binaries/idletoken-coord",
      "binaries/idletoken-platform-agent"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}