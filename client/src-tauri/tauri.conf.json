{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdleToken",
  "version": "0.1.0",
  "identifier": "ai.idletoken.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IdleToken",
        "width": 1040,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://idletoken.ai https://*.idletoken.ai; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RjIzQzNDRTI0QkZERTkKUldUcC9VdmlQRHp5S0tTWFN4MzQwSnlZOUFvN0ZtU1pmK0h2TGtuT2Y2azJhZVR2Y3dwNVQ3MXYK",
      "endpoints": [
        "https://github.com/idletoken/IdleToken/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/idletoken-worker",
      "binaries/idletoken-coord",
      "binaries/idletoken-platform-agent",
      "binaries/idletoken-server",
      "binaries/idletoken-rpc-server"
    ],
    "resources": [
      "licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
