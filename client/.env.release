# Vite environment variables used only by release builds (pnpm build:release /
# tauri build). A plain `pnpm build` (dev, acceptance-gate dist) does not load
# this file, so the default platform address stays an empty string (a local
# offline identity) and gates such as P2_auth never reach the production
# platform.
# This only affects the default for a fresh install; settings the user has saved
# are never overwritten (see src/settings.ts).
VITE_PLATFORM_URL=https://api.idletoken.ai
# Website that owns account registration. The client links out to it instead of
# shipping its own signup form (see auth.ts portalRegisterUrl). Optional: when
# unset it is derived from VITE_PLATFORM_URL by dropping the leading `api.`.
VITE_PORTAL_URL=https://idletoken.ai
