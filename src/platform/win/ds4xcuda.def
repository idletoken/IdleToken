; Exports for ds4xcuda.dll — the ds4x GPU matvec built by nvcc/MSVC and linked
; into the MinGW-built idletoken-worker.exe (same pattern as ds4cuda.dll).
;
; Cross-CRT safety (the trap that cost days on ds4): this boundary passes only
; READ-ONLY host pointers plus sizes, and every allocation returned by
; ds4x_cuda_upload is freed by ds4x_cuda_free INSIDE this DLL. No file
; descriptors, no FILE*, no malloc-here/free-there. Keep it that way.
;
; EVERY new extern "C" entry point in ds4x_cuda.cu must be added here, in the
; same commit. Forgetting is not a link error you notice — commit 3ca0022 is
; the last time it happened, and the symptom was the recurrence quietly staying
; on the CPU at ~6x the cost per layer with every log line looking normal.
LIBRARY ds4xcuda.dll
EXPORTS
ds4x_cuda_available
ds4x_cuda_set_budget
ds4x_cuda_upload
ds4x_cuda_free
ds4x_cuda_matvec
ds4x_cuda_matvec_off
ds4x_cuda_bytes_resident
ds4x_cuda_device_name
ds4x_cuda_last_error
ds4x_cuda_stats
ds4x_cuda_stats_reset
ds4x_cuda_upload_stats
ds4x_cuda_matmul
ds4x_cuda_matmul_stats
ds4x_cuda_swiglu
ds4x_cuda_ffn_stats
ds4x_cuda_proj_fanout
ds4x_cuda_proj_stats
ds4x_cuda_attn_gqa
ds4x_cuda_attn_ffn_tail
ds4x_cuda_tail_stats
ds4x_cuda_gdn_create
ds4x_cuda_gdn_free
ds4x_cuda_gdn_zero
ds4x_cuda_gdn_run
ds4x_cuda_gdn_pre_run
ds4x_cuda_gdn_layer
ds4x_cuda_gdn_get_state
ds4x_cuda_gdn_set_state
ds4x_cuda_gdn_stats
