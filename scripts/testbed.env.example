# Testbed configuration -- copy to scripts/testbed.env and fill it in (that copy
# is **not committed**).
#
# Why a separate file: the acceptance scripts ssh into several real machines, and
# "which machines exist, what they are called, where their home directories are"
# is a property of **your** set of machines, not of the product. It used to live
# as three copies scattered through acceptance.sh, sync-to-win.sh and
# install_walkthrough.sh, which both drifted and meant the repository carried the
# Windows usernames of people who lent us machines -- third-party personal data
# that must not ship with an open-source repository.
#
# The aliases below (node-linux / node-win-a / ...) **are placeholders, not names
# to copy verbatim**. Replace them with the aliases you actually use in
# ~/.ssh/config; the scripts assume nothing about the names themselves -- whether
# a machine is Windows is decided by ssh'ing in and asking `uname`, never guessed
# from its name.
#
# Without this file the scripts do not fall back to someone else's machine; they
# tell you exactly which entry is missing and which line to add. (Trying another
# machine's path only fails somewhere far away, and looks like a broken product.)

# --- Node aliases (must be directly ssh-able, i.e. names from ~/.ssh/config) ---
IDLETOKEN_COORD_NODE=node-linux                    # coordinator: the strongest machine, the one most often on
IDLETOKEN_WORKER_NODES="node-win-a node-win-b"     # the other compute nodes (each needs an NVIDIA GPU)
IDLETOKEN_WIN_BUILD_NODE=node-win-a                # the Windows box with the build toolchain (MinGW + Rust + NSIS)

# The repository checkout on the coordinator (defaults to ~/work/IdleToken)
#IDLETOKEN_COORD_HOME=~/work/IdleToken

# --- The user directory of each Windows machine -------------------------------
# The variable name is IDLETOKEN_PROFILE_<alias>. The checkout is by convention
# <user directory>/IdleToken, so only the user directory is needed here.
# Non-alphanumeric characters in an alias become underscores.
IDLETOKEN_PROFILE_node_win_a='C:/Users/YOURNAME'
IDLETOKEN_PROFILE_node_win_b='C:/Users/YOURNAME'

# --- Optional -----------------------------------------------------------------
# Absolute path of the DSv4-Flash GGUF on the coordinator (defaults to $HOME/work/ds4/gguf/...)
#IDLETOKEN_GGUF="$HOME/work/ds4/gguf/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf"
# The CUDA bin directory on the build node (prepended to PATH when G1 runs --help)
#IDLETOKEN_WIN_CUDA_BIN='C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.3\bin\x64'

# Weight directories searched in order on each machine (defaults to <checkout>/gguf).
# Space separated; several may be given.
# WARNING: write **absolute paths as they are on the remote machine**, not $HOME.
#   This file is sourced on the control machine, so a $HOME inside double quotes
#   expands to the control machine's home directory there and then; and consumers
#   embed the path in single quotes on the remote side, where it will not expand
#   either.
#IDLETOKEN_GGUF_DIRS_node_linux='/home/<user>/work/qwen /home/<user>/work/ds4/gguf'
#IDLETOKEN_GGUF_DIRS_node_win_a='D:/gguf'

# Nodes taking part in the combination matrix (topology_matrix.sh); defaults to
# the coordinator plus IDLETOKEN_WORKER_NODES.
#IDLETOKEN_TOPO_NODES="node-linux node-win-a node-win-b"

# Default target for the installation walkthrough (install_walkthrough.sh); it can
# also be passed as the first argument.
#IDLETOKEN_INSTALL_TARGET=node-win-b
