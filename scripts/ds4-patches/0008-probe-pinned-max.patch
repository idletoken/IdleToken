+/* IdleToken: measure the pinned-memory ceiling.
+ *
+ * The only way to find it is to allocate until allocation fails -- the ceiling
+ * cannot be derived from physical memory, the page file, or the commit limit
+ * (measured 73.0% vs 48.2% of physical RAM on two identical GPUs, each
+ * reproducible across runs).
+ *
+ * Both stop conditions are required: an allocation failure, and **available
+ * physical memory dropping below FLOOR**. With only the first, the probe itself
+ * would drive the machine into the very state we are trying to fix -- a
+ * measurement must not reproduce the fault it is measuring. */
+extern "C" uint64_t ds4_gpu_probe_pinned_max(void) {
+#ifdef _WIN32
+    const uint64_t CHUNK = 512ull << 20;
+    const uint64_t FLOOR = 4ull << 30;
+    std::vector<void *> blocks;
+    uint64_t got = 0;
+    for (;;) {
+        MEMORYSTATUSEX ms; ms.dwLength = sizeof(ms);
+        if (!GlobalMemoryStatusEx(&ms) || ms.ullAvailPhys < FLOOR) break;
+        void *p = NULL;
+        if (cudaHostAlloc(&p, (size_t)CHUNK, cudaHostAllocMapped) != cudaSuccess) {
+            (void)cudaGetLastError();
+            break;
+        }
+        blocks.push_back(p);
+        got += CHUNK;
+    }
+    for (size_t i = 0; i < blocks.size(); i++) (void)cudaFreeHost(blocks[i]);
+    fprintf(stderr, "ds4: IdleToken pinned-memory ceiling measured at %.2f GiB\n",
+            (double)got / 1073741824.0);
+    return got;
+#else
+    /* This ceiling has not been observed outside Windows (on Linux the pinned
+     * limit is governed by RLIMIT_MEMLOCK, which CUDA's pinned allocations do not
+     * go through). Return 0 for "unknown"; callers treat it as unconstrained. */
+    return 0;
 #endif
+}
 
