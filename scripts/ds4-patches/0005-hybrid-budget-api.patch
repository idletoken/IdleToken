+/* ===================================================================== *
+ * IdleToken: decode-time routed-expert gather (IDLETOKEN_MOE_STAGE=1)
+ *
+ * WHY THIS IS NOT A COPY OF llama.cpp. llama.cpp keeps CPU-resident experts on
+ * the CPU during decode and lets ggml's CPU kernels read them at memory
+ * bandwidth — its "copy only the used experts" path
+ * (ggml_backend_sched_compute_splits) only runs when a GPU steals the op, which
+ * needs batch >= GGML_OP_OFFLOAD_MIN_BATCH (32), i.e. prefill. ds4 has no
+ * usable CPU compute path (upstream calls it reference/debug; measured
+ * 12.84 s/token on an i7-12700), so for us every expert byte must reach the
+ * GPU. This is a workaround for that, not an upstream-blessed design.
+ *
+ * The hard floor it buys: DSv4 decode touches 6 of 256 experts per layer,
+ * ~42 MiB per layer, ~1.7 GiB per token. Even at full PCIe 4.0 x16 that is
+ * ~68 ms/token => ~14 tok/s ceiling for this architecture.
+ *
+ * WHY THE GATHER RUNS ON THE GPU. The first attempt read `selected` back to the
+ * host (cudaMemcpy D2H) once per layer so it could issue cudaMemcpyAsync per
+ * expert — 43 synchronisation points per token. On WDDM with VRAM at 98%
+ * occupancy that wedged the whole machine twice. llama.cpp can afford its one
+ * sync per split because it caches `prev_ids_tensor` across splits; our router
+ * picks new experts every layer, so caching buys nothing. Doing the gather in a
+ * kernel that reads `selected` straight from device memory removes the host
+ * from the loop entirely: zero syncs, one launch per layer.
+ * ===================================================================== */
+#define IDLETOKEN_MOE_STAGE_MAX_EXPERTS 8u
+
+/* dst[i*expert_bytes ..] = src[selected[i]*expert_bytes ..], i < n_used.
+ * Grid-stride over bytes so one launch covers all experts and any size.
+ * `src` may be mapped host memory: the reads are then PCIe reads, but they are
+ * fully coalesced and sequential here, unlike the strided quantised-block
+ * access the MoE kernels perform when they read the same bytes in place. */
+__global__ static void moe_gather_experts_kernel(
+        char *dst, const char *src, const int32_t *selected,
+        uint32_t n_used, uint64_t expert_bytes, uint32_t n_expert) {
+    const uint32_t slot = blockIdx.y;
+    if (slot >= n_used) return;
+    int32_t e = selected[slot];
+    if (e < 0 || (uint32_t)e >= n_expert) e = 0;   /* mirrors the kernels' clamp */
+    const char *s = src + (uint64_t)e * expert_bytes;
+    char *d = dst + (uint64_t)slot * expert_bytes;
+    /* 16-byte vector copy; expert tensors are quant-block aligned. */
+    const uint64_t n16 = expert_bytes / 16u;
+    for (uint64_t i = blockIdx.x * (uint64_t)blockDim.x + threadIdx.x; i < n16;
+         i += (uint64_t)gridDim.x * blockDim.x) {
+        ((uint4 *)d)[i] = ((const uint4 *)s)[i];
+    }
+    for (uint64_t i = n16 * 16u + blockIdx.x * blockDim.x + threadIdx.x;
+         i < expert_bytes; i += (uint64_t)gridDim.x * blockDim.x) {
+        d[i] = s[i];
+    }
+}
+
+struct cuda_moe_stage_state {
+    char    *gate;
+    char    *up;
+    char    *down;
+    uint64_t gate_cap;
+    uint64_t down_cap;
+    int32_t *ident;
+    uint32_t ident_n;
+    int      inited;
+};
+static cuda_moe_stage_state g_moe_stage;
+
+static int cuda_moe_stage_enabled(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("IDLETOKEN_MOE_STAGE");
+        cached = (e && e[0] == '1') ? 1 : 0;
+    }
+    return cached;
+}
+
+/* Host-resident means: the bytes are reached over PCIe rather than living in
+ * VRAM. A cached range that came from cudaHostAlloc/registration keeps a
+ * non-NULL registered_base; a real cudaMalloc range leaves it NULL. When NO
+ * range covers the tensor at all, cuda_model_range_ptr fell back to the raw
+ * mapping — which is also host-resident, and is in fact the common case once
+ * the VRAM budget is spent. (The first version returned 0 here and so never
+ * engaged; a silent no-op reads exactly like "the optimisation did not help".) */
+static int cuda_model_range_is_host(uint64_t offset, uint64_t bytes) {
+    if (g_model_device_owned) return 0;
+    for (size_t i = 0; i < g_model_ranges.size(); i++) {
+        const cuda_model_range &r = g_model_ranges[i];
+        if (offset >= r.offset && offset + bytes <= r.offset + r.bytes)
+            return r.registered_base != NULL;
+    }
+    return 1;
+}
+
+static int cuda_moe_stage_prepare(uint64_t gate_expert_bytes, uint64_t down_expert_bytes,
+                                  uint32_t n_expert) {
+    const uint64_t gneed = gate_expert_bytes * n_expert;
+    const uint64_t dneed = down_expert_bytes * n_expert;
+    if (g_moe_stage.inited && g_moe_stage.gate_cap >= gneed &&
+        g_moe_stage.down_cap >= dneed && g_moe_stage.ident_n >= n_expert)
+        return 1;
+    if (g_moe_stage.gate)  { (void)cudaFree(g_moe_stage.gate);  g_moe_stage.gate  = NULL; }
+    if (g_moe_stage.up)    { (void)cudaFree(g_moe_stage.up);    g_moe_stage.up    = NULL; }
+    if (g_moe_stage.down)  { (void)cudaFree(g_moe_stage.down);  g_moe_stage.down  = NULL; }
+    if (g_moe_stage.ident) { (void)cudaFree(g_moe_stage.ident); g_moe_stage.ident = NULL; }
+    g_moe_stage.inited = 0;
+    if (cudaMalloc((void **)&g_moe_stage.gate, (size_t)gneed) != cudaSuccess ||
+        cudaMalloc((void **)&g_moe_stage.up,   (size_t)gneed) != cudaSuccess ||
+        cudaMalloc((void **)&g_moe_stage.down, (size_t)dneed) != cudaSuccess ||
+        cudaMalloc((void **)&g_moe_stage.ident,
+                   (size_t)IDLETOKEN_MOE_STAGE_MAX_EXPERTS * sizeof(int32_t)) != cudaSuccess) {
+        (void)cudaGetLastError();
+        fprintf(stderr, "ds4: IdleToken MoE staging disabled — cudaMalloc failed (%.1f MiB)\n",
+                (double)(2 * gneed + dneed) / 1048576.0);
+        return 0;
+    }
+    int32_t host_ident[IDLETOKEN_MOE_STAGE_MAX_EXPERTS];
+    for (uint32_t i = 0; i < IDLETOKEN_MOE_STAGE_MAX_EXPERTS; i++) host_ident[i] = (int32_t)i;
+    if (cudaMemcpy(g_moe_stage.ident, host_ident, sizeof(host_ident),
+                   cudaMemcpyHostToDevice) != cudaSuccess) {
+        (void)cudaGetLastError();
+        return 0;
+    }
+    g_moe_stage.gate_cap = gneed;
+    g_moe_stage.down_cap = dneed;
+    g_moe_stage.ident_n  = IDLETOKEN_MOE_STAGE_MAX_EXPERTS;
+    g_moe_stage.inited   = 1;
+    fprintf(stderr, "ds4: IdleToken MoE staging on — %.1f MiB VRAM, %u experts/layer, GPU-side gather\n",
+            (double)(2 * gneed + dneed) / 1048576.0, n_expert);
+    return 1;
+}
+
+/* Returns 1 when the staged buffers should be used. On ANY failure returns 0
+ * and leaves the caller's pointers untouched, so a broken staging degrades to
+ * the previous (slow but correct) behaviour rather than to wrong output. */
+static int cuda_moe_stage_decode(const char **gate_w, const char **up_w, const char **down_w,
+                                 const int32_t **selected_out, const int32_t *selected,
+                                 uint32_t n_expert,
+                                 uint64_t gate_expert_bytes, uint64_t down_expert_bytes,
+                                 uint32_t n_expert_total) {
+    if (n_expert > IDLETOKEN_MOE_STAGE_MAX_EXPERTS) return 0;
+    if (!cuda_moe_stage_prepare(gate_expert_bytes, down_expert_bytes, n_expert)) return 0;
+
+    const uint32_t threads = 256u;
+    const uint64_t n16 = gate_expert_bytes / 16u;
+    uint32_t blocks_x = (uint32_t)((n16 + threads - 1) / threads);
+    if (blocks_x > 1024u) blocks_x = 1024u;
+    if (blocks_x == 0u) blocks_x = 1u;
+    dim3 grid(blocks_x, n_expert, 1);
+
+    moe_gather_experts_kernel<<<grid, threads>>>(g_moe_stage.gate, *gate_w, selected,
+                                                 n_expert, gate_expert_bytes, n_expert_total);
+    moe_gather_experts_kernel<<<grid, threads>>>(g_moe_stage.up, *up_w, selected,
+                                                 n_expert, gate_expert_bytes, n_expert_total);
+    const uint64_t d16 = down_expert_bytes / 16u;
+    uint32_t dblocks = (uint32_t)((d16 + threads - 1) / threads);
+    if (dblocks > 1024u) dblocks = 1024u;
+    if (dblocks == 0u) dblocks = 1u;
+    dim3 dgrid(dblocks, n_expert, 1);
+    moe_gather_experts_kernel<<<dgrid, threads>>>(g_moe_stage.down, *down_w, selected,
+                                                  n_expert, down_expert_bytes, n_expert_total);
+    if (cudaGetLastError() != cudaSuccess) return 0;
+
+    *gate_w = g_moe_stage.gate;
+    *up_w   = g_moe_stage.up;
+    *down_w = g_moe_stage.down;
+    /* Staged slot order IS the selection order, so downstream kernels index
+     * 0..n-1. `selected` itself is left untouched — unlike the first attempt,
+     * which overwrote the router's scratch in place. */
+    *selected_out = g_moe_stage.ident;
+    return 1;
+}
