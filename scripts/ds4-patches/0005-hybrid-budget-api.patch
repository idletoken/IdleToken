+/* IdleToken: hybrid VRAM budget, set by the worker through an explicit call.
+ *
+ * It used to be passed as IDLETOKEN_HYBRID / IDLETOKEN_HYBRID_VRAM_GB via
+ * setenv() from worker_main.c. That silently did nothing on Windows: the worker
+ * is built with MinGW and this DLL with nvcc/MSVC, and the two CRTs keep
+ * SEPARATE environment blocks — MinGW's setenv never reaches this getenv().
+ * The budget is a safety mechanism (it is what keeps cudaMalloc from
+ * oversubscribing VRAM and leaving WDDM to fight the whole machine for memory),
+ * so "silently inert" was much worse than slow: measured 3.46 s/token with it
+ * dead vs 0.49 s/token once it actually applied, plus two machine hangs.
+ *
+ * Variables set by the launching shell DO reach both CRTs (they live in the
+ * process environment block), which is why IDLETOKEN_MOE_STAGE worked while
+ * IDLETOKEN_HYBRID did not — a difference that cost six debugging rounds.
+ *
+ * Must sit at FILE scope ABOVE cuda_model_range_ptr, its only reader: C++ needs
+ * the declaration first, and `extern "C"` is illegal inside a function body. */
+static uint64_t g_hybrid_budget_bytes;   /* 0 = not set explicitly */
+
+extern "C" void ds4_gpu_set_hybrid_vram_budget(uint64_t bytes) {
+    g_hybrid_budget_bytes = bytes;
+    fprintf(stderr, "ds4: IdleToken hybrid VRAM budget set to %.2f GiB (explicit API)\n",
+            (double)bytes / 1073741824.0);
+}
