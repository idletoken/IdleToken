+/* ---- IdleToken CPU-PP: session-level layer-range on the CPU backend -------
+ *
+ * The GPU path keeps its HC state in graph.cur_hc / graph.batch_cur_hc, which
+ * is what makes "run [lo,hi) now, hand the state over, continue later" work.
+ * These give the CPU backend the same thing, so the four public PP entry
+ * points can serve either backend and the worker needs no branch at all. */
+
+#define DS4_HC_DIM_ ((size_t)DS4_N_HC * DS4_N_EMBD)
+
+static bool session_cpu_hc_ensure_decode(ds4_session *s) {
+    if (!s->cpu_hc_cur) {
+        s->cpu_hc_cur = (float *)calloc(DS4_HC_DIM_, sizeof(float));
+        if (!s->cpu_hc_cur) return false;
+    }
+    return true;
+}
+
+static bool session_cpu_hc_ensure_batch(ds4_session *s, uint32_t rows) {
+    if (s->cpu_hc_batch_rows >= rows && s->cpu_hc_batch) return true;
+    free(s->cpu_hc_batch);
+    s->cpu_hc_batch = (float *)calloc((size_t)rows * DS4_HC_DIM_, sizeof(float));
+    if (!s->cpu_hc_batch) { s->cpu_hc_batch_rows = 0; return false; }
+    s->cpu_hc_batch_rows = rows;
+    return true;
+}
+
+static bool session_encode_layer_range_cpu(ds4_session *s, int token, uint32_t pos,
+                                           uint32_t lo, uint32_t hi) {
+    if (!session_cpu_hc_ensure_decode(s)) return false;
+    ds4_engine *e = s->engine;
+    forward_range_raw_swa_cpu(hi == DS4_N_LAYER ? s->logits : NULL,
+                              &e->model, &e->weights, &s->cpu_cache,
+                              token, pos, lo, hi,
+                              lo == 0 ? NULL : s->cpu_hc_cur,   /* staged by _write */
+                              s->cpu_hc_cur,                    /* harvested by _read */
+                              e->directional_steering_dirs,
+                              e->directional_steering_attn_scale,
+                              e->directional_steering_ffn_scale,
+                              &s->cpu_scratch);
+    return true;
+}
