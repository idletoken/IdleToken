+    /* Pass the **cache slot indices** straight downstream, with no staging buffer
+     * in between.
+     *
+     * All 14 kernels consuming `sel_ptr` were checked one by one: they clamp only
+     * `expert_i < 0` and apply **no upper bound**, then index directly with
+     * `base + expert * expert_bytes`; the `n_expert` passed in is the top-k count
+     * (6), not the size of the expert table. So a slot index (0..slots-1, always
+     * < 256) lands inside the cache buffer and is valid.
+     *
+     * This saves 3 D2D kernels per layer. The staging hop was originally kept so
+     * the downstream contract would not change, and I estimated its cost as VRAM
+     * bandwidth (about 2.5 ms/token) -- **the real cost was the launch count**:
+     * 6 extra kernels per layer, 162 across 27 layers, which measured pushed `enc`
+     * from 14 to 48.4 ms, more than the PCIe it saved. */
+    *gate_w = c->gate;
+    *up_w   = c->up;
+    *down_w = c->down;
+    *selected_out = c->out_slots;
