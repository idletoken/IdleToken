+/* IdleToken: arm the DSpark aux capture for `n` target layers. Weights are a
+ * uniform 1/N_HC so the existing weighted-sum op performs the mean. */
+static bool metal_graph_dspark_enable_aux(ds4_gpu_graph *g,
+                                          const int32_t *layers,
+                                          uint32_t       n,
+                                          uint32_t       n_stages) {
+    if (!g || !layers || n == 0 || n > DS4_DSPARK_MAX_STAGES) return false;
+    if (n_stages == 0 || n_stages > DS4_DSPARK_MAX_STAGES) return false;
+    if (g->raw_cap == 0) return false;
+    if (g->dspark_n_aux != 0) return true;              /* already armed */
+    g->dspark_aux_w = ds4_gpu_tensor_alloc((uint64_t)DS4_N_HC * sizeof(float));
+    if (!g->dspark_aux_w) return false;
+    float w[DS4_N_HC];
+    for (uint32_t i = 0; i < (uint32_t)DS4_N_HC; i++) w[i] = 1.0f / (float)DS4_N_HC;
+    if (!ds4_gpu_tensor_write(g->dspark_aux_w, 0, w, sizeof(w))) return false;
+    /* One buffer, n views. main_proj consumes the concatenation of the target
+     * layers' aux hidden states, so capturing straight into adjacent slices
+     * makes that concat free — and makes the ORDER of target_layer_ids the
+     * single place the layout is decided. */
+    const uint64_t row = (uint64_t)DS4_N_EMBD * sizeof(float);
+    g->dspark_aux_cat = ds4_gpu_tensor_alloc(row * n);
+    g->dspark_main_x  = ds4_gpu_tensor_alloc(row);
+    if (!g->dspark_aux_cat || !g->dspark_main_x) return false;
+    for (uint32_t k = 0; k < n; k++) {
+        g->dspark_aux[k] = ds4_gpu_tensor_view(g->dspark_aux_cat, row * k, row);
+        if (!g->dspark_aux[k]) return false;
+        g->dspark_aux_layer[k] = (uint32_t)layers[k];
+    }
+    /* Same shape as a target-model layer cache: the drafter's blocks are
+     * ratio-0 (SWA) layers, so they read a plain rolling raw window. */
+    g->dspark_kv_raw = ds4_gpu_tensor_alloc((uint64_t)DS4_N_HEAD_DIM * sizeof(float));
+    g->dspark_kv     = ds4_gpu_tensor_alloc((uint64_t)DS4_N_HEAD_DIM * sizeof(float));
+    if (!g->dspark_kv_raw || !g->dspark_kv) return false;
+    for (uint32_t k = 0; k < n_stages; k++) {
+        g->dspark_raw_cache[k] = ds4_gpu_tensor_alloc(
+                (uint64_t)g->raw_cap * DS4_N_HEAD_DIM * sizeof(float));
+        if (!g->dspark_raw_cache[k]) return false;
+    }
+    g->dspark_n_aux = n;
+    return true;
+}
+
+/* Call with g->cur_hc holding the OUTPUT of layer `il` (i.e. after the
+ * ping-pong swap in the layer loop). */
+static bool metal_graph_dspark_capture_aux(ds4_gpu_graph *g, uint32_t il) {
+    if (!g || g->dspark_n_aux == 0) return true;
+    for (uint32_t k = 0; k < g->dspark_n_aux; k++) {
+        if (g->dspark_aux_layer[k] != il) continue;
+        if (!ds4_gpu_hc_weighted_sum_tensor(g->dspark_aux[k],
+                                            g->cur_hc,
+                                            g->dspark_aux_w,
+                                            DS4_N_EMBD,
+                                            DS4_N_HC)) {
+            return false;
+        }
+    }
+    return true;
+}
