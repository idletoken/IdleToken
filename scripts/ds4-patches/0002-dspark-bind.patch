+/* IdleToken: test hooks for the verifier generalisation (G-DSPARK-VERIFY prep).
+ *
+ * `which` 0 = the original hardcoded N=2 path, 1 = the generalised N path.
+ * With n_tokens == 2 the two MUST agree bit for bit — that is the oracle for
+ * the generalisation itself, checkable without touching the session's output
+ * path. Run them in SEPARATE sessions warmed identically: back to back in one
+ * session the first run advances the compressed attention state, so the second
+ * would start from somewhere else and differ for reasons that have nothing to
+ * do with the code under test.
+ */
+int ds4_session_verify_probe(ds4_session *s, int which, const int *tokens,
+                             uint32_t n_tokens, uint32_t start,
+                             int *tops, float *logits_out) {
+#ifdef DS4_NO_GPU
+    (void)s; (void)which; (void)tokens; (void)n_tokens; (void)start;
+    (void)tops; (void)logits_out;
+    return 0;
+#else
+    if (!s || !tokens || !tops || n_tokens == 0) return 0;
+    ds4_engine *e = s->engine;
+    if (which == 0) {
+        if (n_tokens != 2) return 0;
+        float *l0 = logits_out;
+        float *l1 = logits_out ? logits_out + DS4_N_VOCAB : NULL;
+        if (!l1) return 0;
+        int top0 = -1;
+        if (!metal_graph_verify_decode2_exact(&s->graph, &e->model, &e->weights,
+                                              tokens[0], tokens[1], start,
+                                              &top0, l0, l1)) return 0;
+        tops[0] = top0;
+        tops[1] = sample_argmax(l1, DS4_N_VOCAB);
+        return 1;
+    }
+    return metal_graph_verify_decodeN_exact(&s->graph, &e->model, &e->weights,
+                                            tokens, n_tokens, start,
+                                            tops, logits_out) ? 1 : 0;
+#endif
+}
