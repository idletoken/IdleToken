+    if (!s->graph.dspark_kv || !s->graph.dspark_main_x) return 0;
+    int ok = ds4_gpu_begin_commands() != 0;
+    if (ok) ok = dspark_stage_context_kv(e, s, stage);
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    if (ok) ok = ds4_gpu_tensor_read(s->graph.dspark_kv, 0, out,
