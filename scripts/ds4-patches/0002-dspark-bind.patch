+/* IdleToken extension: bind the DSpark draft module (docs/dspark-design.md §3).
+ *
+ * Shape parameters come from the file's own dspark.* metadata rather than
+ * compile-time constants: block_size and markov_rank are training choices, and
+ * a checkpoint whose metadata disagrees with its tensors is exactly the kind of
+ * thing this binder exists to catch. */
+static void dspark_weights_bind(ds4_dspark_weights *w, const ds4_model *m) {
+    memset(w, 0, sizeof(*w));
+
+    uint32_t stages = 0;
+    if (!model_get_u32(m, "dspark.stage_count", &stages)) {
+        ds4_die("dspark.stage_count is missing from the DSpark module");
+    }
+    if (stages == 0 || stages > DS4_DSPARK_MAX_STAGES) {
+        ds4_die("DSpark stage_count is outside the supported range");
+    }
+    w->n_stages = stages;
+
+    if (!model_get_u32(m, "dspark.block_size", &w->block_size) ||
+        !model_get_u32(m, "dspark.markov_rank", &w->markov_rank) ||
+        !model_get_u32(m, "dspark.noise_token_id", &w->noise_token_id)) {
+        ds4_die("the DSpark module is missing block_size/markov_rank/noise_token_id");
+    }
+    if (w->block_size == 0) ds4_die("DSpark block_size must be >= 1");
+    /* The noise token is embedded at every non-anchor block position. An
+     * out-of-range id would index past token_embd and read whatever follows
+     * it in the mapping — garbage drafts, no error. */
+    if (w->noise_token_id >= (uint32_t)DS4_N_VOCAB) {
+        ds4_die("DSpark noise_token_id is outside the vocabulary");
+    }
+
+    ds4_array_ref tgt;
+    if (!model_get_array(m, "dspark.target_layer_ids", &tgt) ||
+        (tgt.type != GGUF_VALUE_UINT32 && tgt.type != GGUF_VALUE_INT32)) {
+        ds4_die("dspark.target_layer_ids is missing or not an int array");
+    }
+    if (tgt.len == 0 || tgt.len > DS4_DSPARK_MAX_STAGES) {
+        ds4_die("dspark.target_layer_ids has an unsupported length");
+    }
+    w->n_targets = (uint32_t)tgt.len;
+    ds4_cursor tc = cursor_at(m, tgt.data_pos);
+    for (uint32_t i = 0; i < w->n_targets; i++) {
+        int32_t v = 0;
+        if (!cursor_read(&tc, &v, sizeof(v))) ds4_die(tc.error);
+        if (v < 0 || v >= DS4_N_LAYER) {
+            ds4_die("a DSpark target layer id is outside the target model");
+        }
+        w->target_layer_ids[i] = v;
+    }
+
+    w->main_proj = required_tensor(m, "mtp.0.main_proj.weight");
+    w->main_norm = required_tensor(m, "mtp.0.main_norm.weight");
+
+    const uint32_t last = stages - 1u;
+    w->norm           = required_tensorf(m, "mtp.%u.norm.weight", last);
+    w->hc_head_base   = required_tensorf(m, "mtp.%u.hc_head_base.weight", last);
+    w->hc_head_fn     = required_tensorf(m, "mtp.%u.hc_head_fn.weight", last);
+    w->hc_head_scale  = required_tensorf(m, "mtp.%u.hc_head_scale.weight", last);
+    w->markov_w1      = required_tensorf(m, "mtp.%u.markov_head.markov_w1.weight", last);
+    w->markov_w2      = required_tensorf(m, "mtp.%u.markov_head.markov_w2.weight", last);
+
+    for (uint32_t s = 0; s < stages; s++) {
+        ds4_layer_weights *l = &w->block[s];
+        l->hc_attn_fn      = required_tensorf(m, "mtp.%u.hc_attn_fn.weight", s);
+        l->hc_attn_scale   = required_tensorf(m, "mtp.%u.hc_attn_scale.weight", s);
+        l->hc_attn_base    = required_tensorf(m, "mtp.%u.hc_attn_base.weight", s);
+        l->attn_norm       = required_tensorf(m, "mtp.%u.attn_norm.weight", s);
+        l->attn_q_a        = required_tensorf(m, "mtp.%u.attn_q_a.weight", s);
+        l->attn_q_a_norm   = required_tensorf(m, "mtp.%u.attn_q_a_norm.weight", s);
+        l->attn_q_b        = required_tensorf(m, "mtp.%u.attn_q_b.weight", s);
+        l->attn_kv         = required_tensorf(m, "mtp.%u.attn_kv.weight", s);
+        l->attn_kv_a_norm  = required_tensorf(m, "mtp.%u.attn_kv_a_norm.weight", s);
+        l->attn_sinks      = required_tensorf(m, "mtp.%u.attn_sinks.weight", s);
+        l->attn_output_a   = required_tensorf(m, "mtp.%u.attn_output_a.weight", s);
+        l->attn_output_b   = required_tensorf(m, "mtp.%u.attn_output_b.weight", s);
+        l->hc_ffn_fn       = required_tensorf(m, "mtp.%u.hc_ffn_fn.weight", s);
+        l->hc_ffn_scale    = required_tensorf(m, "mtp.%u.hc_ffn_scale.weight", s);
+        l->hc_ffn_base     = required_tensorf(m, "mtp.%u.hc_ffn_base.weight", s);
+        l->ffn_norm        = required_tensorf(m, "mtp.%u.ffn_norm.weight", s);
+        l->ffn_gate_inp    = required_tensorf(m, "mtp.%u.ffn_gate_inp.weight", s);
+        l->ffn_exp_probs_b = required_tensorf(m, "mtp.%u.exp_probs_b.bias", s);
+        l->ffn_gate_exps   = required_tensorf(m, "mtp.%u.ffn_gate_exps.weight", s);
+        l->ffn_up_exps     = required_tensorf(m, "mtp.%u.ffn_up_exps.weight", s);
+        l->ffn_down_exps   = required_tensorf(m, "mtp.%u.ffn_down_exps.weight", s);
+        l->ffn_gate_shexp  = required_tensorf(m, "mtp.%u.ffn_gate_shexp.weight", s);
+        l->ffn_up_shexp    = required_tensorf(m, "mtp.%u.ffn_up_shexp.weight", s);
+        l->ffn_down_shexp  = required_tensorf(m, "mtp.%u.ffn_down_shexp.weight", s);
+    }
+
+    dspark_weights_validate_layout(w);
+}
