+ * wkv (`attn.fused_wqa_wkv(main_x)`). Applying the layer's input norm on top
+ * would be an extra normalisation nothing in the reference does. */
+static int dspark_stage_context_kv(ds4_engine *e, ds4_session *s, uint32_t stage) {
+    const ds4_layer_weights *l = &e->dspark_weights.block[stage];
+    ds4_gpu_graph *g = &s->graph;
+    int ok = ds4_gpu_matmul_q8_0_tensor(g->dspark_kv_raw,
+                                        e->dspark_model.map,
+                                        e->dspark_model.size,
+                                        l->attn_kv->abs_offset,
+                                        DS4_N_EMBD,
+                                        DS4_N_HEAD_DIM,
+                                        g->dspark_main_x,
+                                        1) != 0;
+    if (ok) ok = ds4_gpu_rms_norm_weight_tensor(g->dspark_kv,
+                                                g->dspark_kv_raw,
+                                                e->dspark_model.map,
+                                                e->dspark_model.size,
+                                                l->attn_kv_a_norm->abs_offset,
+                                                DS4_N_HEAD_DIM,
+                                                DS4_RMS_EPS) != 0;
