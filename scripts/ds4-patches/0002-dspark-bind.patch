+ * the target's stay aligned — the block positions that follow are pos+1.. */
+int ds4_engine_dspark_push_context(ds4_engine *e, ds4_session *s, uint32_t pos) {
+#ifdef DS4_NO_GPU
+    (void)e; (void)s; (void)pos;
+    return 0;
+#else
+    if (!e || !s || !e->dspark_ready) return 0;
