+                    "bias argmax=%d (%.3f, rms %.3f)  -> %d\n",
+                    k, bbest, (double)bbest_v, sqrt(bsum / DS4_N_VOCAB),
+                    mbest, (double)mbest_v, sqrt(msum / DS4_N_VOCAB), best);
+        }
