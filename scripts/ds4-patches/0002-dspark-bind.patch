+    if (ok) ok = ds4_gpu_matmul_q8_0_tensor(g->logits, base_model->map, base_model->size,
+                                            base_weights->output->abs_offset,
+                                            DS4_N_EMBD, vocab_dim, g->output_norm, 1) != 0;
