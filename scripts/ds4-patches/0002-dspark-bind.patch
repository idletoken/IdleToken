+/* IdleToken extension: DSpark, the speculative-decoding draft module shipped with
+ * the official DeepSeek-V4-Flash-0731 release (docs/dspark-design.md).
+ *
+ * It is the MTP module widened to `n_stages` blocks with a different entry
+ * projection and two extra heads:
+ *   - main_proj/main_norm replace e_proj/h_proj/enorm/hnorm. The drafter's
+ *     context is the CONCATENATION of the target model's hidden states at
+ *     target_layer_ids (43-layer model: 40/41/42), so main_proj is
+ *     n_targets*n_embd wide, not 2*n_embd.
+ *   - markov_w1/markov_w2 are the sequential module: an Embedding(V, rank)
+ *     and a Linear(rank, V). Drafting a block adds
+ *     `markov_w2(markov_w1[prev_token])` to each step's logits, which is what
+ *     gives an otherwise-parallel drafter intra-block dependency.
+ *   - confidence_head is present in the checkpoint but NOT bound here: the
+ *     reference DSV4 implementation drops it at load time. Binding a tensor
+ *     nothing reads would just be a claim we do not honor. */
+#define DS4_DSPARK_MAX_STAGES 4
+/* Verifier width cap: DSpark's block_size (5) + the committed position. */
+#define DS4_VERIFY_MAX_N 16
+
+typedef struct {
+    ds4_tensor *main_proj;      /* [n_targets*n_embd, n_embd], stage 0 */
+    ds4_tensor *main_norm;
+    ds4_tensor *norm;           /* final norm, LAST stage */
+    ds4_tensor *hc_head_base;   /* head-side hyper-connection, LAST stage */
+    ds4_tensor *hc_head_fn;
+    ds4_tensor *hc_head_scale;
+    ds4_tensor *markov_w1;      /* [rank, n_vocab] */
+    ds4_tensor *markov_w2;      /* [rank, n_vocab] */
+    ds4_layer_weights block[DS4_DSPARK_MAX_STAGES];
+    uint32_t    n_stages;
+    uint32_t    block_size;     /* draft tokens produced per pass */
+    uint32_t    markov_rank;
+    uint32_t    noise_token_id; /* fills every non-anchor block position */
+    uint32_t    n_targets;
+    int32_t     target_layer_ids[DS4_DSPARK_MAX_STAGES];
+} ds4_dspark_weights;
+
