+/* IdleToken: dequantize ONE row of a Q8_0 [row_len, n_rows] matrix.
+ * The DSpark markov head is an Embedding(vocab, rank) stored as Q8_0, and
+ * ds4's only embedding op reads the F16 token_embd — pointing it at Q8_0
+ * bytes would not crash, it would just return garbage. Hence a dedicated
+ * (and tiny: rank/32 blocks) row read. */
+__global__ static void dequant_q8_0_row_kernel(
+        float *out,
+        const unsigned char *w,
+        uint64_t row_len,
+        uint64_t blocks,
+        uint64_t row) {
+    uint64_t i = (uint64_t)blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= row_len) return;
+    const uint64_t b = i / 32;
+    const uint64_t j = i - b * 32;
+    const unsigned char *blk = w + (row * blocks + b) * 34;
+    const float scale = __half2float(*(const __half *)blk);
+    const int8_t q = *(const int8_t *)(blk + 2 + j);
+    out[i] = scale * (float)q;
+}
+
+extern "C" int ds4_gpu_dequant_q8_0_row_tensor(
+        ds4_gpu_tensor *out,
+        const void      *model_map,
+        uint64_t         model_size,
+        uint64_t         weight_offset,
+        uint64_t         row_len,
+        uint64_t         n_rows,
+        uint64_t         row) {
+    if (!out || !model_map || row_len == 0 || n_rows == 0 || row >= n_rows) return 0;
+    if ((row_len % 32) != 0) return 0;          /* Q8_0 blocks are 32 wide */
+    if (out->bytes < row_len * sizeof(float)) return 0;
+    const uint64_t blocks = row_len / 32;
+    const uint64_t bytes  = n_rows * blocks * 34ull;
+    const char *w = cuda_model_range_ptr(model_map, weight_offset, bytes, "q8_0 row");
+    if (!w) return 0;
+    dequant_q8_0_row_kernel<<<(unsigned)((row_len + 255) / 256), 256>>>(
+            (float *)out->ptr, (const unsigned char *)w, row_len, blocks, row);
+    return cuda_ok(cudaGetLastError(), "q8_0 row dequant");
+}
