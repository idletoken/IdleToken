+/* IdleToken: DSpark markov bias for one step (docs/dspark-design.md §4④).
+ *
+ *     bias = markov_w2( markov_w1[prev_token] )
+ *
+ * w1 is an Embedding(vocab, rank) and w2 a Linear(rank, vocab), both Q8_0, so
+ * this is a rank-wide row read followed by one [rank -> vocab] matmul. The
+ * drafter adds this to the backbone's logits at every block position, which is
+ * the ONLY thing giving an otherwise-parallel block its intra-token
+ * dependency — get it wrong and the drafter still runs, just badly.
+ *
+ * Scratch is allocated per call: this is the standalone step used by the gate
+ * and by diagnostics. The drafter proper will keep these tensors in the graph.
+ */
+int ds4_engine_dspark_markov_bias(ds4_engine *e, int prev_token, float *out, uint32_t n) {
+#ifdef DS4_NO_GPU
+    (void)e; (void)prev_token; (void)out; (void)n;
+    return 0;
+#else
+    if (!e || !e->dspark_ready || !out || n != (uint32_t)DS4_N_VOCAB) return 0;
+    if (prev_token < 0 || prev_token >= DS4_N_VOCAB) return 0;
+    const ds4_dspark_weights *w = &e->dspark_weights;
+    const uint32_t rank = w->markov_rank;
+
+    ds4_gpu_tensor *emb  = ds4_gpu_tensor_alloc((uint64_t)rank * sizeof(float));
+    ds4_gpu_tensor *bias = ds4_gpu_tensor_alloc((uint64_t)DS4_N_VOCAB * sizeof(float));
+    int ok = emb && bias;
+    if (ok) ok = ds4_gpu_begin_commands() != 0;
+    /* w1 is [rank, vocab] in GGUF order: rank is the row length, vocab the
+     * row count, so the token indexes rows. */
+    if (ok) ok = ds4_gpu_dequant_q8_0_row_tensor(emb,
+                                                 e->dspark_model.map,
+                                                 e->dspark_model.size,
+                                                 w->markov_w1->abs_offset,
+                                                 rank,
+                                                 DS4_N_VOCAB,
+                                                 (uint64_t)prev_token) != 0;
+    if (ok) ok = ds4_gpu_matmul_q8_0_tensor(bias,
+                                            e->dspark_model.map,
+                                            e->dspark_model.size,
+                                            w->markov_w2->abs_offset,
+                                            rank,
+                                            DS4_N_VOCAB,
+                                            emb,
+                                            1) != 0;
+    if (ok) ok = ds4_gpu_end_commands() != 0;
+    if (ok) ok = ds4_gpu_synchronize() != 0;
+    if (ok) ok = ds4_gpu_tensor_read(bias, 0, out,
+                                     (uint64_t)DS4_N_VOCAB * sizeof(float)) != 0;
+    ds4_gpu_tensor_free(emb);
+    ds4_gpu_tensor_free(bias);
+    return ok;
+#endif
+}
