+         * output tokens but need completely different fixes. */
+        if (getenv("DS4_DSPARK_TRACE")) {
+            int bbest = 0; float bbest_v = bl[0];
+            for (uint32_t v = 1; v < (uint32_t)DS4_N_VOCAB; v++)
