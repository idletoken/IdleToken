+/* IdleToken: DSpark speculative decode.
+ *
+ * One cycle: commit first_token normally, ask the drafter for a block, then
+ * verify the whole block in ONE layer-major pass. Bookkeeping mirrors the MTP
+ * path exactly — the risk here was never the algorithm, it was keeping
+ * checkpoint.len, the frontier snapshots and s->logits in agreement.
+ *
+ * Acceptance is all-or-one: the single prefix-1 snapshot supports "the block
+ * was right" or "rewind to just after the first draft". Partial accepts need a
+ * snapshot at every position where the compressed state advanced; cheap in
+ * principle (emit only every `ratio` positions) but not needed to prove
+ * correctness, which is what this is for.
+ *
+ * s->logits MUST be rewritten to match however many tokens were accepted:
+ * leave it stale and the next decode continues from a distribution that does
+ * not match the checkpoint — no crash, just silently wrong output.
+ */
+int ds4_session_eval_dspark_argmax(ds4_session *s, int first_token,
+                                   int max_tokens, int eos_token,
+                                   int *accepted, int accepted_cap,
+                                   char *err, size_t errlen) {
+#ifdef DS4_NO_GPU
+    (void)s; (void)first_token; (void)max_tokens; (void)eos_token;
+    (void)err; (void)errlen;
+    if (!accepted || accepted_cap <= 0) return 0;
+    accepted[0] = first_token;
+    return 1;
+#else
+    if (!s || max_tokens <= 0 || accepted_cap <= 0) return 0;
+    ds4_engine *e = s->engine;
+    if (ds4_session_eval(s, first_token, err, errlen) != 0) return -1;
+
+    int n_accept = 0;
+    accepted[n_accept++] = first_token;
+    if (first_token == eos_token || max_tokens == 1 || n_accept >= accepted_cap) return n_accept;
+    if (!e->dspark_ready) return n_accept;
+
+    uint32_t B = e->dspark_weights.block_size;
+    if ((int)B > max_tokens - n_accept)    B = (uint32_t)(max_tokens - n_accept);
+    if ((int)B > accepted_cap - n_accept)  B = (uint32_t)(accepted_cap - n_accept);
+    const int room = s->ctx_size - s->checkpoint.len;
+    if ((int)B > room - 1) B = (uint32_t)(room > 1 ? room - 1 : 0);
+    if (B < 2) return n_accept;   /* nothing to gain from a 1-token block */
+
+    /* Context for the drafter: this position's aux hidden -> main_x -> KV. */
+    float *mx = malloc((size_t)DS4_N_EMBD * sizeof(float));
+    if (!mx) return n_accept;
+    const uint32_t pos = (uint32_t)(s->checkpoint.len - 1);
+    int ok = ds4_engine_dspark_main_x(e, s, mx, DS4_N_EMBD) &&
+             ds4_engine_dspark_push_context(e, s, pos);
+    free(mx);
+    if (!ok) return n_accept;
+
+    int drafts[DS4_VERIFY_MAX_N];
+    if (!ds4_engine_dspark_draft(e, s, first_token, (uint32_t)s->checkpoint.len,
+                                 drafts, B)) {
+        return n_accept;
+    }
+
+    /* draft[0] is verified for free: ds4_session_eval() already produced the
+     * target's prediction for this position. A miss here means there is no
+     * suffix worth verifying, so skip the whole speculative pass. */
+    if (sample_argmax(s->logits, DS4_N_VOCAB) != drafts[0]) return n_accept;
+
+    ds4_spec_frontier frontier;
+    memset(&frontier, 0, sizeof(frontier));
+    const int start = s->checkpoint.len;
+    if (!spec_frontier_snapshot(&frontier, s)) return n_accept;
+
+    int tops[DS4_VERIFY_MAX_N];
+    float *rows = malloc((size_t)B * DS4_N_VOCAB * sizeof(float));
+    if (!rows) { spec_frontier_free(&frontier); return n_accept; }
+
+    ok = metal_graph_verify_decodeN_exact(&s->graph, &e->model, &e->weights,
+                                          drafts, B, (uint32_t)start, tops, rows);
+    if (!ok) {
+        s->checkpoint.len = start;
+        (void)spec_frontier_restore(&frontier, s);
+        spec_frontier_free(&frontier);
+        free(rows);
+        return n_accept;
+    }
