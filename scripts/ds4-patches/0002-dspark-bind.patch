+                                                  w->hc_head_scale->abs_offset,
+                                                  w->hc_head_base->abs_offset,
+                                                  DS4_N_HC, DS4_HC_EPS) != 0;
+    if (ok) ok = ds4_gpu_hc_weighted_sum_tensor(g->output_embd, src_hc,
+                                                g->output_weights,
+                                                DS4_N_EMBD, DS4_N_HC) != 0;
+    if (ok) ok = ds4_gpu_rms_norm_weight_tensor(g->output_norm, g->output_embd,
+                                                dm->map, dm->size,
