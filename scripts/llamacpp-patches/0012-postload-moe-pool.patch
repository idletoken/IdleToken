+static void sched_moe_auto_reset(struct sched_moe_auto_state * st) {
+    if (st == nullptr) {
+        return;
+    }
+    st->ready = false;
+    st->invalid = false;
+    st->weight_hash = 0;
+    st->expert_bytes = 0;
+    st->n_expert = INT64_MAX;
+    st->n_expert_used = 0;
+    st->weights.clear();
+    st->backends.clear();
+}
+
+static void sched_moe_auto_record(ggml_backend_sched_t sched, const struct ggml_tensor * weight,
+                                  const struct ggml_tensor * node, int backend_id) {
+    sched_moe_auto_state * st = sched->moe_auto;
+    if (st == nullptr) {
+        return;
+    }
+    const struct ggml_tensor * ids = node != nullptr ? node->src[2] : nullptr;
+    if (weight == nullptr || weight->ne[2] <= 0 || weight->nb[2] == 0 ||
+        ids == nullptr || ids->ne[0] <= 0 || ids->ne[0] > weight->ne[2]) {
+        st->invalid = true;
+        return;
+    }
+    st->n_expert_used = std::max(st->n_expert_used, ids->ne[0]);
+    if (!st->weights.emplace(weight->name).second) {
+        return;
+    }
+    auto & budget = st->backends[backend_id];
+    if (UINT64_MAX - st->expert_bytes < weight->nb[2] ||
+        SIZE_MAX - budget.expert_bytes < weight->nb[2] ||
+        SIZE_MAX - budget.n_weights < 1) {
+        st->invalid = true;
+        return;
+    }
+    st->expert_bytes += weight->nb[2];
+    st->weight_hash += sched_moe_name_fnv1a(weight->name);
+    st->n_expert = std::min(st->n_expert, weight->ne[2]);
+    budget.expert_bytes += weight->nb[2];
+    budget.staging_bytes = std::max(budget.staging_bytes, ggml_nbytes(weight) + 512);
+    budget.n_weights++;
+}
+
+static bool sched_moe_auto_complete(const struct sched_moe_auto_state * st) {
+    return st != nullptr && !st->invalid && st->expected_weight_count > 0 &&
+           st->n_expert > 0 && st->n_expert_used > 0 && st->n_expert_used <= st->n_expert &&
+           !st->backends.empty() && st->weights.size() == st->expected_weight_count &&
+           st->weight_hash == st->expected_weight_hash;
+}
+
+static void sched_moe_auto_enable(ggml_backend_sched_t sched) {
+    sched_moe_auto_state * st = sched->moe_auto;
+    if (st == nullptr || !st->ready) {
+        return;
+    }
+    // The graph allocator has already reserved the real weights, KV/workspace,
+    // and upstream full-tensor staging. The pool owns one separate full-tensor
+    // staging buffer on each target device; leave another 1 GiB per device
+    // uncommitted for backend/runtime variance, and include the 512-byte tail
+    // on every per-weight allocation. A scheduler spanning multiple local GPUs
+    // uses the smallest safe slot count instead of assuming one particular card.
+    const size_t reserve = 1ull << 30;
+    int cap = INT_MAX;
+    double free_gib = 0;
+    double staging_gib = 0;
+    for (const auto & kv : st->backends) {
+        const int backend_id = kv.first;
+        const sched_moe_auto_state::backend_budget & budget = kv.second;
+        size_t free = 0, total = 0;
+        ggml_backend_dev_t dev = backend_id >= 0 && backend_id < sched->n_backends
+            ? ggml_backend_get_device(sched->backends[backend_id]) : nullptr;
+        if (dev != nullptr && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            ggml_backend_dev_memory(dev, &free, &total);
+        }
+        const size_t tails = budget.n_weights > SIZE_MAX / 512
+            ? SIZE_MAX : budget.n_weights * 512;
+        size_t fixed = reserve;
+        fixed = SIZE_MAX - fixed < budget.staging_bytes
+            ? SIZE_MAX : fixed + budget.staging_bytes;
+        fixed = SIZE_MAX - fixed < tails ? SIZE_MAX : fixed + tails;
+        const size_t room = free > fixed ? free - fixed : 0;
+        const uint64_t raw_cap = budget.expert_bytes > 0 ? room / budget.expert_bytes : 0;
+        const int backend_cap = raw_cap > INT_MAX ? INT_MAX : (int) raw_cap;
+        cap = std::min(cap, backend_cap);
+        free_gib += (double) free / 1073741824.0;
+        staging_gib += (double) budget.staging_bytes / 1073741824.0;
+    }
+    if (cap == INT_MAX) {
+        cap = 0;
+    }
+    cap = (int) std::min<int64_t>(cap, st->n_expert);
+    if (cap >= st->n_expert_used) {
+        sched->moe = sched_moe_state_new_with(cap, 0);
+    }
+    if (sched->moe != nullptr) {
+        GGML_LOG_INFO("moe-pool: adaptive cache enabled after the first complete graph: "
+                      "%d slots/tensor, %zu expert tensors on %zu device(s), %.2f GiB total free, "
+                      "%.2f GiB staging, 1.00 GiB/device reserve; active from the next graph\n",
+                      cap, st->weights.size(), st->backends.size(), free_gib, staging_gib);
+    } else {
+        GGML_LOG_INFO("moe-pool: adaptive cache not enabled after the first complete graph: "
+                      "%zu target device(s) leave %d slots/tensor after staging and the "
+                      "1.00 GiB/device reserve (this model needs at least %lld active experts)\n",
+                      st->backends.size(), cap, (long long) st->n_expert_used);
+    }
+    delete st;
+    sched->moe_auto = nullptr;
+}
