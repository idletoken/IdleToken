+// Record the real selected sets, including small prefill batches that can
+// change cache residency. No scores, activations or prompt text are exported.
+// This is deliberately opt-in and bounded; traced timings are not benchmarks.
+static void sched_moe_trace_routes(ggml_backend_sched_t sched, const ggml_tensor * weight,
+        const std::vector<ggml_bitset_t> & used, int64_t experts, int64_t batch) {
+    if (!sched->moe || !sched->moe->route_trace_graphs ||
+        sched->moe->graph_seq > sched->moe->route_trace_graphs) return;
+    auto & st = *sched->moe;
+    const int layer = sched_moe_layer_of(weight->name);
+    if (layer < 0 || !st.weights.count(weight->name)) return;
+    auto last = st.route_trace_last.find(layer);
+    if (last != st.route_trace_last.end() && last->second == st.graph_seq) return;
+    st.route_trace_last[layer] = st.graph_seq;
+    auto found = st.pools.find(weight->name);
+    const auto * pool = found == st.pools.end() ? nullptr : found->second.get();
+    const int cap = pool ? pool->cap : (int) std::min<int64_t>(st.cap_experts, experts);
+    size_t selected = 0, hits = 0;
+    std::string ids;
+    char number[32];
+    for (int64_t e = 0; e < experts; ++e) {
+        if (!ggml_bitset_get(used.data(), e)) continue;
+        if (selected++) ids += ',';
+        snprintf(number, sizeof(number), "%lld", (long long) e);
+        ids += number;
+        if (pool && pool->where.count((int32_t) e)) ++hits;
+    }
+    fprintf(stderr, "moe-route graph=%llu layer=%d experts=%lld batch=%lld cap=%d selected=%zu hits=%zu ids=%s\n",
+            (unsigned long long) st.graph_seq, layer, (long long) experts,
+            (long long) batch, cap, selected, hits, ids.c_str());
 }
 
