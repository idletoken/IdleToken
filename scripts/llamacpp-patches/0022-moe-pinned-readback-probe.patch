+static void * sched_moe_readback_ptr(ggml_backend_sched_t sched, ggml_backend_t backend,
+                                    bool scores, size_t bytes, void * ordinary) {
+    if (!sched->moe || !sched->moe->pinned_readback) return ordinary;
+    const auto dev = ggml_backend_get_device(backend);
+    const auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    // This diagnostic targets discrete CUDA. It must not allocate a host
+    // buffer on an RPC backend or change the Metal/unified-memory path.
+    if (!reg || strcmp(ggml_backend_reg_name(reg), "CUDA") != 0) return ordinary;
+    int b = -1;
+    for (int i = 0; i < sched->n_backends; i++) {
+        if (sched->backends[i] == backend) { b = i; break; }
+    }
+    if (b < 0) return ordinary;
+    auto & reads = sched->moe->readbacks[b];
+    auto & buffer = scores ? reads.scores : reads.ids;
+    if (!buffer || ggml_backend_buffer_get_size(buffer) < bytes) {
+        if (buffer) ggml_backend_buffer_free(buffer);
+        const auto buft = ggml_backend_dev_host_buffer_type(dev);
+        if (!buft) GGML_ABORT("pinned MoE readback requested but CUDA exposes no host buffer type");
+        buffer = ggml_backend_buft_alloc_buffer(buft, std::max<size_t>(4096, bytes));
+        if (!buffer || ggml_backend_buffer_get_type(buffer) != buft) {
+            GGML_ABORT("pinned MoE readback allocation failed; cannot measure a pageable fallback as pinned");
+        }
+        fprintf(stderr, "moe-readback: device=%s kind=%s bytes=%zu buffer=%s\n",
+                ggml_backend_dev_name(dev), scores ? "scores" : "ids",
+                ggml_backend_buffer_get_size(buffer), ggml_backend_buffer_name(buffer));
+    }
+    return ggml_backend_buffer_get_base(buffer);
+}
