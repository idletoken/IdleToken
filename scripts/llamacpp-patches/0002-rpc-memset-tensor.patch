+// IdleToken patch 0002: memset over RPC, emulated through SET_TENSOR.
+// The upstream pin leaves .memset_tensor NULL, so the first model whose
+// decode path memsets a tensor living on the RPC device hits
+// GGML_ASSERT(memset not implemented) and aborts — measured with
+// DeepSeek-V4-Flash on a 2-node split (2026-08-15). Emulation keeps an
+// UNMODIFIED rpc-server compatible (no new RPC command; the cluster
+// invariant stays "same engine version", not "same patch level").
+// Chunked: a state clear can be large.
+static void ggml_backend_rpc_buffer_memset_tensor(ggml_backend_buffer_t buffer, ggml_tensor * tensor, uint8_t value, size_t offset, size_t size) {
+    const size_t chunk_max = 8u * 1024 * 1024;
+    std::vector<uint8_t> chunk(std::min(size, chunk_max), value);
+    size_t done = 0;
+    while (done < size) {
+        size_t n = std::min(size - done, chunk.size());
+        ggml_backend_rpc_buffer_set_tensor(buffer, tensor, chunk.data(), offset + done, n);
+        done += n;
+    }
+}
