+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// Tiny, explicitly requested routing readbacks need not queue behind expert
+// H2D traffic on GPUs with one copy engine. Store to mapped pinned host memory
+// using an SM instead. The caller still performs its existing stream sync;
+// there is no host polling, relaxed completion test, or change to tensor data.
+static __global__ void ggml_cuda_mapped_readback_kernel(
+        volatile uint32_t * dst, const uint32_t * src, size_t words) {
+    for (size_t i = threadIdx.x; i < words; i += blockDim.x) dst[i] = src[i];
+    __threadfence_system();
+}
+
+static void ggml_backend_cuda_get_tensor_async_mapped(ggml_backend_t backend,
+        const ggml_tensor * tensor, void * data, size_t offset, size_t size) {
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(ctx->device));
+    GGML_ASSERT(size > 0 && size <= 4096 && size % sizeof(uint32_t) == 0);
+    GGML_ASSERT(offset % sizeof(uint32_t) == 0 && (uintptr_t) data % sizeof(uint32_t) == 0);
+    ggml_cuda_set_device(ctx->device);
+    cudaPointerAttributes attributes{};
+    CUDA_CHECK(cudaPointerGetAttributes(&attributes, data));
+    GGML_ASSERT(attributes.type == cudaMemoryTypeHost && attributes.devicePointer != nullptr);
+    ggml_cuda_mapped_readback_kernel<<<1, 128, 0, ctx->stream()>>>(
+        (volatile uint32_t *) attributes.devicePointer,
+        (const uint32_t *) ((const char *) tensor->data + offset), size / sizeof(uint32_t));
+    CUDA_CHECK(cudaGetLastError());
 }
+#endif
 
