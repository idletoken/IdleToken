--- /dev/null
+++ b/ggml/src/ggml-moe-cache-pin.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ggml_moe_cache {
+
+// Protect the whole exact route BEFORE any replacement. Pinning hits while
+// visiting expert IDs lets an earlier miss evict a later, already-resident
+// selected expert, then unnecessarily uploads that expert again.
+template<class Selected>
+inline void pin_selected(const std::vector<int32_t> & experts,
+                         std::vector<uint64_t> & pins, uint64_t tick,
+                         const Selected & selected) {
+    assert(experts.size() == pins.size());
+    for (std::size_t slot = 0; slot < experts.size(); ++slot) {
+        if (experts[slot] >= 0 && selected(experts[slot])) pins[slot] = tick;
+    }
+}
+
+} // namespace ggml_moe_cache
