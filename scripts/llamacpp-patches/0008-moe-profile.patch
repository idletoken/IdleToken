+// ---- per-graph profile of the split loop (GGML_MOE_PROFILE=N) --------------------------
+//
+// Off unless GGML_MOE_PROFILE is set: N prints one summary line every N
+// computed graphs (1 = every graph, i.e. every decode token). When on, every
+// host wait in compute_splits is timed with std::chrono by site, the host time
+// inside the pool calls and each graph submission is measured, the pool
+// counters are read per graph, and on CUDA backends every split's compute
+// stream is bracketed with timing events. The events come from the backend
+// registry (get_proc_address), so this file gains no CUDA dependency and other
+// backends simply report no GPU time. When off, the cost is a pointer test per
+// site: nothing is allocated or recorded. The computation is the same either
+// way; the only wait a profiled graph adds is the event synchronization at its
+// end, which the caller's synchronize would perform next anyway.
+
+typedef std::chrono::steady_clock::time_point sched_prof_tp;
+
+struct sched_prof_site {
+    uint64_t n = 0;
+    double ms = 0;
+};
+
+// timing events of one split on a GPU backend
+struct sched_prof_events {
+    ggml_backend_event_t pre  = nullptr;  // recorded before the split's inputs are handled
+    ggml_backend_event_t mid  = nullptr;  // just before the split's graph is submitted
+    ggml_backend_event_t post = nullptr;  // just after
+    int backend_id = -1;
+    bool expert = false;                  // the split starts with a host-expert MUL_MAT_ID
+};
+
+struct sched_prof {
+    typedef ggml_backend_event_t (*event_new_fn)(ggml_backend_dev_t);
+    typedef float (*event_elapsed_fn)(ggml_backend_event_t, ggml_backend_event_t);
+
+    int every = 1;
+    uint64_t n_graphs = 0;      // graphs computed since the scheduler was created
+    uint64_t in_window = 0;     // graphs summed into the current window
+    int last_expert_split = -1;
+    int64_t graph_batch = 0;    // columns of the first ids readback in the graph
+    uint64_t batch_sum = 0;
+    double wall_ms = 0;
+    // host waits by site (see compute_splits)
+    sched_prof_site w_input, w_pre, w_weight, w_ids, w_other;
+    uint64_t n_splits = 0, n_expert_splits = 0, n_pool = 0, n_rpc = 0, n_ids = 0;
+    uint64_t staging_bytes = 0; // expert bytes copied by the no-pool path
+    // pool counters, as deltas against the previous graph
+    uint64_t hits = 0, misses = 0, prefetched = 0, bypassed = 0, miss_bytes = 0, prefetch_bytes = 0;
+    struct pool_seen { uint64_t hits = 0, misses = 0, prefetched = 0, bypassed = 0; };
+    std::unordered_map<const sched_moe_pool *, pool_seen> seen;
+    // GPU time, CUDA backends only
+    event_new_fn     ev_new[GGML_SCHED_MAX_BACKENDS] = {};
+    event_elapsed_fn ev_elapsed[GGML_SCHED_MAX_BACKENDS] = {};
+    bool is_rpc[GGML_SCHED_MAX_BACKENDS] = {};
+    std::vector<sched_prof_events> ev;
+    size_t ev_used = 0;
+    uint64_t n_gpu = 0;
+    double gpu_expert_gap_ms = 0, gpu_expert_ms = 0, gpu_other_gap_ms = 0, gpu_other_ms = 0;
+};
+
+static struct sched_prof * sched_prof_new(ggml_backend_sched_t sched) {
+    const char * env = getenv("GGML_MOE_PROFILE");
+    if (env == nullptr || atoi(env) <= 0) {
+        return nullptr;
+    }
+    auto * pr = new sched_prof();
+    pr->every = atoi(env);
+    int n_timed = 0;
+    for (int b = 0; b < sched->n_backends; b++) {
+        pr->is_rpc[b] = strncmp(ggml_backend_name(sched->backends[b]), "RPC", 3) == 0;
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        ggml_backend_reg_t reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        if (reg == nullptr) {
+            continue;
+        }
+        const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+        if (type != GGML_BACKEND_DEVICE_TYPE_GPU && type != GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            continue;
+        }
+        pr->ev_new[b]     = (sched_prof::event_new_fn)     ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_timing_event_new");
+        pr->ev_elapsed[b] = (sched_prof::event_elapsed_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_timing_event_elapsed_ms");
+        if (pr->ev_new[b] == nullptr || pr->ev_elapsed[b] == nullptr) {
+            pr->ev_new[b] = nullptr;
+            pr->ev_elapsed[b] = nullptr;
+        } else {
+            n_timed++;
+        }
+    }
+    fprintf(stderr, "moe-profile: on, one line every %d graph(s); GPU timing on %d of %d backend(s)\n",
+        pr->every, n_timed, sched->n_backends);
+    return pr;
+}
+
+static void sched_prof_free(struct sched_prof * pr) {
+    if (pr == nullptr) {
+        return;
+    }
+    for (auto & e : pr->ev) {
+        if (e.pre)  { ggml_backend_event_free(e.pre);  }
+        if (e.mid)  { ggml_backend_event_free(e.mid);  }
+        if (e.post) { ggml_backend_event_free(e.post); }
+    }
+    delete pr;
+}
+
+static inline double sched_prof_ms_since(const sched_prof_tp & t0) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+}
+
+// a timestamp only while profiling; ADD is a no-op without a profile
+#define SCHED_PROF_T(name) const sched_prof_tp name = pr ? std::chrono::steady_clock::now() : sched_prof_tp()
+#define SCHED_PROF_ADD(site, name) do { if (pr) { pr->site.n++; pr->site.ms += sched_prof_ms_since(name); } } while (0)
+
+// the timing events for a split on backend b, or NULL when b has none
+static sched_prof_events * sched_prof_events_for(struct sched_prof * pr, ggml_backend_sched_t sched, int b) {
+    if (pr->ev_new[b] == nullptr) {
+        return nullptr;
+    }
+    if (pr->ev_used == pr->ev.size()) {
+        pr->ev.emplace_back();
+    }
+    sched_prof_events & e = pr->ev[pr->ev_used];
+    if (e.backend_id != b) {
+        // first use, or a slot last used on another device: (re)create on this one
+        if (e.pre)  { ggml_backend_event_free(e.pre);  }
+        if (e.mid)  { ggml_backend_event_free(e.mid);  }
+        if (e.post) { ggml_backend_event_free(e.post); }
+        ggml_backend_dev_t dev = ggml_backend_get_device(sched->backends[b]);
+        e.pre  = pr->ev_new[b](dev);
+        e.mid  = pr->ev_new[b](dev);
+        e.post = pr->ev_new[b](dev);
+        e.backend_id = b;
+    }
+    e.expert = false;
+    pr->ev_used++;
+    return &e;
+}
+
+static void sched_prof_reset_window(struct sched_prof * pr) {
+    pr->in_window = 0;
+    pr->batch_sum = 0;
+    pr->wall_ms = 0;
+    pr->w_input = pr->w_pre = pr->w_weight = pr->w_ids = pr->w_other = sched_prof_site();
+    pr->n_splits = pr->n_expert_splits = pr->n_pool = pr->n_rpc = pr->n_ids = pr->staging_bytes = 0;
+    pr->hits = pr->misses = pr->prefetched = pr->bypassed = pr->miss_bytes = pr->prefetch_bytes = 0;
+    pr->n_gpu = 0;
+    pr->gpu_expert_gap_ms = pr->gpu_expert_ms = pr->gpu_other_gap_ms = pr->gpu_other_ms = 0;
+}
+
+// One line per window; every figure is a per-graph mean over the window's n graphs.
+static void sched_prof_print(const struct sched_prof * pr) {
+    const double n = (double) std::max<uint64_t>(1, pr->in_window);
+    const double mib = 1048576.0;
+    fprintf(stderr,
+        "moe-profile g%llu n=%llu batch %.1f wall %.2f ms"
+        " | splits %.1f (expert %.1f pool %.1f rpc %.1f gpu-timed %.1f) ids-readback %.1f"
+        " | host-wait %.2f ms: input %.1f/%.2f pre %.1f/%.2f weight %.1f/%.2f ids %.1f/%.2f other %.1f/%.2f"
+        " | pool: hit %.1f miss %.1f (%.1f MiB) prefetch %.1f (%.1f MiB) bypass %.1f staging %.1f MiB"
+        " | gpu: expert-gap %.2f mmid %.2f other-gap %.2f other %.2f ms\n",
+        (unsigned long long) pr->n_graphs, (unsigned long long) pr->in_window, pr->batch_sum / n, pr->wall_ms / n,
+        pr->n_splits / n, pr->n_expert_splits / n, pr->n_pool / n, pr->n_rpc / n, pr->n_gpu / n, pr->n_ids / n,
+        (pr->w_input.ms + pr->w_pre.ms + pr->w_weight.ms + pr->w_ids.ms + pr->w_other.ms) / n,
+        pr->w_input.n / n, pr->w_input.ms / n, pr->w_pre.n / n, pr->w_pre.ms / n,
+        pr->w_weight.n / n, pr->w_weight.ms / n, pr->w_ids.n / n, pr->w_ids.ms / n, pr->w_other.n / n, pr->w_other.ms / n,
+        pr->hits / n, pr->misses / n, pr->miss_bytes / n / mib, pr->prefetched / n, pr->prefetch_bytes / n / mib,
+        pr->bypassed / n, pr->staging_bytes / n / mib,
+        pr->gpu_expert_gap_ms / n, pr->gpu_expert_ms / n, pr->gpu_other_gap_ms / n, pr->gpu_other_ms / n);
+}
+
+// Close a profiled graph: read the GPU events, fold in the pool counters, print
+// when the window is full.
+static void sched_prof_end_graph(ggml_backend_sched_t sched, struct sched_prof * pr, const sched_prof_tp & t_graph) {
+    // Profiling deliberately synchronizes the last timing event on each CUDA
+    // backend. This is measurement perturbation, not an otherwise-free probe;
+    // the switch-off path never reaches this function.
+    // The last event of a backend completes after all its earlier ones (stream order).
+    bool synced[GGML_SCHED_MAX_BACKENDS] = {};
+    for (size_t i = pr->ev_used; i-- > 0; ) {
+        const sched_prof_events & e = pr->ev[i];
+        if (!synced[e.backend_id]) {
+            ggml_backend_event_synchronize(e.post);
+            synced[e.backend_id] = true;
+        }
+    }
+    for (size_t i = 0; i < pr->ev_used; i++) {
+        const sched_prof_events & e = pr->ev[i];
+        const float gap = pr->ev_elapsed[e.backend_id](e.pre, e.mid);
+        const float run = pr->ev_elapsed[e.backend_id](e.mid, e.post);
+        if (gap < 0 || run < 0) {
+            continue;   // an event that did not complete is left out, not guessed
+        }
+        pr->n_gpu++;
+        if (e.expert) {
+            pr->gpu_expert_gap_ms += gap;
+            pr->gpu_expert_ms     += run;
+        } else {
+            pr->gpu_other_gap_ms += gap;
+            pr->gpu_other_ms     += run;
+        }
+    }
+    pr->ev_used = 0;
+    if (sched->moe) {
+        for (auto & kv : sched->moe->pools) {
+            const sched_moe_pool * p = kv.second.get();
+            if (p == nullptr) {
+                continue;
+            }
+            sched_prof::pool_seen & s = pr->seen[p];
+            pr->hits           += p->hits - s.hits;
+            pr->misses         += p->misses - s.misses;
+            pr->prefetched     += p->prefetched - s.prefetched;
+            pr->bypassed       += p->bypassed - s.bypassed;
+            pr->miss_bytes     += (p->misses - s.misses) * p->expert_size;
+            pr->prefetch_bytes += (p->prefetched - s.prefetched) * p->expert_size;
+            s.hits = p->hits;
+            s.misses = p->misses;
+            s.prefetched = p->prefetched;
+            s.bypassed = p->bypassed;
+        }
+    }
+    pr->wall_ms += sched_prof_ms_since(t_graph);
+    pr->batch_sum += pr->graph_batch;
+    pr->graph_batch = 0;
+    pr->n_graphs++;
+    pr->in_window++;
+    if (pr->in_window < (uint64_t) pr->every) {
+        return;
+    }
+    sched_prof_print(pr);
+    sched_prof_reset_window(pr);
+}
+
+// A failed graph is not part of the profile. The accumulators are updated in
+// place, so discard the current window and advance the pool baselines rather
+// than letting a later successful graph inherit partial samples.
+static void sched_prof_abort_graph(ggml_backend_sched_t sched, struct sched_prof * pr) {
+    pr->ev_used = 0;
+    pr->last_expert_split = -1;
+    pr->graph_batch = 0;
+    sched_prof_reset_window(pr);
+    if (sched->moe) {
+        for (auto & kv : sched->moe->pools) {
+            const sched_moe_pool * p = kv.second.get();
+            if (p) {
+                sched_prof::pool_seen & s = pr->seen[p];
+                s.hits = p->hits;
+                s.misses = p->misses;
+                s.prefetched = p->prefetched;
+                s.bypassed = p->bypassed;
+            }
+        }
+    }
+}
