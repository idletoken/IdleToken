+        p.deser_ms / n, p.setup_ms / n, p.assign_ms / n, p.alloc_ms / n, p.compute_ms / n, p.total_ms / n);
+    p.in_window = 0;
+    p.recomputes = 0;
+    p.nodes = 0;
+    p.deser_ms = p.setup_ms = p.assign_ms = p.alloc_ms = p.compute_ms = p.total_ms = 0;
+}
