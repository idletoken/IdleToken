+// Timing events for the scheduler's GGML_MOE_PROFILE. The backend's own events
+// are created with cudaEventDisableTiming, so these two are reached only
+// through get_proc_address and serve nothing but elapsed-time queries; record,
+// synchronize and free go through the regular event interface.
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static ggml_backend_event_t ggml_backend_cuda_timing_event_new(ggml_backend_dev_t dev) {
+    ggml_backend_cuda_device_context * dev_ctx = (ggml_backend_cuda_device_context *)dev->context;
+
+    ggml_cuda_set_device(dev_ctx->device);
+
+    cudaEvent_t event;
+    CUDA_CHECK(cudaEventCreateWithFlags(&event, cudaEventDefault));
+
+    return new ggml_backend_event {
+        /* .device  = */ dev,
+        /* .context = */ event,
+    };
+}
+
+// milliseconds between two recorded timing events, negative when either has not completed
+static float ggml_backend_cuda_timing_event_elapsed_ms(ggml_backend_event_t start, ggml_backend_event_t end) {
+    ggml_backend_cuda_device_context * dev_ctx = (ggml_backend_cuda_device_context *) start->device->context;
+    ggml_cuda_set_device(dev_ctx->device);
+
+    float ms = 0.0f;
+    if (cudaEventElapsedTime(&ms, (cudaEvent_t)start->context, (cudaEvent_t)end->context) != cudaSuccess) {
+        return -1.0f;
+    }
+    return ms;
+}
+#endif
+
 static void * ggml_backend_cuda_reg_get_proc_address(ggml_backend_reg_t reg, const char * name) {
     GGML_UNUSED(reg);
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    if (strcmp(name, "ggml_backend_cuda_timing_event_new") == 0) {
+        return (void *)ggml_backend_cuda_timing_event_new;
+    }
+    if (strcmp(name, "ggml_backend_cuda_timing_event_elapsed_ms") == 0) {
+        return (void *)ggml_backend_cuda_timing_event_elapsed_ms;
+    }
+#endif
     if (strcmp(name, "ggml_backend_comm_init") == 0) {
         return (void *)ggml_backend_cuda_comm_init;
     }
