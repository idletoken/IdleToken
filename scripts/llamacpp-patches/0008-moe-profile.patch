+
+void rpc_server::profile_close(int n_nodes, double setup_ms, double assign_ms, double alloc_ms, double compute_ms) {
+    rpc_moe_prof & p = *prof;
+    p.n_graphs++;
+    p.in_window++;
+    p.nodes      += n_nodes;
+    p.recomputes += p.recompute_pending;
+    p.deser_ms   += p.deser_pending_ms;
+    p.setup_ms   += setup_ms;
+    p.assign_ms  += assign_ms;
+    p.alloc_ms   += alloc_ms;
+    p.compute_ms += compute_ms;
+    p.total_ms   += p.deser_pending_ms + setup_ms + assign_ms + alloc_ms + compute_ms;
+    profile_discard_pending();
+    if (p.in_window < (uint64_t) p.every) {
+        return;
+    }
+    const double n = (double) p.in_window;
+    fprintf(stderr, "rpc-profile g%llu n=%llu nodes=%.1f recompute=%.1f | deserialize %.2f setup %.2f assign %.2f split-alloc %.2f compute %.2f total %.2f ms\n",
