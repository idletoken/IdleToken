--- /dev/null
+++ b/ggml/src/ggml-rpc/rpc-input-cache.h
@@ -0,0 +1,35 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <unordered_map>
+#include <vector>
+
+// Buffer-local upload knowledge, not a promise inferred solely from a name.
+// The caller serializes mutations with the owning buffer's mutex.
+class rpc_input_cache {
+    std::unordered_map<uint64_t, std::vector<uint8_t>> entries;
+public:
+    bool matches(uint64_t address, const void * data, size_t size) const {
+        const auto found = entries.find(address);
+        return size != 0 && found != entries.end() && found->second.size() == size &&
+            std::memcmp(found->second.data(), data, size) == 0;
+    }
+    void invalidate(uint64_t address, size_t size) {
+        if (size == 0) return;
+        for (auto it = entries.begin(); it != entries.end();) {
+            // Difference comparisons do not wrap at the end of the address space.
+            const bool overlap = address <= it->first ? it->first - address < size
+                : address - it->first < it->second.size();
+            if (overlap) it = entries.erase(it); else ++it;
+        }
+    }
+    void remember(uint64_t address, const void * data, size_t size) {
+        invalidate(address, size);
+        if (size != 0) {
+            const auto * bytes = static_cast<const uint8_t *>(data);
+            entries[address] = std::vector<uint8_t>(bytes, bytes + size);
+        }
+    }
+    void clear() { entries.clear(); }
+};
