+
+# TLS (PSK) encryption for the TCP transport (see transport.cpp for the
+# protocol choice and the fail-closed policy).
+option(GGML_RPC_TLS "ggml: enable PSK-TLS encryption for the RPC TCP transport" OFF)
+
+if (GGML_RPC_TLS)
+    # mbedTLS, pinned to an exact 3.6 LTS release. IDLETOKEN_MBEDTLS_SRC
+    # overrides the download with a local source tree for offline builds.
+    set(GGML_RPC_TLS_MBEDTLS_TAG "v3.6.7")
+    set(IDLETOKEN_MBEDTLS_SRC "" CACHE PATH "local mbedTLS source dir overriding the pinned download")
+
+    include(FetchContent)
+    set(ENABLE_TESTING         OFF CACHE BOOL "" FORCE)
+    set(ENABLE_PROGRAMS        OFF CACHE BOOL "" FORCE)
+    set(MBEDTLS_FATAL_WARNINGS OFF CACHE BOOL "" FORCE)
+    if (IDLETOKEN_MBEDTLS_SRC)
+        FetchContent_Declare(mbedtls SOURCE_DIR ${IDLETOKEN_MBEDTLS_SRC})
+        message(STATUS "  TLS (PSK) transport enabled (mbedTLS from ${IDLETOKEN_MBEDTLS_SRC})")
+    else()
+        FetchContent_Declare(mbedtls
+            GIT_REPOSITORY https://github.com/Mbed-TLS/mbedtls
+            GIT_TAG        ${GGML_RPC_TLS_MBEDTLS_TAG}
+            GIT_SHALLOW    TRUE
+        )
+        message(STATUS "  TLS (PSK) transport enabled (mbedTLS ${GGML_RPC_TLS_MBEDTLS_TAG})")
+    endif()
+    FetchContent_MakeAvailable(mbedtls)
+
+    target_compile_definitions(ggml-rpc PRIVATE GGML_RPC_TLS)
+    target_link_libraries(ggml-rpc PRIVATE mbedtls mbedx509 mbedcrypto)
+else()
+    message(STATUS "  TLS (PSK) transport disabled")
+endif()
