index 40e11fe..58eaff7 100644
--- a/ggml/src/ggml-rpc/CMakeLists.txt
+++ b/ggml/src/ggml-rpc/CMakeLists.txt
@@ -31,3 +31,36 @@ if (GGML_RPC_RDMA)
