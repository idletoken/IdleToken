+#ifdef GGML_RPC_TLS
+// TLS (pre-shared key) encryption for the TCP transport.
+//
+// Protocol choice: TLS 1.2 with TLS-PSK-WITH-AES-256-GCM-SHA384, pinned on
+// both sides. TLS 1.3 external PSKs in mbedTLS are bound to SHA-256, which
+// limits the AEAD to AES-128-GCM and adds key-exchange-mode configuration
+// surface; both endpoints of this transport are always our own binaries built
+// from the same pinned sources, so version negotiation flexibility buys
+// nothing. The PSK provides mutual authentication; no X.509 is involved.
+//
+// Fail-closed policy (evaluated once per process, from the environment):
+//   GGML_RPC_PSK set (64 hex chars = 32 bytes)
+//       -> every RPC connection is TLS; a failed handshake is a refused
+//          connection. GGML_RPC_PSK_IDENTITY optionally overrides the PSK
+//          identity hint (default "idletoken"); it is a routing label, not a
+//          secret, and both sides must agree on it.
+//   GGML_RPC_PSK unset
+//       -> refuse to serve or connect, naming GGML_RPC_PSK, unless
+//          GGML_RPC_ALLOW_PLAINTEXT=1 is set, which prints a loud banner.
+// There is no silent fallback in either direction.
+
+static constexpr size_t RPC_TLS_PSK_SIZE = 32;
+
+enum rpc_tls_mode {
+    RPC_TLS_MODE_PSK,        // encrypt every connection with the configured PSK
+    RPC_TLS_MODE_PLAINTEXT,  // explicit opt-out (acceptance/testing only)
+    RPC_TLS_MODE_REFUSE,     // no PSK and no explicit opt-out, or malformed PSK
+};
+
+enum rpc_tls_state {
+    RPC_TLS_STATE_OFF,      // plaintext connection (explicit opt-out)
+    RPC_TLS_STATE_PENDING,  // TLS required, handshake not performed yet
+    RPC_TLS_STATE_ACTIVE,   // handshake done, all bytes go through mbedTLS
+    RPC_TLS_STATE_FAILED,   // handshake failed, connection is unusable
+};
+
+struct rpc_tls_config {
+    rpc_tls_mode         mode = RPC_TLS_MODE_REFUSE;
+    std::vector<uint8_t> psk;
+    std::string          identity;
+};
+
+static bool rpc_tls_parse_psk_hex(const char * hex, std::vector<uint8_t> & out) {
+    auto nibble = [](char c) -> int {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    };
+    if (strlen(hex) != 2 * RPC_TLS_PSK_SIZE) {
+        return false;
+    }
+    out.resize(RPC_TLS_PSK_SIZE);
+    for (size_t i = 0; i < RPC_TLS_PSK_SIZE; i++) {
+        int hi = nibble(hex[2 * i]);
+        int lo = nibble(hex[2 * i + 1]);
+        if (hi < 0 || lo < 0) {
+            return false;
+        }
+        out[i] = (uint8_t) ((hi << 4) | lo);
+    }
+    return true;
+}
+
+static const rpc_tls_config & rpc_tls_get_config() {
+    static rpc_tls_config cfg = [] {
+        rpc_tls_config c;
+        const char * hex = std::getenv("GGML_RPC_PSK");
+        if (hex == nullptr || hex[0] == '\0') {
+            const char * allow = std::getenv("GGML_RPC_ALLOW_PLAINTEXT");
+            if (allow != nullptr && strcmp(allow, "1") == 0) {
+                c.mode = RPC_TLS_MODE_PLAINTEXT;
+                GGML_LOG_WARN("================================================================\n");
+                GGML_LOG_WARN("== PLAINTEXT RPC (acceptance/testing only)                    ==\n");
+                GGML_LOG_WARN("== GGML_RPC_ALLOW_PLAINTEXT=1 is set and GGML_RPC_PSK is not. ==\n");
+                GGML_LOG_WARN("== Tensor data and tensor names cross the wire unencrypted.   ==\n");
+                GGML_LOG_WARN("================================================================\n");
+            } else {
+                c.mode = RPC_TLS_MODE_REFUSE;
+            }
+            return c;
+        }
+        if (!rpc_tls_parse_psk_hex(hex, c.psk)) {
+            GGML_LOG_ERROR("RPC TLS: GGML_RPC_PSK is malformed (need %zu hex chars = %zu bytes)\n",
+                           2 * RPC_TLS_PSK_SIZE, RPC_TLS_PSK_SIZE);
+            c.mode = RPC_TLS_MODE_REFUSE;
+            return c;
+        }
+        const char * id = std::getenv("GGML_RPC_PSK_IDENTITY");
+        c.identity = (id != nullptr && id[0] != '\0') ? id : "idletoken";
+        c.mode = RPC_TLS_MODE_PSK;
+        return c;
+    }();
+    return cfg;
+}
+
+// BIO state. TLS fragments every payload into <=16 KiB records and mbedTLS
+// hands each record to the BIO separately; a naive BIO turns one large
+// send_data() into dozens of send() syscalls and per-packet peer wakeups,
+// which measurably drags down tokens/s on low-latency links. tls_send()
+// therefore "corks" the BIO: encrypted records accumulate in `pending` and
+// are flushed in large writes.
+static constexpr size_t RPC_TLS_CORK_FLUSH_SIZE = 1024 * 1024;
+static constexpr size_t RPC_TLS_READAHEAD_SIZE  = 256 * 1024;
+
+struct rpc_tls_bio_ctx {
+    sockfd_t             fd;
+    std::vector<uint8_t> pending;   // encrypted, not yet written to the socket
+    bool                 corked = false;
+    std::vector<uint8_t> rd_buf;    // encrypted read-ahead from the socket
+    size_t               rd_pos = 0;
+};
+
+static bool rpc_tls_bio_flush(rpc_tls_bio_ctx * bio) {
+    size_t off = 0;
+    while (off < bio->pending.size()) {
+        ssize_t n = send(bio->fd, (const char *) bio->pending.data() + off, bio->pending.size() - off, 0);
+        if (n < 0) {
+            return false;
+        }
+        off += (size_t) n;
+    }
+    bio->pending.clear();
+    return true;
+}
+
+static int rpc_tls_bio_send(void * ctx, const unsigned char * buf, size_t len) {
+    auto * bio = (rpc_tls_bio_ctx *) ctx;
+    if (bio->corked) {
+        bio->pending.insert(bio->pending.end(), buf, buf + len);
+        if (bio->pending.size() >= RPC_TLS_CORK_FLUSH_SIZE && !rpc_tls_bio_flush(bio)) {
+            return MBEDTLS_ERR_NET_SEND_FAILED;
+        }
+        return (int) len;
+    }
+    ssize_t n = send(bio->fd, (const char *) buf, len, 0);
+    if (n < 0) {
+        return MBEDTLS_ERR_NET_SEND_FAILED;
+    }
+    return (int) n;
+}
+
+static int rpc_tls_bio_recv(void * ctx, unsigned char * buf, size_t len) {
+    auto * bio = (rpc_tls_bio_ctx *) ctx;
+    // Never read while corked output is pending: the peer may be waiting for
+    // exactly those bytes.
+    if (!bio->pending.empty() && !rpc_tls_bio_flush(bio)) {
+        return MBEDTLS_ERR_SSL_INTERNAL_ERROR;
+    }
+    // Read ahead in large gulps: mbedTLS requests a few bytes of record
+    // header, then the record body, for every <=16 KiB record. Serving those
+    // requests from a buffer filled by one big recv() keeps the syscall and
+    // wakeup count per message close to the plaintext path. recv() returns
+    // as soon as any data is available, so this adds no latency.
+    if (bio->rd_pos == bio->rd_buf.size()) {
+        bio->rd_buf.resize(RPC_TLS_READAHEAD_SIZE);
+        ssize_t n = recv(bio->fd, (char *) bio->rd_buf.data(), bio->rd_buf.size(), 0);
+        if (n < 0) {
+            bio->rd_buf.clear();
+            bio->rd_pos = 0;
+            return MBEDTLS_ERR_NET_RECV_FAILED;
+        }
+        bio->rd_buf.resize((size_t) n);
+        bio->rd_pos = 0;
+        if (n == 0) {
+            return 0;  // peer closed
+        }
+    }
+    size_t take = std::min(len, bio->rd_buf.size() - bio->rd_pos);
+    memcpy(buf, bio->rd_buf.data() + bio->rd_pos, take);
+    bio->rd_pos += take;
+    return (int) take;
+}
+#endif // GGML_RPC_TLS
