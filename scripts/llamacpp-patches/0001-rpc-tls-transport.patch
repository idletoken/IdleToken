+bool socket_t::impl::tls_log_fail(const char * what, int ret) {
+    char err[128];
+    mbedtls_strerror(ret, err, sizeof(err));
+    GGML_LOG_ERROR("RPC TLS: %s failed: -0x%04x %s\n", what, (unsigned) -ret, err);
+    return false;
+}
+
+// Set up the mbedTLS contexts for this connection and run the handshake.
+// Called once, lazily on the server side (see socket_t::accept) and eagerly
+// on the client side (see socket_t::connect).
+bool socket_t::impl::tls_start() {
+    const rpc_tls_config & cfg = rpc_tls_get_config();
+
+    mbedtls_ssl_init(&tls_ssl);
+    mbedtls_ssl_config_init(&tls_conf);
+    mbedtls_ctr_drbg_init(&tls_ctr_drbg);
+    mbedtls_entropy_init(&tls_entropy);
+    tls_ctx_init = true;
+
+    static const char * pers = "ggml-rpc-tls";
+    int ret = mbedtls_ctr_drbg_seed(&tls_ctr_drbg, mbedtls_entropy_func, &tls_entropy,
+                                    (const unsigned char *) pers, strlen(pers));
+    if (ret != 0) {
+        return tls_log_fail("mbedtls_ctr_drbg_seed", ret);
+    }
+    ret = mbedtls_ssl_config_defaults(&tls_conf,
+                                      tls_server ? MBEDTLS_SSL_IS_SERVER : MBEDTLS_SSL_IS_CLIENT,
+                                      MBEDTLS_SSL_TRANSPORT_STREAM, MBEDTLS_SSL_PRESET_DEFAULT);
+    if (ret != 0) {
+        return tls_log_fail("mbedtls_ssl_config_defaults", ret);
+    }
+    mbedtls_ssl_conf_rng(&tls_conf, mbedtls_ctr_drbg_random, &tls_ctr_drbg);
+    // Mutual authentication comes from the PSK itself; no X.509 is involved.
+    mbedtls_ssl_conf_authmode(&tls_conf, MBEDTLS_SSL_VERIFY_NONE);
+    // Pin exactly TLS 1.2 + TLS-PSK-WITH-AES-256-GCM-SHA384 (rationale at top).
+    static const int suites[] = { MBEDTLS_TLS_PSK_WITH_AES_256_GCM_SHA384, 0 };
+    mbedtls_ssl_conf_ciphersuites(&tls_conf, suites);
+    mbedtls_ssl_conf_min_tls_version(&tls_conf, MBEDTLS_SSL_VERSION_TLS1_2);
+    mbedtls_ssl_conf_max_tls_version(&tls_conf, MBEDTLS_SSL_VERSION_TLS1_2);
+
+    ret = mbedtls_ssl_conf_psk(&tls_conf, cfg.psk.data(), cfg.psk.size(),
+                               (const unsigned char *) cfg.identity.data(), cfg.identity.size());
+    if (ret != 0) {
+        return tls_log_fail("mbedtls_ssl_conf_psk", ret);
+    }
+    ret = mbedtls_ssl_setup(&tls_ssl, &tls_conf);
+    if (ret != 0) {
+        return tls_log_fail("mbedtls_ssl_setup", ret);
+    }
+    tls_bio.fd = fd;
+    mbedtls_ssl_set_bio(&tls_ssl, &tls_bio, rpc_tls_bio_send, rpc_tls_bio_recv, nullptr);
+
+    while ((ret = mbedtls_ssl_handshake(&tls_ssl)) != 0) {
+        if (ret != MBEDTLS_ERR_SSL_WANT_READ && ret != MBEDTLS_ERR_SSL_WANT_WRITE) {
+            char err[128];
+            mbedtls_strerror(ret, err, sizeof(err));
+            GGML_LOG_ERROR("RPC TLS handshake failed (%s side): -0x%04x %s - connection refused (PSK mismatch?)\n",
+                           tls_server ? "server" : "client", (unsigned) -ret, err);
+            return false;
+        }
+    }
+    LOG_DBG("[%s] socket %d secured: %s %s\n", __func__, (int) fd,
+            mbedtls_ssl_get_version(&tls_ssl), mbedtls_ssl_get_ciphersuite(&tls_ssl));
+    return true;
+}
+
+bool socket_t::impl::tls_ensure_active() {
+    if (tls_state == RPC_TLS_STATE_ACTIVE) {
+        return true;
+    }
+    if (tls_state == RPC_TLS_STATE_FAILED) {
+        return false;
+    }
+    if (!tls_start()) {
+        tls_state = RPC_TLS_STATE_FAILED;
+        return false;
+    }
+    tls_state = RPC_TLS_STATE_ACTIVE;
+    return true;
+}
+
+bool socket_t::impl::tls_send(const void * data, size_t size) {
+    size_t bytes_sent = 0;
+    tls_bio.corked = true;
+    while (bytes_sent < size) {
+        int ret = mbedtls_ssl_write(&tls_ssl, (const unsigned char *) data + bytes_sent, size - bytes_sent);
+        if (ret > 0) {
+            bytes_sent += (size_t) ret;
+            continue;
+        }
+        if (ret == MBEDTLS_ERR_SSL_WANT_READ || ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
+            continue;
+        }
+        tls_bio.corked = false;
+        char err[128];
+        mbedtls_strerror(ret, err, sizeof(err));
+        GGML_LOG_ERROR("RPC TLS send failed (bytes_sent=%zu, size=%zu): -0x%04x %s\n",
+                       bytes_sent, size, (unsigned) -ret, err);
+        return false;
+    }
+    tls_bio.corked = false;
+    if (!rpc_tls_bio_flush(&tls_bio)) {
+        GGML_LOG_ERROR("RPC TLS send failed (flush, size=%zu)\n", size);
+        return false;
+    }
+    return true;
+}
+
+bool socket_t::impl::tls_recv(void * data, size_t size) {
+    size_t bytes_recv = 0;
+    while (bytes_recv < size) {
+        int ret = mbedtls_ssl_read(&tls_ssl, (unsigned char *) data + bytes_recv, size - bytes_recv);
+        if (ret > 0) {
+            bytes_recv += (size_t) ret;
+            continue;
+        }
+        if (ret == MBEDTLS_ERR_SSL_WANT_READ || ret == MBEDTLS_ERR_SSL_WANT_WRITE) {
+            continue;
+        }
+        if (ret == 0 || ret == MBEDTLS_ERR_SSL_PEER_CLOSE_NOTIFY) {
+            LOG_DBG("RPC TLS recv: peer closed (bytes_recv=%zu, size=%zu)\n", bytes_recv, size);
+        } else {
+            char err[128];
+            mbedtls_strerror(ret, err, sizeof(err));
+            GGML_LOG_ERROR("RPC TLS recv failed (bytes_recv=%zu, size=%zu): -0x%04x %s\n",
+                           bytes_recv, size, (unsigned) -ret, err);
+        }
+        return false;
+    }
+    return true;
+}
+
