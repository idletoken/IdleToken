diff --git a/ggml/src/ggml-cuda/timeline.cuh b/ggml/src/ggml-cuda/timeline.cuh
new file mode 100644
index 0000000..6e3d7b4
--- /dev/null
+++ b/ggml/src/ggml-cuda/timeline.cuh
@@ -0,0 +1,268 @@
+#pragma once
+
+// Opt-in stream-operation brackets, not CUPTI and not a kernel-activity trace.
+// Record only outside graph capture. Calibrate once per capture/thread/device;
+// otherwise collect completed events at existing synchronization points.
+#include "ggml-timeline.h"
+#include <cstddef>
+
+#if defined(_WIN32) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+#include <cuda_runtime.h>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <fcntl.h>
+#include <io.h>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+namespace ggml_cuda_timeline {
+inline void checked(cudaError_t error) {
+    if (error != cudaSuccess) {
+        std::fprintf(stderr, "cuda-event-timeline: %s\n", cudaGetErrorString(error));
+        std::abort();
+    }
+}
+
+inline std::string quoted(const char * s) {
+    std::string out = "\"";
+    for (const unsigned char * p = (const unsigned char *)(s ? s : ""); *p; ++p) {
+        if (*p == '\\' || *p == '"') out += '\\';
+        if (*p < 32) {
+            char escaped[7];
+            std::snprintf(escaped, sizeof(escaped), "\\u%04x", *p);
+            out += escaped;
+        } else out += char(*p);
+    }
+    return out + '"';
+}
+
+struct writer {
+    std::mutex mutex;
+    FILE * file = nullptr;
+    bool enabled = false;
+    uint64_t generation = 0, started = 0, emitted = 0, pending = 0, records = 0;
+    std::atomic<uint64_t> next_id{1};
+
+    void line(const std::string & value) {
+        if (++records > 2000000 || std::fputs(value.c_str(), file) == EOF || std::fputc('\n', file) == EOF) {
+            std::fprintf(stderr, "cuda-event-timeline: record limit or output error\n");
+            std::abort();
+        }
+    }
+    void close_capture() {
+        if (!generation) return;
+        line("{\"kind\":\"capture_stop\",\"capture\":" + std::to_string(generation)
+            + ",\"time\":" + std::to_string(ggml_timeline::api().clock())
+            + ",\"started_spans\":" + std::to_string(started) + ",\"emitted_spans\":" + std::to_string(emitted)
+            + ",\"pending_spans\":" + std::to_string(pending) + ",\"dropped\":0,\"errors\":0}");
+        generation = 0;
+    }
+    writer() {
+        const char * path = std::getenv("ITC_TIMELINE_CUDA_OUTPUT");
+        if (!path || !*path) return;
+        const auto & api = ggml_timeline::api();
+        if (!api.capture || !api.clock) {
+            std::fprintf(stderr, "cuda-event-timeline: compatible host collector is required\n");
+            std::abort();
+        }
+        HANDLE handle = CreateFileA(path, GENERIC_WRITE, FILE_SHARE_READ, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (handle == INVALID_HANDLE_VALUE) std::abort();
+        file = _fdopen(_open_osfhandle((intptr_t) handle, _O_WRONLY | _O_BINARY), "wb");
+        if (!file) std::abort();
+        std::setvbuf(file, nullptr, _IOFBF, 1024 * 1024);
+        line("{\"kind\":\"metadata\",\"schema\":1,\"mode\":\"cuda_event_brackets\","
+             "\"clock\":\"host_qpc_bounds_plus_cuda_elapsed\",\"coverage\":\"instrumented_stream_operations_only\","
+             "\"extra_sync\":\"one_anchor_per_capture_thread_device\",\"cupti\":false}");
+        std::fflush(file);
+        enabled = true;
+        // File housekeeping only: the background thread never calls CUDA.
+        std::thread([this] {
+            unsigned ticks = 0;
+            for (;;) {
+                {
+                    std::lock_guard<std::mutex> guard(mutex);
+                    if (generation && ggml_timeline::api().capture() != generation) {
+                        close_capture();
+                        if (std::fflush(file)) std::abort();
+                    } else if (++ticks % 20 == 0 && std::fflush(file)) std::abort();
+                }
+                Sleep(50);
+            }
+        }).detach();
+    }
+    void touch(uint64_t capture) {
+        std::lock_guard<std::mutex> guard(mutex);
+        if (generation == capture) return;
+        close_capture();
+        if (pending) {
+            std::fprintf(stderr, "cuda-event-timeline: pending events crossed a capture boundary\n");
+            std::abort();
+        }
+        generation = capture;
+        started = emitted = 0;
+        line("{\"kind\":\"capture_start\",\"capture\":" + std::to_string(capture)
+            + ",\"time\":" + std::to_string(ggml_timeline::api().clock()) + "}");
+    }
+};
+// Process-lifetime writer: detached housekeeping must not outlive its object.
+inline writer & output() { static writer * instance = new writer; return *instance; }
+
+struct event_pair {
+    cudaEvent_t start = nullptr, end = nullptr;
+    cudaStream_t stream = nullptr;
+    uint64_t id = 0, capture = 0, anchor_id = 0, host_begin = 0, host_end = 0;
+    uint64_t bytes = 0;
+    bool pending = false, ended = false;
+    std::string category, detail;
+};
+struct device_state {
+    int device = -1;
+    uint64_t capture = 0, anchor_id = 0;
+    cudaEvent_t anchor = nullptr;
+    std::vector<std::unique_ptr<event_pair>> pairs;
+};
+// Bounded timing-event pools live with the CUDA primary context/process.
+// Never call a torn-down runtime from thread-local/static destructors.
+inline std::unordered_map<int, device_state> & states() {
+    static thread_local auto * value = new std::unordered_map<int, device_state>;
+    return *value;
+}
+
+inline void collect() {
+    auto & out = output();
+    if (!out.enabled) return;
+    int device = -1;
+    checked(cudaGetDevice(&device));
+    const auto it = states().find(device);
+    if (it == states().end()) return;
+    auto & state = it->second;
+    for (auto & entry : state.pairs) {
+        auto & e = *entry;
+        if (!e.pending || !e.ended) continue;
+        const auto ready = cudaEventQuery(e.end);
+        if (ready == cudaErrorNotReady) {
+            const auto last = cudaGetLastError();
+            if (last != cudaSuccess && last != cudaErrorNotReady) checked(last);
+            continue;
+        }
+        checked(ready);
+        const uint64_t collected = ggml_timeline::api().clock();
+        float first = 0, last = 0;
+        checked(cudaEventElapsedTime(&first, state.anchor, e.start));
+        checked(cudaEventElapsedTime(&last, state.anchor, e.end));
+        if (!std::isfinite(first) || !std::isfinite(last) || first < 0 || last < first) std::abort();
+        char timing[256];
+        std::snprintf(timing, sizeof(timing), ",\"start_ms\":%.9f,\"end_ms\":%.9f", double(first), double(last));
+        std::lock_guard<std::mutex> guard(out.mutex);
+        out.line("{\"kind\":\"cuda_event_span\",\"id\":" + std::to_string(e.id)
+            + ",\"capture\":" + std::to_string(e.capture) + ",\"anchor\":" + std::to_string(e.anchor_id)
+            + ",\"device\":" + std::to_string(device) + ",\"tid\":" + std::to_string(GetCurrentThreadId())
+            + ",\"stream\":" + std::to_string((uintptr_t) e.stream)
+            + ",\"category\":" + quoted(e.category.c_str()) + ",\"detail\":" + quoted(e.detail.c_str())
+            + ",\"bytes\":" + std::to_string(e.bytes) + timing
+            + ",\"host_begin\":" + std::to_string(e.host_begin) + ",\"host_end\":" + std::to_string(e.host_end)
+            + ",\"host_collected\":" + std::to_string(collected) + "}");
+        ++out.emitted;
+        --out.pending;
+        e.pending = false;
+    }
+}
+
+struct scope {
+    event_pair * event = nullptr;
+    scope(cudaStream_t stream, const char * category, const char * detail, size_t bytes = 0, bool use = true) {
+        auto & out = output();
+        if (!use || !out.enabled) return;
+        const uint64_t capture = ggml_timeline::api().capture();
+        if (!capture) return;
+        static const bool supported = [] {
+            int count = 0;
+            checked(cudaGetDeviceCount(&count));
+            if (count != 1) {
+                std::fprintf(stderr, "cuda-event-timeline: this diagnostic requires one visible CUDA device per process\n");
+                std::abort();
+            }
+            return true;
+        }();
+        (void) supported;
+        out.touch(capture);
+        cudaStreamCaptureStatus status;
+        checked(cudaStreamIsCapturing(stream, &status));
+        if (status != cudaStreamCaptureStatusNone) {
+            std::fprintf(stderr, "cuda-event-timeline: instrumentation inside graph capture is unsupported\n");
+            std::abort();
+        }
+        int device = -1;
+        checked(cudaGetDevice(&device));
+        auto & state = states()[device];
+        state.device = device;
+        if (state.capture != capture) {
+            for (const auto & old : state.pairs) if (old->pending) std::abort();
+            if (!state.anchor) checked(cudaEventCreate(&state.anchor));
+            state.capture = capture;
+            state.anchor_id = out.next_id++;
+            const uint64_t lower = ggml_timeline::api().clock();
+            checked(cudaEventRecord(state.anchor, stream));
+            checked(cudaEventSynchronize(state.anchor));
+            const uint64_t upper = ggml_timeline::api().clock();
+            std::lock_guard<std::mutex> guard(out.mutex);
+            out.line("{\"kind\":\"calibration\",\"id\":" + std::to_string(state.anchor_id)
+                + ",\"capture\":" + std::to_string(capture) + ",\"device\":" + std::to_string(device)
+                + ",\"tid\":" + std::to_string(GetCurrentThreadId())
+                + ",\"host_lower\":" + std::to_string(lower) + ",\"host_upper\":" + std::to_string(upper) + "}");
+        }
+        for (auto & candidate : state.pairs) if (!candidate->pending) { event = candidate.get(); break; }
+        if (!event) {
+            if (state.pairs.size() >= 4096) {
+                std::fprintf(stderr, "cuda-event-timeline: pending-event limit exceeded\n");
+                std::abort();
+            }
+            state.pairs.emplace_back(new event_pair);
+            event = state.pairs.back().get();
+            checked(cudaEventCreate(&event->start));
+            checked(cudaEventCreate(&event->end));
+        }
+        event->id = out.next_id++;
+        event->capture = capture;
+        event->anchor_id = state.anchor_id;
+        event->stream = stream;
+        event->category = category;
+        event->detail = detail ? detail : "";
+        event->bytes = bytes;
+        event->pending = true;
+        event->ended = false;
+        {
+            std::lock_guard<std::mutex> guard(out.mutex);
+            ++out.started;
+            ++out.pending;
+        }
+        event->host_begin = ggml_timeline::api().clock();
+        checked(cudaEventRecord(event->start, stream));
+    }
+    void finish() {
+        if (!event || event->ended) return;
+        event->host_end = ggml_timeline::api().clock();
+        checked(cudaEventRecord(event->end, event->stream));
+        event->ended = true;
+    }
+    ~scope() { finish(); }
+    scope(const scope &) = delete;
+    scope & operator=(const scope &) = delete;
+};
+}
+#else
+namespace ggml_cuda_timeline {
+struct scope {
+    scope(cudaStream_t, const char *, const char *, size_t = 0, bool = true) {}
+    void finish() {}
+};
+inline void collect() {}
+}
+#endif
