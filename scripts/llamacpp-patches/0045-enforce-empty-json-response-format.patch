+static void test_empty_response_format_schema() {
+    // An explicit {} schema allows arbitrary JSON, not arbitrary text. Keep
+    // the specialized template paths and the differential autoparser aligned.
+    const char * paths[] = {
+        "models/templates/Qwen3.5-4B.jinja",
+        "models/templates/Qwen3-Coder.jinja",
+        "models/templates/Qwen-Qwen3-0.6B.jinja",
+        "models/templates/openbmb-MiniCPM5-1B.jinja",
+        "models/templates/mistralai-Ministral-3-14B-Reasoning-2512.jinja",
+        "models/templates/Cohere2MoE.jinja",
+    };
+    for (const auto * path : paths) {
+        auto templates = read_templates(path);
+        for (bool thinking : { false, true }) {
+            common_chat_templates_inputs inputs;
+            common_chat_msg message;
+            message.role = "user";
+            message.content = "Reply with the plain word PLAIN. Do not write JSON.";
+            inputs.messages = { message };
+            inputs.enable_thinking = thinking;
+            const auto plain = common_chat_templates_apply(templates.get(), inputs);
+            for (const auto * schema : { "{}", R"({"type":"object"})" }) {
+                inputs.json_schema = schema;
+                const auto constrained = common_chat_templates_apply(templates.get(), inputs);
+                if (constrained.grammar.empty() || constrained.grammar_lazy ||
+                    constrained.grammar == plain.grammar) {
+                    throw std::runtime_error(std::string("Response format was ignored: ") + path + " schema=" + schema);
+                }
+            }
+        }
+    }
+}
