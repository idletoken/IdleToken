diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -86,7 +86,9 @@
 #include <cstdarg>
 #include <cstdio>
 #include <cstdlib>
+#include <cstring>
 #include <string>
+#include <thread>
 #include <vector>
 
 static_assert(sizeof(half) == sizeof(ggml_fp16_t), "wrong fp16 size");
@@ -1264,16 +1266,338 @@
 
 static bool ggml_backend_buft_is_cuda_host(ggml_backend_buffer_type_t buft) {
     return buft->iface.get_name == ggml_backend_cuda_host_buffer_type_name;
+}
+
+// ---- staged host buffers: page-locked while the driver allows it, staged copies after that ----
+//
+// cudaMallocHost fails far below the free RAM on Windows: the graphics driver stack caps the
+// page-locked memory of a process (two RTX 5060 Ti hosts measured physical RAM minus ~17 GiB
+// with tens of GB free, the same number from three probing methods, 2026-09-07). Upstream then
+// hands out a plain pageable buffer, and every copy from it takes the driver's own staging path
+// at a fraction of the PCIe speed (4.5 vs 21 GB/s measured). Here the host buffer type reports
+// a bounded buffer size (GGML_CUDA_HOST_MAX_MIB, default 4 GiB), so the context allocator
+// splits CPU-side weights into several buffers; each is page-locked with cudaMallocHost while
+// the machine's ceiling allows and a plain pageable buffer after that, and asynchronous
+// host-to-device copies out of a pageable buffer are staged through a per-device pinned ring
+// (the DMA source is always pinned memory). No cudaHostRegister: registering a large heap range
+// chunk by chunk hung a Windows test node outright (12 GiB in six 2 GiB registrations, 2026-09-07), and a
+// build earlier the driver had rejected a copy that crossed two registrations. The bytes that
+// move are the same, so results are unchanged; loads that stay under the ceiling only see the
+// split into several pinned buffers.
+//
+//   GGML_CUDA_HOST_HYBRID=0        off: upstream behaviour (one buffer, pageable fallback)
+//   GGML_CUDA_HOST_MAX_MIB=M       size limit of one host buffer (default 4096)
+//   GGML_CUDA_PINNED_LIMIT_MIB=N   test hook: behave as if only N MiB could be page-locked
+//   GGML_CUDA_STAGE_THREADS=T      memcpy threads for staged copies (default 1)
+//   GGML_CUDA_STAGE_RING_MIB=M     staging ring per device (default 128, sixteen slots)
+
+struct ggml_cuda_staged_region {
+    char * base = nullptr;
+    size_t size = 0;
+};
+
+static std::mutex                           g_cuda_staged_mutex;
+static std::vector<ggml_cuda_staged_region> g_cuda_staged_regions;
+static std::atomic<int>                     g_cuda_staged_count{0};
+static std::atomic<size_t>                  g_cuda_pinned_charged{0};   // bytes counted against the test-hook limit
+
+static bool ggml_cuda_hybrid_enabled() {
+    static const bool on = [] {
+        const char * e = getenv("GGML_CUDA_HOST_HYBRID");
+        return e == nullptr || strcmp(e, "0") != 0;
+    }();
+    return on;
+}
+
+// the test hook: SIZE_MAX when unset
+static size_t ggml_cuda_pinned_limit() {
+    static const size_t limit = [] {
+        const char * e = getenv("GGML_CUDA_PINNED_LIMIT_MIB");
+        return e != nullptr ? (size_t) strtoull(e, nullptr, 10) << 20 : SIZE_MAX;
+    }();
+    return limit;
+}
+
+static bool ggml_cuda_pinned_limit_refuses(size_t bytes) {
+    const size_t limit = ggml_cuda_pinned_limit();
+    if (limit == SIZE_MAX) {
+        return false;
+    }
+    const size_t used = g_cuda_pinned_charged.load();
+    return bytes > limit || used + bytes > limit;
+}
+
+// memcpy thread pool for staged copies: the caller copies one part itself, the workers the rest.
+// One job at a time; the caller waits for all parts before the DMA of that slot is enqueued.
+struct ggml_cuda_stage_pool {
+    int n_workers = 0;
+    std::mutex mutex;
+    std::condition_variable cv_job;
+    std::condition_variable cv_done;
+    uint64_t generation = 0;
+    int remaining = 0;
+    const char * src = nullptr;
+    char * dst = nullptr;
+    size_t part = 0;
+    size_t total = 0;
+
+    explicit ggml_cuda_stage_pool(int n) : n_workers(n) {
+        for (int i = 0; i < n; i++) {
+            std::thread([this, i] { worker(i + 1); }).detach();
+        }
+    }
+
+    void worker(int idx) {
+        uint64_t seen = 0;
+        for (;;) {
+            std::unique_lock<std::mutex> lock(mutex);
+            cv_job.wait(lock, [&] { return generation != seen; });
+            seen = generation;
+            const char * s = src;
+            char * d = dst;
+            const size_t p = part;
+            const size_t t = total;
+            lock.unlock();
+            const size_t off = (size_t) idx * p;
+            if (off < t) {
+                memcpy(d + off, s + off, std::min(p, t - off));
+            }
+            lock.lock();
+            if (--remaining == 0) {
+                cv_done.notify_one();
+            }
+        }
+    }
+
+    void copy(char * d, const char * s, size_t n) {
+        if (n_workers == 0 || n < ((size_t) 512 << 10)) {
+            memcpy(d, s, n);
+            return;
+        }
+        size_t p = (n + (size_t) n_workers) / ((size_t) n_workers + 1);
+        p = (p + 4095) & ~(size_t) 4095;
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            src = s;
+            dst = d;
+            part = p;
+            total = n;
+            remaining = n_workers;
+            generation++;
+        }
+        cv_job.notify_all();
+        memcpy(d, s, std::min(p, n));
+        std::unique_lock<std::mutex> lock(mutex);
+        cv_done.wait(lock, [&] { return remaining == 0; });
+    }
+};
+
+static ggml_cuda_stage_pool * ggml_cuda_stage_pool_get() {
+    // default 1: on the DDR4 test host more memcpy threads decoded slower (1 / 4 / 8 threads:
+    // 37.8 / 35.8 / 34.2 tok/s, 2026-09-07) — the copy competes with the DMA for the same bus.
+    // Never destroyed: detached workers block on its condition variable.
+    static ggml_cuda_stage_pool * pool = [] {
+        const char * e = getenv("GGML_CUDA_STAGE_THREADS");
+        int n = e != nullptr ? atoi(e) : 1;
+        n = std::max(1, std::min(n, 32));
+        return new ggml_cuda_stage_pool(n - 1);
+    }();
+    return pool;
+}
+
+// Small copies (an expert row is 1–3 MiB) are packed into a slot back to back; the slot's
+// event is re-recorded after every DMA, so waiting on it covers all of them. A slot is
+// retired when the next piece does not fit or when the caller's stream changes (an event
+// tracks one stream). Only then does a wrap around the ring wait for that slot's old DMAs.
+struct ggml_cuda_stage_ring {
+    std::mutex mutex;
+    std::vector<char *> slots;
+    std::vector<cudaEvent_t> events;
+    std::vector<bool> pending;
+    size_t slot_bytes = 0;
+    int cur = 0;                        // slot being filled
+    size_t cur_off = 0;                 // bytes already used in it
+    cudaStream_t cur_stream = nullptr;  // stream of the DMAs issued from it
+};
+
+// one ring per device, created on first use; nullptr when not even the ring can be page-locked
+static ggml_cuda_stage_ring * ggml_cuda_stage_ring_get(int device) {
+    static std::mutex mutex;
+    static std::vector<ggml_cuda_stage_ring *> rings;
+    static std::vector<bool> tried;
+    std::lock_guard<std::mutex> lock(mutex);
+    if ((int) rings.size() <= device) {
+        rings.resize(device + 1, nullptr);
+        tried.resize(device + 1, false);
+    }
+    if (tried[device]) {
+        return rings[device];
+    }
+    tried[device] = true;
+    const char * e = getenv("GGML_CUDA_STAGE_RING_MIB");
+    const size_t ring_bytes = (size_t) (e != nullptr ? strtoull(e, nullptr, 10) : 128) << 20;
+    const int n_slots = 16;
+    const size_t slot_bytes = std::max((size_t) 1 << 20, ring_bytes / n_slots);
+    ggml_cuda_set_device(device);
+    auto * ring = new ggml_cuda_stage_ring();
+    ring->slot_bytes = slot_bytes;
+    for (int i = 0; i < n_slots; i++) {
+        void * p = nullptr;
+        if (cudaMallocHost(&p, slot_bytes) != cudaSuccess) {
+            (void) cudaGetLastError();
+            GGML_LOG_WARN("%s: cannot page-lock a %zu MiB staging slot for device %d; pageable copies stay on the driver's path\n",
+                          __func__, slot_bytes >> 20, device);
+            for (size_t j = 0; j < ring->slots.size(); j++) {
+                (void) cudaFreeHost(ring->slots[j]);
+                (void) cudaEventDestroy(ring->events[j]);
+            }
+            delete ring;
+            return nullptr;
+        }
+        cudaEvent_t ev;
+        CUDA_CHECK(cudaEventCreateWithFlags(&ev, cudaEventDisableTiming));
+        ring->slots.push_back((char *) p);
+        ring->events.push_back(ev);
+        ring->pending.push_back(false);
+    }
+    rings[device] = ring;
+    return ring;
 }
 
+// The rings need page-locked memory too, so they are created at the first host buffer
+// allocation, before the weight buffers consume the ceiling. Not on integrated GPUs: they read
+// host buffers in place, and a pageable buffer would be an illegal access there.
+static bool ggml_cuda_staging_possible() {
+    static const bool possible = [] {
+        if (!ggml_cuda_hybrid_enabled() || getenv("GGML_CUDA_NO_PINNED") != nullptr) {
+            return false;
+        }
+        const int n_dev = ggml_cuda_info().device_count;
+        for (int d = 0; d < n_dev; d++) {
+            if (ggml_cuda_info().devices[d].integrated) {
+                return false;
+            }
+        }
+        bool ok = n_dev > 0;
+        for (int d = 0; d < n_dev; d++) {
+            ok = ggml_cuda_stage_ring_get(d) != nullptr && ok;
+        }
+        return ok;
+    }();
+    return possible;
+}
+
+// whether an asynchronous host-to-device copy from [data, data + size) has to be staged: the
+// range lies in a pageable host buffer of ours
+static bool ggml_cuda_host_needs_staging(const void * data, size_t size) {
+    if (g_cuda_staged_count.load(std::memory_order_acquire) == 0) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_cuda_staged_mutex);
+    const char * p = (const char *) data;
+    for (const auto & r : g_cuda_staged_regions) {
+        if (p >= r.base && p < r.base + r.size) {
+            return true;
+        }
+    }
+    GGML_UNUSED(size);
+    return false;
+}
+
+static void ggml_cuda_staged_memcpy_h2d(int device, void * dst, const void * src, size_t size, cudaStream_t stream) {
+    ggml_cuda_stage_ring * ring = ggml_cuda_stage_ring_get(device);
+    if (ring == nullptr) {
+        CUDA_CHECK(cudaMemcpyAsync(dst, src, size, cudaMemcpyHostToDevice, stream));
+        return;
+    }
+    ggml_cuda_stage_pool * pool = ggml_cuda_stage_pool_get();
+    std::lock_guard<std::mutex> lock(ring->mutex);
+    const char * s = (const char *) src;
+    char * d = (char *) dst;
+    const size_t align = 256;
+    while (size > 0) {
+        const size_t n = std::min(size, ring->slot_bytes);
+        if (ring->cur_off + n > ring->slot_bytes || (ring->cur_off > 0 && ring->cur_stream != stream)) {
+            // retire the slot being filled and move to the next one
+            ring->cur = (ring->cur + 1) % (int) ring->slots.size();
+            ring->cur_off = 0;
+        }
+        if (ring->cur_off == 0 && ring->pending[ring->cur]) {
+            CUDA_CHECK(cudaEventSynchronize(ring->events[ring->cur]));
+            ring->pending[ring->cur] = false;
+        }
+        char * slot = ring->slots[ring->cur] + ring->cur_off;
+        pool->copy(slot, s, n);
+        CUDA_CHECK(cudaMemcpyAsync(d, slot, n, cudaMemcpyHostToDevice, stream));
+        CUDA_CHECK(cudaEventRecord(ring->events[ring->cur], stream));
+        ring->pending[ring->cur] = true;
+        ring->cur_stream = stream;
+        ring->cur_off += (n + align - 1) & ~(align - 1);
+        s += n;
+        d += n;
+        size -= n;
+    }
+}
+
+// a plain pageable buffer whose copies are staged; nullptr when staging is not possible
+static void * ggml_cuda_staged_host_alloc(size_t size) {
+    if (!ggml_cuda_staging_possible()) {
+        return nullptr;
+    }
+    char * base = nullptr;
+#ifdef _WIN32
+    base = (char *) _aligned_malloc(size, 4096);
+#else
+    if (posix_memalign((void **) &base, 4096, size) != 0) {
+        base = nullptr;
+    }
+#endif
+    if (base == nullptr) {
+        return nullptr;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_cuda_staged_mutex);
+        g_cuda_staged_regions.push_back({ base, size });
+        g_cuda_staged_count.fetch_add(1, std::memory_order_release);
+    }
+    GGML_LOG_INFO("%s: staged host buffer: %.2f MiB is pageable (the page-lock ceiling is reached); its copies go through the pinned ring\n",
+                  __func__, size / 1024.0 / 1024.0);
+    return base;
+}
+
+static void ggml_backend_cuda_staged_host_buffer_free_buffer(ggml_backend_buffer_t buffer) {
+    char * base = (char *) buffer->context;
+    {
+        std::lock_guard<std::mutex> lock(g_cuda_staged_mutex);
+        for (size_t i = 0; i < g_cuda_staged_regions.size(); i++) {
+            if (g_cuda_staged_regions[i].base == base) {
+                g_cuda_staged_regions.erase(g_cuda_staged_regions.begin() + i);
+                g_cuda_staged_count.fetch_sub(1, std::memory_order_release);
+                break;
+            }
+        }
+    }
+#ifdef _WIN32
+    _aligned_free(base);
+#else
+    free(base);
+#endif
+}
+
 static void ggml_backend_cuda_host_buffer_free_buffer(ggml_backend_buffer_t buffer) {
     CUDA_CHECK(cudaFreeHost(buffer->context));
+    g_cuda_pinned_charged -= buffer->size;
 }
 
 static void * ggml_cuda_host_malloc(size_t size) {
     if (getenv("GGML_CUDA_NO_PINNED") != nullptr) {
         return nullptr;
     }
+    if (ggml_cuda_pinned_limit_refuses(size)) {
+        GGML_LOG_INFO("%s: GGML_CUDA_PINNED_LIMIT_MIB refuses %.2f MiB of pinned memory (test hook)\n", __func__,
+                      size / 1024.0 / 1024.0);
+        return nullptr;
+    }
 
     void * ptr = nullptr;
     cudaError_t err = cudaMallocHost((void **) &ptr, size);
@@ -1284,23 +1608,48 @@
                            size / 1024.0 / 1024.0, cudaGetErrorString(err));
         return nullptr;
     }
+    g_cuda_pinned_charged += size;
 
     return ptr;
+}
+
+// bounded so that the context allocator splits CPU-side weights into several host buffers and
+// the page-lock ceiling costs at most one of them; unbounded (upstream) when staging is off
+static size_t ggml_backend_cuda_host_buffer_type_get_max_size(ggml_backend_buffer_type_t buft) {
+    static const size_t max_size = [] {
+        if (!ggml_cuda_hybrid_enabled()) {
+            return SIZE_MAX;
+        }
+        const char * e = getenv("GGML_CUDA_HOST_MAX_MIB");
+        const size_t mib = e != nullptr ? (size_t) strtoull(e, nullptr, 10) : 4096;
+        return mib > 0 ? mib << 20 : SIZE_MAX;
+    }();
+    GGML_UNUSED(buft);
+    return max_size;
 }
 
 static ggml_backend_buffer_t ggml_backend_cuda_host_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    (void) ggml_cuda_staging_possible();   // rings first, before this buffer takes the ceiling
+
     void * ptr = ggml_cuda_host_malloc(size);
 
-    if (ptr == nullptr) {
-        // fallback to cpu buffer
-        return ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size);
+    if (ptr != nullptr) {
+        ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
+        buffer->buft = buft;
+        buffer->iface.free_buffer = ggml_backend_cuda_host_buffer_free_buffer;
+        return buffer;
     }
 
-    ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
-    buffer->buft = buft;
-    buffer->iface.free_buffer = ggml_backend_cuda_host_buffer_free_buffer;
+    ptr = ggml_cuda_staged_host_alloc(size);
+    if (ptr != nullptr) {
+        ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
+        buffer->buft = buft;
+        buffer->iface.free_buffer = ggml_backend_cuda_staged_host_buffer_free_buffer;
+        return buffer;
+    }
 
-    return buffer;
+    // fallback to cpu buffer
+    return ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size);
 }
 
 ggml_backend_buffer_type_t ggml_backend_cuda_host_buffer_type() {
@@ -1309,7 +1658,7 @@
             /* .get_name         = */ ggml_backend_cuda_host_buffer_type_name,
             /* .alloc_buffer     = */ ggml_backend_cuda_host_buffer_type_alloc_buffer,
             /* .get_alignment    = */ ggml_backend_cpu_buffer_type()->iface.get_alignment,
-            /* .get_max_size     = */ NULL, // defaults to SIZE_MAX
+            /* .get_max_size     = */ ggml_backend_cuda_host_buffer_type_get_max_size,
             /* .get_alloc_size   = */ ggml_backend_cpu_buffer_type()->iface.get_alloc_size,
             /* .is_host          = */ ggml_backend_cpu_buffer_type()->iface.is_host,
         },
@@ -2431,6 +2780,11 @@
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
 
+    if (ggml_cuda_host_needs_staging(data, size)) {
+        ggml_cuda_staged_memcpy_h2d(cuda_ctx->device, (char *) tensor->data + offset, data, size, cuda_ctx->stream());
+        return;
+    }
+
     CUDA_CHECK(cudaMemcpyAsync((char *) tensor->data + offset, data, size, cudaMemcpyHostToDevice, cuda_ctx->stream()));
 }
 
@@ -2449,6 +2803,14 @@
     ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
 
     GGML_ASSERT(buf->buft == ggml_backend_cuda_buffer_type(cuda_ctx->device) && "unsupported buffer type");
+
+    if (n_copies > 0 && ggml_cuda_host_needs_staging(data, (n_copies - 1) * stride_data + size)) {
+        for (size_t i = 0; i < n_copies; i++) {
+            ggml_cuda_staged_memcpy_h2d(cuda_ctx->device, (char *) tensor->data + offset + i * stride_tensor,
+                                        (const char *) data + i * stride_data, size, cuda_ctx->stream());
+        }
+        return;
+    }
 
     CUDA_CHECK(cudaMemcpy2DAsync(
         (char *) tensor->data + offset, stride_tensor, data, stride_data, size, n_copies, cudaMemcpyHostToDevice, cuda_ctx->stream()));
diff --git a/tools/rpc/rpc-server.cpp b/tools/rpc/rpc-server.cpp
--- a/tools/rpc/rpc-server.cpp
+++ b/tools/rpc/rpc-server.cpp
@@ -185,6 +185,14 @@
 
 static int run_pinned_probe() {
     const size_t MiB = 1024u * 1024u;
+    // The probe measures the raw page-lock ceiling. A hybrid host buffer (patch 0007) would
+    // answer a failed lock with a partially locked buffer of the same type, so it is switched
+    // off in this process before the first allocation.
+#ifdef _WIN32
+    _putenv_s("GGML_CUDA_HOST_HYBRID", "0");
+#else
+    setenv("GGML_CUDA_HOST_HYBRID", "0", 1);
+#endif
     ggml_backend_dev_t gpu = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU);
     if (!gpu) {
         fprintf(stderr, "pinned probe: no GPU device; nothing to pin for\n");
