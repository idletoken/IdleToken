+// Small slot-id updates otherwise queue on the copy engine behind large expert
+// H2D transfers. CUDA copies by-value launch arguments before this call returns;
+// writing them on the compute stream preserves ordering without pinned-memory
+// lifetime rules, another stream, or a host synchronization.
+static __global__ void ggml_cuda_inline_ids_kernel(
+        int32_t * dst, ggml_moe_inline_ids::payload values, size_t count) {
+    if (threadIdx.x < count) dst[threadIdx.x] = values.values[threadIdx.x];
+}
+
+static bool ggml_backend_cuda_set_tensor_async_inline_ids(ggml_backend_t backend,
+        ggml_tensor * tensor, const void * data, size_t offset, size_t size) {
+    ggml_moe_inline_ids::payload values;
+    if (tensor->type != GGML_TYPE_I32 || !ggml_is_contiguous(tensor) ||
+        offset % sizeof(int32_t) != 0 || offset > ggml_nbytes(tensor) ||
+        size > ggml_nbytes(tensor) - offset || !ggml_moe_inline_ids::pack(values, data, size)) {
+        return false;
+    }
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_backend_buffer_t buf = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    GGML_ASSERT(buf && buf->buft == ggml_backend_cuda_buffer_type(ctx->device));
+    ggml_cuda_set_device(ctx->device);
+    ggml_cuda_timeline::scope timing(ctx->stream(), "inline_ids", tensor->name, size);
+    ggml_cuda_inline_ids_kernel<<<1, ggml_moe_inline_ids::capacity, 0, ctx->stream()>>>(
+        (int32_t *) ((char *) tensor->data + offset), values, size / sizeof(int32_t));
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+}
