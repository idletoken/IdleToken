--- /dev/null
+++ b/ggml/src/ggml-moe-inline-ids.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace ggml_moe_inline_ids {
+// A kernel-argument fast path, not a model/expert-count limit. Larger batches
+// keep the ordinary tensor upload. No asynchronous host pointer is retained.
+constexpr size_t capacity = 64;
+struct payload {
+    int32_t values[capacity];
+};
+
+inline bool pack(payload & out, const void * source, size_t bytes) {
+    if (!source || bytes == 0 || bytes % sizeof(int32_t) != 0 || bytes > sizeof(out.values)) {
+        return false;
+    }
+    out = {};
+    std::memcpy(out.values, source, bytes);
+    return true;
+}
+}
