+static bool ggml_backend_rpc_can_stream_moe(ggml_backend_buffer_t src_buffer, ggml_backend_t dst_backend) {
+    const char * enabled = std::getenv("GGML_RPC_NODE_LOCAL_MOE");
+    if (enabled == nullptr || std::strcmp(enabled, "1") != 0 ||
+        src_buffer == nullptr || dst_backend == nullptr ||
+        !ggml_backend_buffer_is_rpc(src_buffer) || !ggml_backend_is_rpc(dst_backend)) {
+        return false;
+    }
+
+    auto * src_buft_ctx = (ggml_backend_rpc_buffer_type_context *) src_buffer->buft->context;
+    auto * dst_ctx = (ggml_backend_rpc_context *) dst_backend->context;
+    ggml_backend_dev_t src_dev = ggml_backend_buft_get_device(src_buffer->buft);
+    ggml_backend_dev_t dst_dev = ggml_backend_get_device(dst_backend);
+    return src_buft_ctx != nullptr && dst_ctx != nullptr &&
+           src_buft_ctx->endpoint == dst_ctx->endpoint &&
+           ggml_backend_dev_type(src_dev) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+           (ggml_backend_dev_type(dst_dev) == GGML_BACKEND_DEVICE_TYPE_GPU ||
+            ggml_backend_dev_type(dst_dev) == GGML_BACKEND_DEVICE_TYPE_IGPU);
+}
+
+static bool ggml_backend_rpc_copy_moe_ranges(const ggml_tensor * src, ggml_tensor * dst,
+                                               const size_t * offsets, const size_t * sizes,
+                                               size_t n_ranges) {
+    if (src == nullptr || dst == nullptr || offsets == nullptr || sizes == nullptr ||
+        src->buffer == nullptr || dst->buffer == nullptr ||
+        n_ranges == 0 || n_ranges > UINT32_MAX ||
+        !ggml_backend_buffer_is_rpc(src->buffer) || !ggml_backend_buffer_is_rpc(dst->buffer)) {
+        return false;
+    }
+
+    auto * src_buft_ctx = (ggml_backend_rpc_buffer_type_context *) src->buffer->buft->context;
+    auto * dst_buft_ctx = (ggml_backend_rpc_buffer_type_context *) dst->buffer->buft->context;
+    ggml_backend_dev_t src_dev = ggml_backend_buft_get_device(src->buffer->buft);
+    ggml_backend_dev_t dst_dev = ggml_backend_buft_get_device(dst->buffer->buft);
+    const char * enabled = std::getenv("GGML_RPC_NODE_LOCAL_MOE");
+    if (enabled == nullptr || std::strcmp(enabled, "1") != 0 ||
+        src_buft_ctx == nullptr || dst_buft_ctx == nullptr ||
+        src_buft_ctx->endpoint != dst_buft_ctx->endpoint ||
+        ggml_backend_dev_type(src_dev) != GGML_BACKEND_DEVICE_TYPE_CPU ||
+        (ggml_backend_dev_type(dst_dev) != GGML_BACKEND_DEVICE_TYPE_GPU &&
+         ggml_backend_dev_type(dst_dev) != GGML_BACKEND_DEVICE_TYPE_IGPU)) {
+        return false;
+    }
+
+    auto * src_ctx = (ggml_backend_rpc_buffer_context *) src->buffer->context;
+    auto * dst_ctx = (ggml_backend_rpc_buffer_context *) dst->buffer->context;
+    if (src_ctx == nullptr || dst_ctx == nullptr || src_ctx->sock != dst_ctx->sock) {
+        return false;
+    }
+
+    const size_t src_bytes = ggml_nbytes(src);
+    const size_t dst_bytes = ggml_nbytes(dst);
+    for (size_t i = 0; i < n_ranges; ++i) {
+        if (offsets[i] > src_bytes || sizes[i] > src_bytes - offsets[i] ||
+            offsets[i] > dst_bytes || sizes[i] > dst_bytes - offsets[i]) {
+            return false;
+        }
+    }
+
+    rpc_msg_copy_tensor_ranges_req request = {
+        /* .src       = */ serialize_tensor(src),
+        /* .dst       = */ serialize_tensor(dst),
+        /* .n_ranges  = */ (uint32_t) n_ranges,
+        /* .reserved  = */ 0,
+    };
+    std::vector<uint8_t> input(sizeof(request) + n_ranges * sizeof(rpc_tensor_range));
+    memcpy(input.data(), &request, sizeof(request));
+    auto * ranges = (rpc_tensor_range *) (input.data() + sizeof(request));
+    for (size_t i = 0; i < n_ranges; ++i) {
+        ranges[i].offset = offsets[i];
+        ranges[i].size = sizes[i];
+    }
+    bool status = send_rpc_cmd(src_ctx->sock, RPC_CMD_COPY_TENSOR_RANGES, input.data(), input.size());
+    RPC_STATUS_ASSERT(status);
+    return status;
+}
