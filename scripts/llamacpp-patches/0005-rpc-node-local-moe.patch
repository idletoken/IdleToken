+bool rpc_server::copy_tensor_ranges(const std::vector<uint8_t> & input) {
+    if (input.size() < sizeof(rpc_msg_copy_tensor_ranges_req)) {
+        return false;
+    }
+    const auto * request = (const rpc_msg_copy_tensor_ranges_req *) input.data();
+    if (request->n_ranges == 0 || request->reserved != 0 ||
+        input.size() != sizeof(*request) + request->n_ranges * sizeof(rpc_tensor_range)) {
+        return false;
+    }
+
+    struct ggml_init_params params {
+        /*.mem_size   =*/ 2 * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx_ptr { ggml_init(params) };
+    GGML_ASSERT(ctx_ptr != nullptr);
+    ggml_context * ctx = ctx_ptr.get();
+    ggml_tensor * src = deserialize_tensor(ctx, &request->src);
+    ggml_tensor * dst = deserialize_tensor(ctx, &request->dst);
+    if (src == nullptr || dst == nullptr || src->buffer == nullptr || dst->buffer == nullptr ||
+        !ggml_backend_buffer_is_host(src->buffer)) {
+        GGML_LOG_ERROR("[%s] source must be a host buffer and destination must be valid\n", __func__);
+        return false;
+    }
+    const auto src_owner = buffers.find(src->buffer);
+    const auto dst_owner = buffers.find(dst->buffer);
+    if (src_owner == buffers.end() || dst_owner == buffers.end() ||
+        src_owner->second >= backends.size() || dst_owner->second >= backends.size()) {
+        GGML_LOG_ERROR("[%s] source or destination buffer is not owned by this client\n", __func__);
+        return false;
+    }
+    ggml_backend_dev_t src_dev = ggml_backend_get_device(backends[src_owner->second]);
+    ggml_backend_dev_t dst_dev = ggml_backend_get_device(backends[dst_owner->second]);
+    if (src_dev == nullptr || dst_dev == nullptr || src_owner->second == dst_owner->second ||
+        ggml_backend_dev_type(src_dev) != GGML_BACKEND_DEVICE_TYPE_CPU ||
+        (ggml_backend_dev_type(dst_dev) != GGML_BACKEND_DEVICE_TYPE_GPU &&
+         ggml_backend_dev_type(dst_dev) != GGML_BACKEND_DEVICE_TYPE_IGPU)) {
+        GGML_LOG_ERROR("[%s] only same-server CPU-to-GPU copies are allowed "
+                       "(src=%s/%d dst=%s/%d)\n", __func__,
+                       src_dev ? ggml_backend_dev_name(src_dev) : "none",
+                       src_dev ? (int)ggml_backend_dev_type(src_dev) : -1,
+                       dst_dev ? ggml_backend_dev_name(dst_dev) : "none",
+                       dst_dev ? (int)ggml_backend_dev_type(dst_dev) : -1);
+        return false;
+    }
+
+    const size_t src_bytes = ggml_nbytes(src);
+    const size_t dst_bytes = ggml_nbytes(dst);
+    const auto * ranges = (const rpc_tensor_range *) (input.data() + sizeof(*request));
+    for (uint32_t i = 0; i < request->n_ranges; ++i) {
+        const size_t offset = ranges[i].offset;
+        const size_t size = ranges[i].size;
+        if (offset > src_bytes || size > src_bytes - offset ||
+            offset > dst_bytes || size > dst_bytes - offset) {
+            GGML_LOG_ERROR("[%s] range %u is outside the tensor\n", __func__, i);
+            return false;
+        }
+        /* Mirror the scheduler's local host-offload path: enqueue the H2D copy
+         * on the destination backend and let the following graph command keep
+         * stream order. A synchronous copy here would add a network-visible
+         * round trip and serialize every selected expert range. */
+        ggml_backend_tensor_set_async(backends[dst_owner->second], dst,
+                                      (const uint8_t *) src->data + offset,
+                                      offset, size);
+    }
+    LOG_DBG("[%s] copied %u selected-expert ranges locally\n", __func__, request->n_ranges);
+    return true;
+}
