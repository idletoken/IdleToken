+    auto fn = (ggml_backend_rpc_copy_moe_ranges_t) ggml_backend_reg_get_proc_address(
+        ggml_backend_dev_backend_reg(dev), "ggml_backend_rpc_copy_moe_ranges");
+    return fn != nullptr && fn(src, dst, offsets, sizes, n_ranges);
