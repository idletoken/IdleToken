+}
+
+static bool rpc_can_stream_moe(ggml_backend_buffer_t src_buffer, ggml_backend_t dst_backend) {
+    auto fn = get_rpc_can_stream_moe(src_buffer);
+    return fn != nullptr && fn(src_buffer, dst_backend);
