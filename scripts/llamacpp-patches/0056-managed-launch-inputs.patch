 static bool common_params_parse_ex(int argc, char ** argv, common_params_context & ctx_arg) {
     common_params & params = ctx_arg.params;
 
+    // A managed launch has already admitted its exact CLI configuration. Read
+    // this sentinel before any implicit preset or environment handler: those
+    // handlers can append speculators and tensor overrides that later CLI
+    // options do not remove. Match the parser's long-option normalization.
+    bool idletoken_managed = false;
+    for (int i = 1; i < argc; ++i) {
+        std::string arg = argv[i];
+        std::replace(arg.begin(), arg.end(), '_', '-');
+        if (arg == "--idletoken-managed") {
+            idletoken_managed = true;
+            break;
+        }
+    }
+
     // setup log directly from params.verbosity: see tools/cli/cli.cpp
     common_log_set_verbosity_thold(params.verbosity);
 
     // config file applies first, so env variables and CLI arguments override it
