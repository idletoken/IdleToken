+    if (!idletoken_managed) {
+        common_params_apply_system_config(params, ctx_arg.ex);
+    }
 
     std::unordered_map<std::string, std::pair<common_arg *, bool>> arg_to_options;
     for (auto & opt : ctx_arg.options) {
@@ -782,7 +798,7 @@
