--- /dev/null
+++ b/ggml/src/ggml-moe-schedule.h
@@ -0,0 +1,278 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+// Pure policy. All geometry and timing inputs belong to one owner device.
+namespace ggml_moe_schedule {
+
+static inline bool add(size_t a, size_t b, size_t & out) {
+    if (a > SIZE_MAX - b) return false;
+    out = a + b;
+    return true;
+}
+
+static inline bool mul(size_t a, size_t b, size_t & out) {
+    if (b && a > SIZE_MAX / b) return false;
+    out = a * b;
+    return true;
+}
+
+static inline bool align(size_t a, size_t alignment, size_t & out) {
+    if (!alignment) return false;
+    const size_t rem = a % alignment;
+    return add(a, rem ? alignment - rem : 0, out);
+}
+
+struct samples {
+    static constexpr size_t capacity = 32;
+    std::vector<double> values;
+    size_t next = 0;
+
+    bool push(double ms) {
+        if (!std::isfinite(ms) || ms < 0) return false;
+        if (values.size() < capacity) values.push_back(ms);
+        else values[next] = ms;
+        next = (next + 1) % capacity;
+        return true;
+    }
+
+    double quantile(double q, size_t minimum = 8) const {
+        if (values.size() < minimum || !(q > 0 && q <= 1)) return -1;
+        auto sorted = values;
+        std::sort(sorted.begin(), sorted.end());
+        return sorted[(size_t) std::ceil(q * sorted.size()) - 1];
+    }
+};
+
+struct part {
+    size_t bytes = 0;          // Actual expert stride, not a GGUF file span.
+    double copy_ms = -1;       // Measured cost of one copy of this part.
+};
+
+struct layer {
+    int id = -1;
+    size_t experts = 0;
+    size_t active = 0;         // Minimum resident capacity for exact repair.
+    double window_ms = -1;     // Independent compute, measured without prediction copies.
+    std::vector<part> parts;
+};
+
+struct allocation {
+    size_t resident = 0;
+    size_t rolling = 0;
+    size_t rolling_bytes = 0;
+    double copy_budget_ms = 0;
+};
+
+struct plan {
+    bool valid = false;
+    const char * reason = "invalid-input";
+    size_t bank_bytes = 0;
+    size_t staging_bytes = 0;
+    size_t resident_bytes = 0;
+    size_t total_bytes = 0;
+    std::vector<allocation> layers;
+};
+
+static inline bool layer_bytes(const layer & l, size_t slots, size_t alignment,
+                               size_t tail, size_t & bytes) {
+    bytes = 0;
+    if (!slots) return true;
+    for (const auto & p : l.parts) {
+        size_t payload = 0;
+        if (!mul(slots, p.bytes, payload) || !add(payload, tail, payload) ||
+            !align(bytes, alignment, bytes) || !add(bytes, payload, bytes)) return false;
+    }
+    return align(bytes, alignment, bytes);
+}
+
+// Reserve the time-sized rolling banks first, then distribute resident slots.
+// Prefill and decode are mutually exclusive, so they share max(prefill, 2 banks).
+static inline plan make_plan(const std::vector<layer> & layers, size_t budget,
+                             size_t prefill_bytes, size_t alignment, size_t tail,
+                             double headroom = 0.9) {
+    plan out;
+    if (layers.empty() || !alignment || !std::isfinite(headroom) ||
+        !(headroom > 0 && headroom <= 1)) return out;
+    out.layers.resize(layers.size());
+    std::vector<size_t> wanted(layers.size());
+    for (size_t i = 0; i < layers.size(); ++i) {
+        const auto & l = layers[i];
+        if (!l.experts || !l.active || l.active > l.experts || l.parts.empty()) return out;
+        for (size_t j = 0; j < i; ++j) if (l.id == layers[j].id) return out;
+        double cost = 0;
+        bool measured = std::isfinite(l.window_ms) && l.window_ms >= 0;
+        for (const auto & p : l.parts) {
+            if (!p.bytes) return out;
+            if (!std::isfinite(p.copy_ms) || p.copy_ms <= 0) measured = false;
+            cost += p.copy_ms;
+        }
+        if (measured && std::isfinite(cost) && cost > 0) {
+            out.layers[i].copy_budget_ms = l.window_ms * headroom;
+            const double count = std::floor(out.layers[i].copy_budget_ms / cost);
+            wanted[i] = count >= (double) l.experts ? l.experts : (size_t) count;
+        }
+    }
+
+    // Integer fractions make the memory search monotone and reproducible.
+    const size_t scale = 1000000;
+    auto evaluate = [&](size_t rolling_fraction, size_t resident_fraction, plan & p) {
+        p.bank_bytes = p.resident_bytes = 0;
+        for (size_t i = 0; i < layers.size(); ++i) {
+            const auto & l = layers[i];
+            auto & a = p.layers[i];
+            size_t scaled = 0;
+            if (!mul(wanted[i], rolling_fraction, scaled)) return false;
+            a.rolling = scaled / scale;
+            if (!mul(l.experts - l.active, resident_fraction, scaled)) return false;
+            a.resident = l.active + scaled / scale;
+            if (!layer_bytes(l, a.rolling, alignment, tail, a.rolling_bytes)) return false;
+            p.bank_bytes = std::max(p.bank_bytes, a.rolling_bytes);
+            size_t bytes = 0;
+            if (!layer_bytes(l, a.resident, alignment, tail, bytes) ||
+                !add(p.resident_bytes, bytes, p.resident_bytes)) return false;
+        }
+        if (!mul(p.bank_bytes, 2, p.staging_bytes)) return false;
+        p.staging_bytes = std::max(p.staging_bytes, prefill_bytes);
+        return add(p.resident_bytes, p.staging_bytes, p.total_bytes) && p.total_bytes <= budget;
+    };
+    if (!evaluate(0, 0, out)) {
+        out.reason = "exact-repair-does-not-fit";
+        return out;
+    }
+    auto search = [&](bool rolling, size_t fixed) {
+        size_t lo = 0, hi = scale;
+        while (lo < hi) {
+            const size_t mid = lo + (hi - lo + 1) / 2;
+            if (evaluate(rolling ? mid : fixed, rolling ? 0 : mid, out)) lo = mid;
+            else hi = mid - 1;
+        }
+        return lo;
+    };
+    const size_t rolling_fraction = search(true, 0);
+    const size_t resident_fraction = search(false, rolling_fraction);
+    if (!evaluate(rolling_fraction, resident_fraction, out)) return out;
+
+    // Equal coverage can strand several whole slots when multiple layers round
+    // up together. Spend that remainder without growing either rolling bank.
+    // Prefer cheaper next slots; binary search bounds work even for large counts.
+    struct refill { size_t index, next_bytes; };
+    std::vector<refill> order;
+    for (size_t i = 0; i < layers.size(); ++i) {
+        if (out.layers[i].resident == layers[i].experts) continue;
+        size_t current = 0, next = 0;
+        if (layer_bytes(layers[i], out.layers[i].resident, alignment, tail, current) &&
+            layer_bytes(layers[i], out.layers[i].resident + 1, alignment, tail, next)) {
+            order.push_back({i, next - current});
+        }
+    }
+    std::sort(order.begin(), order.end(), [](const refill & a, const refill & b) {
+        return a.next_bytes != b.next_bytes ? a.next_bytes < b.next_bytes : a.index < b.index;
+    });
+    // Repair the common fractional rounding before letting one layer use more.
+    for (const auto & entry : order) {
+        if (entry.next_bytes <= budget - out.total_bytes) {
+            ++out.layers[entry.index].resident;
+            out.resident_bytes += entry.next_bytes;
+            out.total_bytes += entry.next_bytes;
+        }
+    }
+    for (const auto & entry : order) {
+        const size_t i = entry.index;
+        auto & a = out.layers[i];
+        const size_t remaining = budget - out.total_bytes;
+        size_t current = 0;
+        if (!layer_bytes(layers[i], a.resident, alignment, tail, current)) return out;
+        size_t lo = a.resident, hi = layers[i].experts;
+        while (lo < hi) {
+            const size_t mid = lo + (hi - lo + 1) / 2;
+            size_t bytes = 0;
+            if (layer_bytes(layers[i], mid, alignment, tail, bytes) && bytes - current <= remaining) lo = mid;
+            else hi = mid - 1;
+        }
+        size_t bytes = 0;
+        if (!layer_bytes(layers[i], lo, alignment, tail, bytes)) return out;
+        a.resident = lo;
+        out.resident_bytes += bytes - current;
+        out.total_bytes += bytes - current;
+    }
+    out.valid = true;
+    out.reason = "ok";
+    return out;
+}
+
+struct candidate {
+    size_t part_index = 0;
+    bool resident = false;
+};
+
+struct admission {
+    std::vector<int> slots;     // -1 means not copied; resident entries consume no slot.
+    size_t bytes = 0;
+    double copy_ms = 0;
+};
+
+static inline admission admit(const layer & l, const allocation & a,
+                               const std::vector<candidate> & candidates) {
+    admission out;
+    out.slots.assign(candidates.size(), -1);
+    std::vector<size_t> used(l.parts.size());
+    if (!std::isfinite(a.copy_budget_ms) || a.copy_budget_ms <= 0) return out;
+    for (size_t i = 0; i < candidates.size(); ++i) {
+        const auto & c = candidates[i];
+        if (c.resident || c.part_index >= l.parts.size()) continue;
+        const auto & p = l.parts[c.part_index];
+        size_t bytes = 0;
+        if (!p.bytes || !std::isfinite(p.copy_ms) || p.copy_ms <= 0 ||
+            used[c.part_index] >= a.rolling || used[c.part_index] > INT32_MAX ||
+            p.copy_ms > a.copy_budget_ms - out.copy_ms || !add(out.bytes, p.bytes, bytes)) continue;
+        out.slots[i] = (int) used[c.part_index]++;
+        out.copy_ms += p.copy_ms;
+        out.bytes = bytes;
+    }
+    return out;
+}
+
+// Event completion comes from the backend. Allocation or submission is not readiness.
+enum class bank_state { free, filling, ready, consuming, retiring };
+struct bank {
+    bank_state state = bank_state::free;
+    uint64_t generation = 0;
+    int layer = -1;
+
+    bool begin(int next_layer) {
+        if (state != bank_state::free || next_layer < 0 || generation == UINT64_MAX) return false;
+        ++generation;
+        layer = next_layer;
+        state = bank_state::filling;
+        return true;
+    }
+    bool complete(uint64_t ticket) {
+        if (ticket != generation || state != bank_state::filling) return false;
+        state = bank_state::ready;
+        return true;
+    }
+    bool consume(int target, uint64_t ticket) {
+        if (ticket != generation || target != layer || state != bank_state::ready) return false;
+        state = bank_state::consuming;
+        return true;
+    }
+    bool retire() {
+        if (state != bank_state::consuming && state != bank_state::ready && state != bank_state::filling) return false;
+        state = bank_state::retiring;
+        return true;
+    }
+    bool release(uint64_t ticket, bool readers_done) {
+        if (ticket != generation || !readers_done || state != bank_state::retiring) return false;
+        state = bank_state::free;
+        layer = -1;
+        return true;
+    }
+};
+
+} // namespace ggml_moe_schedule
diff --git a/ggml/src/ggml-moe-schedule-runtime.h b/ggml/src/ggml-moe-schedule-runtime.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-moe-schedule-runtime.h
@@ -0,0 +1,219 @@
+#pragma once
+
+static bool sched_moe_pool_order(const sched_moe_pool * a, const sched_moe_pool * b) {
+    const auto priority = [](const char * name) {
+        if (strstr(name, ".ffn_gate_exps") || strstr(name, ".ffn_gate_up_exps")) return 0;
+        if (strstr(name, ".ffn_up_exps")) return 1;
+        if (strstr(name, ".ffn_down_exps")) return 2;
+        return 3;
+    };
+    const int pa = priority(a->pool.name), pb = priority(b->pool.name);
+    return pa != pb ? pa < pb : strcmp(a->pool.name, b->pool.name) < 0;
+}
+
+static sched_moe_schedule_sample * sched_moe_schedule_begin(ggml_backend_sched_t sched,
+        int backend_id, ggml_backend_t stream, const sched_moe_pool * pool = nullptr) {
+    if (!sched->moe || !sched->moe->schedule || !sched->moe->timing.active) return nullptr;
+    auto & tm = sched->moe->timing;
+    if (!tm.event_new[backend_id] || tm.source[backend_id] < 0) return nullptr;
+    const size_t index = tm.sample_count++;
+    if (index == tm.samples.size()) tm.samples.emplace_back();
+    auto & s = tm.samples[index];
+    if (s.backend_id != backend_id) {
+        if (s.begin) ggml_backend_event_free(s.begin);
+        if (s.end) ggml_backend_event_free(s.end);
+        s.begin = s.end = nullptr;
+    }
+    if (!s.begin) {
+        const auto dev = ggml_backend_get_device(stream);
+        s.begin = tm.event_new[backend_id](dev);
+        s.end = tm.event_new[backend_id](dev);
+    }
+    s.backend_id = backend_id;
+    s.source = tm.source[backend_id];
+    s.copy_key = pool ? pool->copy_key : "";
+    s.count = 0;
+    ggml_backend_event_record(s.begin, stream);
+    return &s;
+}
+
+static void sched_moe_schedule_end(sched_moe_schedule_sample * s, ggml_backend_t stream, size_t count = 0) {
+    if (!s) return;
+    s->count = count;
+    ggml_backend_event_record(s->end, stream);
+}
+
+static bool sched_moe_schedule_samples_done(const sched_moe_timing & tm) {
+    for (size_t i = 0; i < tm.sample_count; ++i) {
+        const auto & s = tm.samples[i];
+        if (tm.elapsed[s.backend_id](s.begin, s.end) < 0) return false;
+    }
+    return true;
+}
+
+static void sched_moe_schedule_learn(ggml_backend_sched_t sched) {
+    auto & st = *sched->moe;
+    auto & tm = st.timing;
+    if (!st.schedule || !tm.successful) return;
+    // Active samples are always no-prediction-copy controls. Never turn a miss stall into credit.
+    for (size_t i = 0; i < tm.sample_count; ++i) {
+        const auto & s = tm.samples[i];
+        if (!s.copy_key.empty() && s.count) {
+            const double ms = tm.elapsed[s.backend_id](s.begin, s.end);
+            if (ms > 0) st.devices[s.backend_id].copies[s.copy_key].push(ms / s.count);
+        }
+    }
+    if (tm.graph <= 8) return; // Cache-cold copies are useful; cold graph execution is not overlap credit.
+    bool measured = false;
+    for (const auto & kv : tm.records) {
+        const auto & r = kv.second;
+        const auto target = tm.records.find(r.target);
+        if (!r.route_set || !r.ready_set || !r.start_set || target == tm.records.end()) continue;
+        const auto & t = target->second;
+        if (!t.route_set || t.backend_id != r.backend_id) continue;
+        const auto elapsed = tm.elapsed[r.backend_id];
+        const double open = std::max(elapsed(r.route, r.ready), elapsed(r.route, r.start));
+        const double deadline = elapsed(r.route, t.route);
+        if (open < 0 || deadline < open) continue;
+        double compute = 0;
+        for (size_t i = 0; i < tm.sample_count; ++i) {
+            const auto & s = tm.samples[i];
+            if (!s.copy_key.empty() || s.backend_id != r.backend_id || s.source != r.layer) continue;
+            const double begin = elapsed(r.route, s.begin), end = elapsed(r.route, s.end);
+            if (begin < 0 || end < begin) continue;
+            compute += std::max(0.0, std::min(end, deadline) - std::max(begin, open));
+        }
+        st.devices[r.backend_id].windows[r.target].push(compute);
+        measured = true;
+    }
+    if (measured && ++tm.clean_samples % 8 == 0) st.schedule_replan = true;
+}
+
+static void sched_moe_schedule_apply(ggml_backend_sched_t sched) {
+    auto & st = *sched->moe;
+    if (!st.schedule || !st.schedule_replan || st.pools.size() != st.weights.size()) return;
+    st.schedule_replan = false;
+    for (int b = 0; b < sched->n_backends; ++b) {
+        auto & d = st.devices[b];
+        if (!d.staging || !st.timing.event_new[b]) continue;
+        std::vector<sched_moe_pool *> pools;
+        for (auto & kv : st.pools) if (kv.second && kv.second->backend_id == b) pools.push_back(kv.second.get());
+        if (pools.empty()) continue;
+        std::sort(pools.begin(), pools.end(), [](const sched_moe_pool * a, const sched_moe_pool * c) {
+            return a->layer != c->layer ? a->layer < c->layer : sched_moe_pool_order(a, c);
+        });
+        size_t owned = ggml_backend_buffer_get_size(d.staging);
+        std::vector<ggml_moe_schedule::layer> geometry;
+        bool valid = true;
+        for (const auto * p : pools) {
+            if (p->layer < 0 || p->n_expert <= 0 || p->n_expert > INT_MAX ||
+                !ggml_moe_schedule::add(owned, ggml_backend_buffer_get_size(p->buf), owned)) {
+                valid = false;
+                break;
+            }
+            if (geometry.empty() || geometry.back().id != p->layer) {
+                ggml_moe_schedule::layer l;
+                l.id = p->layer;
+                l.experts = (size_t) p->n_expert;
+                l.window_ms = d.windows[l.id].quantile(.1);
+                geometry.push_back(l);
+            }
+            auto & l = geometry.back();
+            if (l.experts != (size_t) p->n_expert) { valid = false; break; }
+            l.active = std::max(l.active, p->active_experts);
+            l.parts.push_back({p->expert_size, d.copies[p->copy_key].quantile(.9)});
+        }
+        if (!valid) {
+            GGML_LOG_WARN("moe-schedule: device=%d incompatible expert geometry; retaining the exact-copy cache\n", b);
+            continue;
+        }
+        if (!d.budget_bytes) d.budget_bytes = owned;
+        size_t free = 0, total = 0;
+        ggml_backend_dev_memory(ggml_backend_get_device(sched->backends[b]), &free, &total);
+        const size_t reserve = 512ull << 20;
+        size_t available = owned;
+        if (free < reserve) available = owned > reserve - free ? owned - (reserve - free) : 0;
+        else if (!ggml_moe_schedule::add(owned, free - reserve, available)) available = SIZE_MAX;
+        const size_t budget = std::min(d.budget_bytes, available);
+        const size_t alignment = ggml_backend_buft_get_alignment(sched->bufts[b]);
+        auto plan = ggml_moe_schedule::make_plan(geometry, budget, d.max_weight_bytes + 512, alignment, 512);
+        if (!plan.valid) {
+            GGML_LOG_WARN("moe-schedule: device=%d no safe repartition (%s, budget=%zu); no new allocation\n", b, plan.reason, budget);
+            continue;
+        }
+        bool changed = plan.bank_bytes != d.bank_bytes;
+        size_t li = 0;
+        for (const auto * p : pools) {
+            while (geometry[li].id != p->layer) ++li;
+            changed = changed || (size_t) p->cap != plan.layers[li].resident;
+        }
+        if (changed) {
+            // Pool tensors are stable objects outside gallocr. Do not re-split or invalidate caller inputs.
+            ggml_backend_synchronize(sched->backends[b]);
+            if (st.prefetch_backend[b]) ggml_backend_synchronize(st.prefetch_backend[b]);
+            for (auto & r : d.rolling) {
+                r.layer = r.backend_id = -1;
+                r.segments.clear();
+                if (r.lifetime.state != ggml_moe_schedule::bank_state::free) {
+                    r.lifetime.retire();
+                    GGML_ASSERT(r.lifetime.release(r.lifetime.generation, true));
+                }
+            }
+            // Release old allocations first: old + new pools must not coexist above the VRAM budget.
+            for (auto * p : pools) {
+                ggml_backend_buffer_free(p->buf);
+                p->buf = nullptr;
+                p->pool.buffer = nullptr;
+                p->pool.data = nullptr;
+                p->staging.buffer = nullptr;
+                p->staging.data = nullptr;
+            }
+            ggml_backend_buffer_free(d.staging);
+            d.staging = ggml_backend_buft_alloc_buffer(sched->bufts[b], plan.staging_bytes);
+            if (!d.staging) GGML_ABORT("moe-schedule: device %d cannot allocate %zu staging bytes", b, plan.staging_bytes);
+            ggml_backend_buffer_clear(d.staging, 0);
+            li = 0;
+            for (auto * p : pools) {
+                while (geometry[li].id != p->layer) ++li;
+                p->cap = (int) plan.layers[li].resident;
+                const size_t bytes = (size_t) p->cap * p->expert_size + 512;
+                p->buf = ggml_backend_buft_alloc_buffer(sched->bufts[b], bytes);
+                if (!p->buf) GGML_ABORT("moe-schedule: device %d cannot allocate %zu bytes for %s", b, bytes, p->pool.name);
+                ggml_backend_buffer_clear(p->buf, 0);
+                p->pool.ne[2] = p->cap;
+                ggml_backend_tensor_alloc(p->buf, &p->pool, ggml_backend_buffer_get_base(p->buf));
+                p->where.clear();
+                p->slot_expert.assign(p->cap, -1);
+                p->slot_last.assign(p->cap, 0);
+                p->slot_pin.assign(p->cap, 0);
+                p->slot_hot.assign(p->cap, 0);
+                p->tick = p->served_seq = 0;
+                p->ev_pending = false;
+            }
+            // Backend graph caches may skip pointer checks for an unchanged uid.
+            for (int i = 0; i < sched->n_splits; ++i) {
+                if (sched->splits[i].backend_id == b) sched->splits[i].graph.uid = ggml_graph_next_uid();
+            }
+            ++st.schedule_epoch;
+        }
+        d.bank_bytes = plan.bank_bytes;
+        d.plan = std::move(plan);
+        d.geometry = std::move(geometry);
+        fprintf(stderr, "moe-schedule: device=%d epoch=%llu budget=%zu total=%zu resident=%zu staging=%zu bank=%zu changed=%d ready=%llu pending=%llu no-bank=%llu\n",
+                b, (unsigned long long) st.schedule_epoch, budget, d.plan.total_bytes, d.plan.resident_bytes,
+                d.plan.staging_bytes, d.bank_bytes, (int) changed, (unsigned long long) d.ready_hits,
+                (unsigned long long) d.pending_hits, (unsigned long long) d.no_bank);
+        for (size_t i = 0; i < d.geometry.size(); ++i) {
+            double copy_ms = 0;
+            for (const auto & part : d.geometry[i].parts) copy_ms += part.copy_ms;
+            fprintf(stderr, "moe-schedule-layer: device=%d layer=%d experts=%zu active=%zu resident=%zu rolling=%zu window-p10-ms=%.6f part-sum-p90-ms=%.6f budget-ms=%.6f\n",
+                    b, d.geometry[i].id, d.geometry[i].experts, d.geometry[i].active, d.plan.layers[i].resident,
+                    d.plan.layers[i].rolling, d.geometry[i].window_ms, copy_ms, d.plan.layers[i].copy_budget_ms);
+        }
+    }
+}
+
+static sched_moe_rolling * sched_moe_schedule_rolling(ggml_backend_sched_t sched, int backend, int layer) {
+    for (auto & r : sched->moe->devices[backend].rolling) if (r.layer == layer) return &r;
+    return nullptr;
+}
