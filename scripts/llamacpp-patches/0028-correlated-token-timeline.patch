Subject: [PATCH] Add opt-in correlated CPU, RPC and CUDA timeline scopes

No collector is loaded unless ITC_TIMELINE_LIBRARY is explicitly set. The
external diagnostic library records activity; these hooks neither synchronize
the GPU nor alter graph, transport or cache decisions. RPC sequence counters
are local-only and add no protocol bytes. Token markers contain task/ordinal
identifiers, not token values or text.

diff --git a/ggml/include/ggml-timeline.h b/ggml/include/ggml-timeline.h
new file mode 100644
index 0000000..6d922c2
--- /dev/null
+++ b/ggml/include/ggml-timeline.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace ggml_timeline {
+struct functions {
+    using begin_fn = uint64_t (*)(const char *, const char *, int64_t, int64_t);
+    using end_fn = void (*)(uint64_t);
+    begin_fn begin = nullptr;
+    end_fn end = nullptr;
+    functions() {
+#ifdef _WIN32
+        const char * path = std::getenv("ITC_TIMELINE_LIBRARY");
+        if (!path || !*path) return;
+        const HMODULE library = LoadLibraryExA(path, nullptr, LOAD_WITH_ALTERED_SEARCH_PATH);
+        const auto init = library ? reinterpret_cast<int (*)()>(GetProcAddress(library, "itc_trace_initialize")) : nullptr;
+        begin = library ? reinterpret_cast<begin_fn>(GetProcAddress(library, "itc_trace_begin")) : nullptr;
+        end = library ? reinterpret_cast<end_fn>(GetProcAddress(library, "itc_trace_end")) : nullptr;
+        if (!init || !begin || !end || init() != 1) {
+            std::fprintf(stderr, "timeline: requested diagnostic collector could not start\n");
+            std::abort();
+        }
+#endif
+    }
+};
+inline const functions & api() { static const functions instance; return instance; }
+struct scope {
+    uint64_t id;
+    scope(const char * name, const char * detail = "", int64_t a = 0, int64_t b = 0)
+        : id(api().begin ? api().begin(name, detail, a, b) : 0) {}
+    ~scope() { if (id) api().end(id); }
+    scope(const scope &) = delete;
+    scope & operator=(const scope &) = delete;
+};
+}
