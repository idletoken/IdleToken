+static bool rpc_is_constant_graph_input(const char * name) {
+    if (name == nullptr || name[0] == '\0') {
+        return false;
+    }
+    // The KV-cache rotation input is a Hadamard matrix selected only by its
+    // dimensions. llama_kv_cache::set_input_k_rot() copies the same matrix on
+    // every graph invocation, while graph execution only reads it. RPC tensor
+    // names may carry a scheduler prefix, hence the delimited substring test.
+    return strcmp(name, "attn_inp_k_rot") == 0 ||
+           strstr(name, "#attn_inp_k_rot#") != nullptr;
+}
+
+static bool rpc_constant_input_cache_enabled() {
+    const char * value = std::getenv("GGML_MOE_RPC_CONSTANT_INPUT_CACHE");
+    return value == nullptr || strcmp(value, "0") != 0;
+}
