+static bool read_cached_file(const fs::path & cache_file, std::vector<uint8_t> & data) {
+    std::error_code ec;
+    const uintmax_t raw_size = fs::file_size(cache_file, ec);
+    if (ec || raw_size > SIZE_MAX) {
+        return false;
+    }
+
+    const size_t size = (size_t) raw_size;
+    data.resize(size);
+#ifdef _WIN32
+    // MSVC's std::ifstream path degenerates into 4 KiB paging reads for these
+    // 500-700 MiB tensor files.  On an otherwise healthy NVMe that measured
+    // only ~18 MiB/s and dominated a DSv4 cluster start.  _O_SEQUENTIAL plus
+    // explicit multi-MiB reads reaches the storage stack as sequential I/O.
+    const int fd = _wopen(cache_file.c_str(), _O_RDONLY | _O_BINARY | _O_SEQUENTIAL);
+#else
+    const int fd = open(cache_file.c_str(), O_RDONLY);
+#endif
+    if (fd < 0) {
+        data.clear();
+        return false;
+    }
+
+    size_t done = 0;
+    while (done < size) {
+        const size_t left = size - done;
+        const unsigned chunk = (unsigned) std::min<size_t>(left, 8U << 20);
+#ifdef _WIN32
+        const int n = _read(fd, data.data() + done, chunk);
+#else
+        const ssize_t n = read(fd, data.data() + done, chunk);
+#endif
+        if (n <= 0) {
+            break;
+        }
+        done += (size_t) n;
+    }
+#ifdef _WIN32
+    _close(fd);
+#else
+    close(fd);
+#endif
+    if (done != size) {
+        data.clear();
+        return false;
+    }
+    return true;
+}
