+// Sample CUDA timestamps without adding any waits to the layer loop. The
+// source route event anchors both streams on one device clock. Read records
+// only at the caller's existing graph synchronization (or a later graph if
+// speculative work is still pending). A no-copy run measures the unperturbed
+// opportunity window with the same predictor and exact-copy scheduling.
+static void sched_moe_timing_collect(ggml_backend_sched_t sched) {
+    if (!sched->moe || !sched->moe->timing.pending) return;
+    auto & tm = sched->moe->timing;
+    for (const auto & kv : tm.records) {
+        const auto & r = kv.second;
+        auto elapsed = r.backend_id >= 0 ? tm.elapsed[r.backend_id] : nullptr;
+        if (!r.route_set || !elapsed) continue;
+        if (elapsed(r.route, r.route) < 0 ||
+            (r.ready_set && elapsed(r.ready, r.ready) < 0) ||
+            (r.start_set && elapsed(r.start, r.start) < 0) ||
+            (r.done_set && elapsed(r.done, r.done) < 0)) return;
+    }
+    if (!tm.primed) {
+        tm.primed = true; // exclude the sample that allocated CUDA events
+        tm.pending = tm.active = false;
+        return;
+    }
+    for (const auto & kv : tm.records) {
+        const auto & r = kv.second;
+        const auto ti = tm.records.find(r.target);
+        if (!r.route_set || !r.ready_set || !r.start_set || !r.done_set || ti == tm.records.end()) continue;
+        const auto & t = ti->second;
+        if (!t.route_set || !t.ready_set || t.backend_id != r.backend_id) continue;
+        const auto elapsed = tm.elapsed[r.backend_id];
+        const double ready = elapsed(r.route, r.ready);
+        const double start = elapsed(r.route, r.start);
+        const double done = elapsed(r.route, r.done);
+        const double target_route = elapsed(r.route, t.route);
+        const double target_ready = elapsed(r.route, t.ready);
+        if (ready < 0 || start < 0 || done < 0 || target_route < 0 || target_ready < 0) {
+            fprintf(stderr, "moe-window-invalid scheduler=%p graph=%llu source=%d target=%d\n",
+                    (void *) sched, (unsigned long long) tm.graph, r.layer, r.target);
+            continue;
+        }
+        fprintf(stderr,
+            "moe-window scheduler=%p graph=%llu device=%d source=%d target=%d mode=%s"
+            " route_ready_ms=%.6f copy_start_ms=%.6f copy_done_ms=%.6f target_route_ms=%.6f target_ready_ms=%.6f"
+            " window_ms=%.6f queue_ms=%.6f copy_ms=%.6f spill_ms=%.6f submit_ms=%.6f planned_bytes=%zu copied_bytes=%zu\n",
+            (void *) sched, (unsigned long long) tm.graph, r.backend_id, r.layer, r.target,
+            sched->moe->pregate_no_prefetch ? "no-copy" : "copy",
+            ready, start, done, target_route, target_ready,
+            target_ready - start, start - ready, done - start, std::max(0.0, done - target_ready),
+            r.submit_ms, r.planned_bytes, r.copied_bytes);
+        if (!t.ranks.empty()) {
+            fprintf(stderr, "moe-ranks scheduler=%p graph=%llu layer=%d ranks=",
+                    (void *) sched, (unsigned long long) tm.graph, t.layer);
+            for (size_t i = 0; i < t.ranks.size(); i++) fprintf(stderr, "%s%d", i ? "," : "", t.ranks[i]);
+            fprintf(stderr, "\n");
+        }
+    }
+    tm.pending = false;
+    tm.active = false;
+}
