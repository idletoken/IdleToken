+static sched_moe_timing_record * sched_moe_timing_route(ggml_backend_sched_t sched, int layer,
+                                                       ggml_backend_t backend) {
+    if (!sched->moe || !sched->moe->timing.active || layer < 0) return nullptr;
+    auto & tm = sched->moe->timing;
+    int b = -1;
+    for (int i = 0; i < sched->n_backends; i++) {
+        if (sched->backends[i] == backend) { b = i; break; }
+    }
+    if (b < 0) return nullptr;
+    if (!tm.initialized[b]) {
+        tm.initialized[b] = true;
+        const auto dev = ggml_backend_get_device(backend);
+        const auto reg = dev ? ggml_backend_dev_backend_reg(dev) : nullptr;
+        if (reg) {
+            tm.event_new[b] = (sched_moe_timing_event_new_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_timing_event_new");
+            tm.elapsed[b] = (sched_moe_timing_event_elapsed_fn) ggml_backend_reg_get_proc_address(reg, "ggml_backend_cuda_timing_event_elapsed_ms");
+        }
+    }
+    if (!tm.event_new[b] || !tm.elapsed[b]) return nullptr;
+    auto & r = tm.records[layer];
+    if (r.route_set) return nullptr; // exactly one record per layer and graph
+    if (!r.route) {
+        const auto dev = ggml_backend_get_device(backend);
+        r.route = tm.event_new[b](dev);
+        r.ready = tm.event_new[b](dev);
+        r.start = tm.event_new[b](dev);
+        r.done = tm.event_new[b](dev);
+        r.backend_id = b;
+    }
+    if (r.backend_id != b) return nullptr;
+    r.layer = layer;
+    r.route_set = true;
+    ggml_backend_event_record(r.route, backend);
+    return &r;
+}
+
+static sched_moe_timing_record * sched_moe_timing_copy_begin(ggml_backend_sched_t sched,
+        int source, int target, ggml_backend_t pf) {
+    auto & tm = sched->moe->timing;
+    if (!tm.active) return nullptr;
+    const auto it = tm.records.find(source);
+    if (it == tm.records.end() || !it->second.ready_set) return nullptr;
+    auto & r = it->second;
+    if (ggml_backend_get_device(pf) != ggml_backend_get_device(sched->backends[r.backend_id])) return nullptr;
+    r.target = target;
+    r.start_set = true;
+    ggml_backend_event_record(r.start, pf);
+    return &r;
+}
