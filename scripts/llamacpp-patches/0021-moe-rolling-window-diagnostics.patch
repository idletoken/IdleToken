+        [&](const sched_moe_rolling_segment & seg) { return seg.pool == p; });
+    if (found == rolling.segments.end()) {
+        return 0;
+    }
+    ggml_backend_t pf = st.prefetch_backend[p->backend_id];
+    if (pf == nullptr) {
+        return 0;
+    }
+    const uint64_t next_tick = p->tick + 1;
+    int promoted = 0;
+    for (int64_t e = 0; e < n_expert_total; e++) {
+        if (!ggml_bitset_get(used_ids.data(), e) || p->where.count((int32_t) e)) {
+            continue;
+        }
+        const auto predicted = found->where.find((int32_t) e);
+        if (predicted == found->where.end()) {
+            continue;
+        }
+        int slot = -1;
+        uint64_t oldest = UINT64_MAX;
+        for (int s = 0; s < p->cap; s++) {
