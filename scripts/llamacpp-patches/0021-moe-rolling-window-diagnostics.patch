+// Promote exact experts found in the rolling area into a layer's persistent
+// pool using device-to-device copies on the prefetch stream. The caller pins
+// the destination slots for the coming serve, so neither exact sibling issue
+// nor an unrelated prediction can evict them before MUL_MAT_ID consumes them.
+static int sched_moe_rolling_promote(ggml_backend_sched_t sched, sched_moe_pool * p,
+                                     const std::vector<ggml_bitset_t> & used_ids,
+                                     int64_t n_expert_total) {
+    auto & st = *sched->moe;
