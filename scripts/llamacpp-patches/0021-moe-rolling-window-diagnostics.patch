+static int sched_moe_rank_threshold(const std::vector<uint64_t> & hist, uint64_t total, double fraction) {
+    if (total == 0) {
+        return -1;
+    }
+    uint64_t cumulative = 0;
+    for (size_t rank = 1; rank < hist.size(); rank++) {
+        cumulative += hist[rank];
+        if ((double) cumulative / (double) total >= fraction) {
+            return (int) rank;
+        }
+    }
+    return (int) hist.size() - 1;
+}
+
+static double sched_moe_rank_recall(const std::vector<uint64_t> & hist, uint64_t total, int n) {
+    if (total == 0 || hist.size() <= 1) {
+        return 0.0;
+    }
+    uint64_t cumulative = 0;
+    const size_t end = std::min<size_t>((size_t) std::max(0, n), hist.size() - 1);
+    for (size_t rank = 1; rank <= end; rank++) {
+        cumulative += hist[rank];
+    }
+    return 100.0 * (double) cumulative / (double) total;
+}
