+            p->where.erase(p->slot_expert[slot]);
+        }
+        p->slot_expert[slot] = (int32_t) e;
+        p->slot_last[slot] = next_tick;
+        p->slot_pin[slot] = next_tick;
+        p->where[(int32_t) e] = slot;
