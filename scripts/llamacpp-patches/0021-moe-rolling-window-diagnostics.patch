+// Compare the previous layer's complete 256-way prediction ranking with this
+// layer's exact routed experts. `input` is the first expert weight split, so
+// its pool contents are also the cache state before any rolling promotion or
+// exact repair for this layer. The diagnostic therefore reports both raw
+// predictor recall and the recall on experts the persistent pool actually
+// missed.
+static void sched_moe_pregate_observe(ggml_backend_sched_t sched, const struct ggml_tensor * input,
+                                      const std::vector<ggml_bitset_t> & used_ids, int64_t n_expert_total) {
+    auto & st = *sched->moe;
+    const int layer = sched_moe_layer_of(input->name);
+    if (st.pregate_stats_every <= 0 || layer != st.pregate_stats_target_layer ||
+        n_expert_total != st.pregate_stats_n_expert || st.pregate_rank.size() != (size_t) n_expert_total) {
+        return;
+    }
+
+    sched_moe_pool * p = nullptr;
+    auto pool_it = st.pools.find(input->name);
+    if (pool_it != st.pools.end()) {
+        p = pool_it->second.get();
+    }
+
+    int max_rank = 0;
+    int max_miss_rank = 0;
+    int n_missing = 0;
+    auto timing_it = st.timing.records.find(layer);
+    for (int64_t e = 0; e < n_expert_total; e++) {
+        if (!ggml_bitset_get(used_ids.data(), e)) {
+            continue;
+        }
+        const int rank = st.pregate_rank[(size_t) e];
+        if (rank <= 0 || rank > n_expert_total) {
+            continue;
+        }
+        st.pregate_stats_selected++;
+        if (st.timing.active && timing_it != st.timing.records.end()) {
+            timing_it->second.ranks.push_back(rank);
+        }
+        st.pregate_rank_hist[(size_t) rank]++;
+        max_rank = std::max(max_rank, rank);
+        if (p == nullptr || !p->where.count((int32_t) e)) {
+            st.pregate_stats_missing++;
+            st.pregate_miss_rank_hist[(size_t) rank]++;
+            max_miss_rank = std::max(max_miss_rank, rank);
+            n_missing++;
+        }
+    }
+    if (max_rank <= 0) {
+        return;
+    }
+    st.pregate_stats_samples++;
+    st.pregate_max_rank_hist[(size_t) max_rank]++;
+    if (n_missing == 0) {
+        st.pregate_stats_no_missing++;
+    } else {
+        st.pregate_stats_missing_samples++;
+        st.pregate_miss_max_rank_hist[(size_t) max_miss_rank]++;
+    }
+    st.pregate_stats_target_layer = -1;
+
+    if (st.pregate_stats_samples % (uint64_t) st.pregate_stats_every != 0) {
+        return;
+    }
+    const auto threshold = [](const std::vector<uint64_t> & hist, uint64_t total, double p) {
+        return sched_moe_rank_threshold(hist, total, p);
+    };
+    fprintf(stderr,
+        "moe-pregate-stats layers=%llu selected=%llu cache-missing=%llu cache-full=%.2f%%"
+        " | selected N90/95/99=%d/%d/%d R@12/20/24/30/32/48/64=%.2f/%.2f/%.2f/%.2f/%.2f/%.2f/%.2f%%"
+        " | layer-full N90/95/99=%d/%d/%d F@20/30/48/64=%.2f/%.2f/%.2f/%.2f%%"
+        " | missing N90/95/99=%d/%d/%d MR@20/30/48/64=%.2f/%.2f/%.2f/%.2f%%"
+        " | missing-layer-full samples=%llu N90/95/99=%d/%d/%d\n",
+        (unsigned long long) st.pregate_stats_samples,
+        (unsigned long long) st.pregate_stats_selected,
+        (unsigned long long) st.pregate_stats_missing,
+        100.0 * (double) st.pregate_stats_no_missing / (double) st.pregate_stats_samples,
+        threshold(st.pregate_rank_hist, st.pregate_stats_selected, 0.90),
+        threshold(st.pregate_rank_hist, st.pregate_stats_selected, 0.95),
+        threshold(st.pregate_rank_hist, st.pregate_stats_selected, 0.99),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 12),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 20),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 24),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 30),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 32),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 48),
+        sched_moe_rank_recall(st.pregate_rank_hist, st.pregate_stats_selected, 64),
+        threshold(st.pregate_max_rank_hist, st.pregate_stats_samples, 0.90),
+        threshold(st.pregate_max_rank_hist, st.pregate_stats_samples, 0.95),
+        threshold(st.pregate_max_rank_hist, st.pregate_stats_samples, 0.99),
+        sched_moe_rank_recall(st.pregate_max_rank_hist, st.pregate_stats_samples, 20),
+        sched_moe_rank_recall(st.pregate_max_rank_hist, st.pregate_stats_samples, 30),
+        sched_moe_rank_recall(st.pregate_max_rank_hist, st.pregate_stats_samples, 48),
+        sched_moe_rank_recall(st.pregate_max_rank_hist, st.pregate_stats_samples, 64),
+        threshold(st.pregate_miss_rank_hist, st.pregate_stats_missing, 0.90),
+        threshold(st.pregate_miss_rank_hist, st.pregate_stats_missing, 0.95),
+        threshold(st.pregate_miss_rank_hist, st.pregate_stats_missing, 0.99),
+        sched_moe_rank_recall(st.pregate_miss_rank_hist, st.pregate_stats_missing, 20),
+        sched_moe_rank_recall(st.pregate_miss_rank_hist, st.pregate_stats_missing, 30),
+        sched_moe_rank_recall(st.pregate_miss_rank_hist, st.pregate_stats_missing, 48),
+        sched_moe_rank_recall(st.pregate_miss_rank_hist, st.pregate_stats_missing, 64),
+        (unsigned long long) st.pregate_stats_missing_samples,
+        threshold(st.pregate_miss_max_rank_hist, st.pregate_stats_missing_samples, 0.90),
+        threshold(st.pregate_miss_max_rank_hist, st.pregate_stats_missing_samples, 0.95),
+        threshold(st.pregate_miss_max_rank_hist, st.pregate_stats_missing_samples, 0.99));
+}
