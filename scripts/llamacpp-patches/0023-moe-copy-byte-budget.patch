--- /dev/null
+++ b/ggml/src/ggml-moe-copy-budget.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+// Candidates are already in prediction-rank / consumption order. Zero means
+// resident (no transfer). Each weight tensor is an independent repair unit:
+// a partial expert prediction can still save that tensor's exact H2D copy.
+// This only admits work under a measured byte ceiling; it estimates neither
+// bandwidth nor a latency window, and does not change cache residency.
+static inline std::vector<uint8_t> ggml_moe_copy_budget_pick(
+        const std::vector<size_t> & bytes, size_t limit) {
+    std::vector<uint8_t> selected(bytes.size(), 0);
+    size_t remaining = limit;
+    for (size_t i = 0; i < bytes.size(); i++) {
+        if (bytes[i] != 0 && bytes[i] <= remaining) {
+            selected[i] = 1;
+            remaining -= bytes[i];
+        }
+    }
+    return selected;
+}
