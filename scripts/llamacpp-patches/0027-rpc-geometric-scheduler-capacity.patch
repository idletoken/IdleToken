--- /dev/null
+++ b/ggml/src/ggml-rpc/rpc-graph-capacity.h
@@ -0,0 +1,20 @@
+#pragma once
+#include <cstddef>
+#include <limits>
+
+// Round scheduler metadata capacity geometrically. Recreating a scheduler
+// drops its expert pools, so small changes in otherwise recurring graphs
+// must not grow capacity one node at a time. This reserves host metadata,
+// not a second GPU graph workspace. Zero means the requested size overflows.
+inline size_t rpc_scheduler_graph_capacity(size_t nodes) {
+    const size_t limit = std::numeric_limits<size_t>::max();
+    if (nodes > (limit - 4096) / 4) return 0;
+    const size_t scaled = nodes * 4;
+    const size_t required = (scaled < 16384 ? 16384 : scaled) + 4096;
+    size_t capacity = 32768;
+    while (capacity < required) {
+        if (capacity > limit / 2) return 0;
+        capacity *= 2;
+    }
+    return capacity;
+}
