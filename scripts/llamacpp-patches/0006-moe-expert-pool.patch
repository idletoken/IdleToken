+// server that also has a GPU hands out the GPU's pinned host buffers: the CPU
+// backend computes on them as before, and the copies the scheduler makes from
+// them to the GPU (expert pool misses, prefill staging) run asynchronously at
+// full PCIe speed instead of through pageable-memory staging.
+ggml_backend_buffer_type_t rpc_server::device_buft(uint32_t dev_id) {
+    ggml_backend_buffer_type_t buft = ggml_backend_get_default_buffer_type(backends[dev_id]);
+    ggml_backend_dev_t dev = ggml_backend_get_device(backends[dev_id]);
+    static const bool pinned_off = std::getenv("GGML_RPC_NO_PINNED_CPU") != nullptr;
+    if (pinned_off || dev == nullptr || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        return buft;
+    }
+    for (size_t i = 0; i < backends.size(); i++) {
+        ggml_backend_dev_t gdev = ggml_backend_get_device(backends[i]);
+        if (gdev == nullptr || ggml_backend_dev_type(gdev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        ggml_backend_buffer_type_t host = ggml_backend_dev_host_buffer_type(gdev);
+        if (host != nullptr) {
+            return host;
+        }
+    }
+    return buft;
+}
+
+ggml_status rpc_server::compute(uint32_t device, ggml_cgraph * graph) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backends[device]);
+    const bool server_sched = ggml_backend_rpc_node_local_mode() == 2 && backends.size() > 1 &&
+        dev != nullptr && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU &&
+        ggml_backend_dev_type(ggml_backend_get_device(backends.back())) == GGML_BACKEND_DEVICE_TYPE_CPU;
+    if (!server_sched) {
+        return ggml_backend_graph_compute(backends[device], graph);
+    }
+    const size_t need = (size_t) graph->n_nodes * 2 + 1024;
+    if (sched == nullptr || sched_graph_size < need) {
+        if (sched) {
+            ggml_backend_sched_free(sched);
+        }
+        std::vector<ggml_backend_buffer_type_t> bufts;
+        for (size_t i = 0; i < backends.size(); i++) {
+            bufts.push_back(device_buft((uint32_t) i));
+        }
+        sched_graph_size = need;
+        sched = ggml_backend_sched_new(backends.data(), bufts.data(), (int) backends.size(), sched_graph_size, false, true);
+        GGML_ASSERT(sched != nullptr);
+    }
+    // The wire protocol carries no buffer usage, so every server-side buffer is
+    // USAGE_ANY and the scheduler would keep host-resident experts on the CPU
+    // (its expert pool and prefill offload both key off USAGE_WEIGHTS). A leaf
+    // in a host buffer that MUL_MAT_ID reads as src[0] is an expert weight; mark
+    // its buffer the way the client did. Buffers persist, so this is one-time.
+    ggml_backend_sched_reset(sched);
+    // The deserialized graph has nodes only (n_leafs == 0), so the scheduler
+    // would never assign the weights and inputs from their buffers; its pass 4
+    // hands every leaf the backend of the op that reads it, and a CPU-buffer
+    // expert weight then "lives" on the GPU: no input copy, no pool, the kernel
+    // reads a host pointer (unified memory hides it, pinned memory makes it slow,
+    // pageable memory faults). The scheduler assigns them by buffer type here,
+    // after putting back any pool redirection left by the previous compute of
+    // the same graph (GRAPH_RECOMPUTE re-submits the stored graph).
+    ggml_backend_sched_assign_leaves(sched, graph);
+    // The wire protocol carries no buffer usage, so every server-side buffer is
+    // USAGE_ANY and the scheduler would keep host-resident experts on the CPU
+    // (its expert pool and prefill offload both key off USAGE_WEIGHTS). A leaf
+    // in a host buffer that MUL_MAT_ID reads as src[0] is an expert weight; mark
+    // its buffer the way the client did. Buffers persist, so this is one-time.
+    static bool debug_once = std::getenv("GGML_RPC_DEBUG_MOE") != nullptr;
+    for (int i = 0; i < graph->n_nodes; i++) {
+        const ggml_tensor * node = graph->nodes[i];
+        ggml_tensor * w = node->src[0];
+        if (node->op != GGML_OP_MUL_MAT_ID || w == nullptr || w->buffer == nullptr || w->view_src != nullptr) {
+            continue;
+        }
+        if (ggml_backend_buffer_is_host(w->buffer) &&
+            ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_ANY) {
+            ggml_backend_buffer_set_usage(w->buffer, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        }
+        if (debug_once) {
+            debug_once = false;
+            GGML_LOG_INFO("[rpc-moe] server sched: %s src0 %s buft %s usage %d host %d gpu-claims %d\n",
+                node->name, w->name, ggml_backend_buft_name(w->buffer->buft),
+                (int) ggml_backend_buffer_get_usage(w->buffer), (int) ggml_backend_buffer_is_host(w->buffer),
+                (int) ggml_backend_supports_buft(backends[0], w->buffer->buft));
+        }
+    }
+    // allocate here: graph_compute would reset the scheduler first (the
+    // assignments above mark it dirty) and drop every pin just made
+    if (!ggml_backend_sched_alloc_graph(sched, graph)) {
+        return GGML_STATUS_ALLOC_FAILED;
+    }
+    return ggml_backend_sched_graph_compute(sched, graph);
+}
