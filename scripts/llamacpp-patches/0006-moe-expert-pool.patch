+// ---- expert pools for host-resident MoE weights ------------------------------------------
+//
+// With --n-cpu-moe (or any host-resident routed-expert tensor) the scheduler
+// copies the experts a batch uses into a per-split staging tensor on every
+// token, and for single-token decode it does not even do that: it computes
+// the experts on the CPU because copying them all again would cost more than
+// the GPU saves. A pool changes that arithmetic. Every expert weight tensor
+// that reaches the "copy only the experts that are used" path gets a
+// persistent device tensor of GGML_MOE_POOL_EXPERTS slots managed as an LRU;
+// the MUL_MAT_ID node reads from the pool through a slot-remapped ids tensor,
+// experts already resident are not copied again, and decode-time MUL_MAT_ID
+// is sent to the GPU at any batch size. Results are byte-identical: the same
+// expert bytes are multiplied, only their address changes. A batch that needs
+// more experts than the pool holds (prefill) takes the original staging path.
+#include <memory>
+#include <string>
+#include <unordered_map>
+
+struct sched_moe_pool {
+    const struct ggml_tensor * weight = nullptr; // the host-resident expert tensor [ne0, ne1, n_expert]
+    struct ggml_tensor pool;                     // device tensor with the same row layout, ne[2] = cap
+    struct ggml_tensor ids;                      // device i32 [k, n_tokens] of pool slots
+    struct ggml_tensor staging;                  // full-size view over the shared staging buffer (bypass batches)
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_backend_buffer_t ids_buf = nullptr;
+    size_t ids_bytes = 0;
+    size_t expert_size = 0;
+    int cap = 0;
+    std::vector<int32_t> slot_expert;            // slot -> expert, -1 when empty
+    std::vector<uint64_t> slot_last;             // slot -> tick of last use (0 = never)
+    std::vector<uint64_t> slot_pin;              // slot -> tick whose MUL_MAT_ID reads it (never evict then)
+    std::vector<uint8_t>  slot_hot;              // slot is used by the serve in progress: never evict it
+    std::unordered_map<int32_t, int> where;      // expert -> slot
+    uint64_t tick = 0, hits = 0, misses = 0, bypassed = 0, prefetched = 0;
+    struct ggml_tensor * node = nullptr;         // the MUL_MAT_ID node last pointed at the pool
+    struct ggml_tensor * orig_ids = nullptr;     // that node's src[2] before the rewrite
+    int layer = -1;                              // "blk.<layer>." of the weight, -1 if unnamed
+    int backend_id = -1;
+    ggml_backend_event_t ev = nullptr;           // prefetch completion, recorded on the prefetch backend
+    bool ev_pending = false;
+};
+
+struct sched_moe_state {
+    int cap_experts = 0;            // GGML_MOE_POOL_EXPERTS: slots per tensor (0 = derive from bytes)
+    uint64_t pool_bytes = 0;        // GGML_MOE_POOL_BYTES: total budget, split evenly over the MoE weights seen
+    bool debug = false;
+    // pools are keyed by the weight's NAME: graphs are rebuilt (and, on an RPC
+    // server, deserialised) per call, so tensor pointers do not survive
+    std::unordered_map<std::string, std::unique_ptr<sched_moe_pool>> pools;
+    // the host-resident MoE weights of the current graph, refreshed at split time
+    std::unordered_map<std::string, const struct ggml_tensor *> weights;
+    size_t max_weight_bytes = 0;    // largest expert tensor seen: size of the shared staging buffer
+    // shared staging for batches that need more experts than a pool holds (prefill):
+    // one buffer for the whole scheduler, used by one split at a time
+    ggml_backend_buffer_t staging_buf = nullptr;
+    int staging_backend_id = -1;
+    std::vector<int32_t> remap;
+    // pre-gate prefetch: the graph's "ffn_moe_pregate-<L>" nodes and a second backend
+    // instance per device (its own stream) that carries the prefetch copies
+    std::unordered_map<int, struct ggml_tensor *> pregate;
+    ggml_backend_t prefetch_backend[GGML_SCHED_MAX_BACKENDS] = {};
+    std::vector<int32_t> pred;
+    std::vector<float> scores;
+    int pregate_extra = 0;   // GGML_MOE_PREGATE_EXTRA: experts to prefetch beyond the top-k
+};
+
+// "blk.12.ffn_up_exps.weight" -> 12, else -1
+static int sched_moe_layer_of(const char * name) {
+    if (name == nullptr || strncmp(name, "blk.", 4) != 0) {
+        return -1;
+    }
+    char * end = nullptr;
+    const long v = strtol(name + 4, &end, 10);
+    return (end != name + 4 && *end == '.' && v >= 0) ? (int) v : -1;
+}
+
+// "8G", "512M", "1000000" -> bytes
+static uint64_t sched_moe_parse_bytes(const char * s) {
+    char * end = nullptr;
+    const double v = strtod(s, &end);
+    if (end == s || v <= 0) {
+        return 0;
+    }
+    double mul = 1;
+    if (*end == 'G' || *end == 'g') mul = 1073741824.0;
+    else if (*end == 'M' || *end == 'm') mul = 1048576.0;
+    else if (*end == 'K' || *end == 'k') mul = 1024.0;
+    return (uint64_t) (v * mul);
+}
+
+static struct sched_moe_state * sched_moe_state_new(void) {
+    const char * env = getenv("GGML_MOE_POOL_EXPERTS");
+    const char * env_bytes = getenv("GGML_MOE_POOL_BYTES");
+    const int cap = env ? atoi(env) : 0;
+    const uint64_t bytes = env_bytes ? sched_moe_parse_bytes(env_bytes) : 0;
+    if (cap <= 0 && bytes == 0) {
+        return nullptr;
+    }
+    auto * st = new sched_moe_state();
+    st->cap_experts = cap > 0 ? cap : 0;
+    st->pool_bytes = bytes;
+    st->debug = getenv("GGML_MOE_POOL_DEBUG") != nullptr;
+    const char * extra = getenv("GGML_MOE_PREGATE_EXTRA");
+    st->pregate_extra = extra ? std::max(0, atoi(extra)) : 0;
+    return st;
+}
+
+static void sched_moe_state_free(struct sched_moe_state * st) {
+    if (st == nullptr) {
+        return;
+    }
+    for (auto & kv : st->pools) {
+        sched_moe_pool * p = kv.second.get();
+        if (st->debug && p) {
+            // the map key, not p->weight->name: the weight tensor may live in a graph
+            // context that is already gone (the rpc-server re-deserializes per call)
+            fprintf(stderr, "moe-pool %s: cap %d, hits %llu, misses %llu, prefetched %llu, bypassed batches %llu\n",
+                kv.first.c_str(), p->cap, (unsigned long long) p->hits,
+                (unsigned long long) p->misses, (unsigned long long) p->prefetched,
+                (unsigned long long) p->bypassed);
+        }
+        if (p == nullptr) {
+            continue;
+        }
+        if (p->ev) {
+            ggml_backend_event_free(p->ev);
+        }
+        if (p->buf) {
+            ggml_backend_buffer_free(p->buf);
+        }
+        if (p->ids_buf) {
+            ggml_backend_buffer_free(p->ids_buf);
+        }
+    }
+    for (int b = 0; b < GGML_SCHED_MAX_BACKENDS; b++) {
+        if (st->prefetch_backend[b]) {
+            ggml_backend_free(st->prefetch_backend[b]);
+        }
+    }
+    if (st->staging_buf) {
+        ggml_backend_buffer_free(st->staging_buf);
+    }
+    delete st;
+}
+
+// A weight the pool manages: a host-resident MoE expert tensor read by MUL_MAT_ID.
+static bool sched_moe_is_expert_weight(const struct ggml_tensor * node, const struct ggml_tensor * src) {
+    return node->op == GGML_OP_MUL_MAT_ID && node->src[0] == src && src->buffer != nullptr &&
+           ggml_backend_buffer_get_usage(src->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS &&
+           ggml_backend_buffer_is_host(src->buffer);
+}
+
+static bool sched_moe_is_pool_tensor(ggml_backend_sched_t sched, const struct ggml_tensor * weight, const struct ggml_tensor * t) {
+    if (sched->moe == nullptr || t == nullptr || weight == nullptr) {
+        return false;
+    }
+    auto it = sched->moe->pools.find(weight->name);
+    return it != sched->moe->pools.end() && it->second &&
+           (t == &it->second->pool || t == &it->second->staging);
+}
+
+// The ids tensor the ROUTER produced for this node. Once a node has been
+// pointed at a pool its src[2] is the slot-remapped tensor, and reading that
+// back would treat slot numbers as expert numbers on every token after the
+// first (that is exactly what happened on 2026-09-06).
+static struct ggml_tensor * sched_moe_router_ids(ggml_backend_sched_t sched, const struct ggml_tensor * weight, struct ggml_tensor * node) {
+    if (sched->moe != nullptr && weight != nullptr) {
+        auto it = sched->moe->pools.find(weight->name);
+        if (it != sched->moe->pools.end() && it->second && node->src[2] == &it->second->ids) {
+            return it->second->orig_ids;
+        }
+    }
+    return node->src[2];
+}
+
+static sched_moe_pool * sched_moe_pool_get(ggml_backend_sched_t sched, const struct ggml_tensor * weight,
+                                           ggml_backend_buffer_type_t buft, size_t expert_size, int64_t n_expert) {
+    auto & pools = sched->moe->pools;
+    auto it = pools.find(weight->name);
+    if (it != pools.end()) {
+        if (it->second) {
+            it->second->weight = weight; // the graph may have been rebuilt since
+        }
+        return it->second.get();
+    }
+    auto p = std::make_unique<sched_moe_pool>();
+    p->weight = weight;
+    p->expert_size = expert_size;
+    int cap = sched->moe->cap_experts;
+    if (cap <= 0 && sched->moe->pool_bytes > 0) {
+        const size_t n_w = std::max<size_t>(1, sched->moe->weights.size());
+        cap = (int) (sched->moe->pool_bytes / n_w / expert_size);
+    }
+    // never below what one decode batch needs: n_expert_used experts (the ids
+    // tensor's rows); a pool that cannot hold a batch would bypass every time
+    p->cap = (int) std::min<int64_t>(std::max<int>(cap, 8), n_expert);
+    // 512 B tail: MMQ reads a little past the last expert (see the staging copy)
+    const size_t bytes = (size_t) p->cap * expert_size + 512;
+    p->buf = ggml_backend_buft_alloc_buffer(buft, bytes);
+    if (p->buf == nullptr) {
+        GGML_LOG_WARN("moe-pool: cannot allocate %zu bytes for %s; no pool for it\n", bytes, weight->name);
+        pools[weight->name] = nullptr;
+        return nullptr;
+    }
+    ggml_backend_buffer_clear(p->buf, 0);
+    memset(&p->pool, 0, sizeof(p->pool));
+    p->pool.type = weight->type;
+    for (int d = 0; d < GGML_MAX_DIMS; d++) {
+        p->pool.ne[d] = weight->ne[d];
+        p->pool.nb[d] = weight->nb[d];
+    }
+    p->pool.ne[2] = p->cap;
+    p->pool.op = GGML_OP_NONE;
+    snprintf(p->pool.name, sizeof(p->pool.name), "%.*s#pool", (int) sizeof(p->pool.name) - 6, weight->name);
+    ggml_backend_tensor_alloc(p->buf, &p->pool, ggml_backend_buffer_get_base(p->buf));
+    memset(&p->ids, 0, sizeof(p->ids));
+    p->slot_expert.assign(p->cap, -1);
+    p->slot_last.assign(p->cap, 0);
+    p->slot_pin.assign(p->cap, 0);
+    p->slot_hot.assign(p->cap, 0);
+    p->layer = sched_moe_layer_of(weight->name);
+    for (int b = 0; b < sched->n_backends; b++) {
+        if (sched->bufts[b] == buft) {
+            p->backend_id = b;
+            break;
+        }
+    }
+    if (sched->moe->debug) {
+        fprintf(stderr, "moe-pool: %s -> %d of %lld experts (%.1f MiB) on %s\n", weight->name, p->cap,
+            (long long) n_expert, (double) bytes / 1048576.0, ggml_backend_buft_name(buft));
+    }
+    sched_moe_pool * raw = p.get();
+    pools[weight->name] = std::move(p);
+    return raw;
+}
+
+// A full-size view over the shared staging buffer, laid out like `weight`:
+// prefill batches that need more experts than the pool holds are copied here
+// by expert index, exactly as upstream copies into its per-split staging.
+static struct ggml_tensor * sched_moe_staging(ggml_backend_sched_t sched, sched_moe_pool * p,
+                                              const struct ggml_tensor * weight, int backend_id) {
+    auto & st = *sched->moe;
+    const size_t need = ggml_nbytes(weight) + 512;
+    if (st.staging_buf == nullptr || st.staging_backend_id != backend_id ||
+        ggml_backend_buffer_get_size(st.staging_buf) < need) {
+        if (st.staging_buf) {
+            ggml_backend_buffer_free(st.staging_buf);
+        }
+        const size_t bytes = std::max(need, st.max_weight_bytes + 512);
+        st.staging_buf = ggml_backend_buft_alloc_buffer(sched->bufts[backend_id], bytes);
+        if (st.staging_buf == nullptr) {
+            return nullptr;
+        }
+        ggml_backend_buffer_clear(st.staging_buf, 0);
+        st.staging_backend_id = backend_id;
+        for (auto & kv : st.pools) {
+            if (kv.second) {
+                kv.second->staging.data = nullptr;   // re-described below on next use
+                kv.second->staging.buffer = nullptr;
+            }
+        }
+    }
+    if (p->staging.data == nullptr || p->staging.buffer != st.staging_buf) {
+        memset(&p->staging, 0, sizeof(p->staging));
+        p->staging.type = weight->type;
+        for (int d = 0; d < GGML_MAX_DIMS; d++) {
+            p->staging.ne[d] = weight->ne[d];
+            p->staging.nb[d] = weight->nb[d];
+        }
+        p->staging.op = GGML_OP_NONE;
+        snprintf(p->staging.name, sizeof(p->staging.name), "%.*s#stg", (int) sizeof(p->staging.name) - 5, weight->name);
+        ggml_backend_tensor_alloc(st.staging_buf, &p->staging, ggml_backend_buffer_get_base(st.staging_buf));
+    }
+    return &p->staging;
+}
+
+// Refresh the map of pre-gate nodes for the graph about to be computed.
+static void sched_moe_scan_pregate(ggml_backend_sched_t sched) {
+    sched->moe->pregate.clear();
+    for (int i = 0; i < sched->graph.n_nodes; i++) {
+        const struct ggml_tensor * t = sched->graph.nodes[i];
+        if (strncmp(t->name, "ffn_moe_pregate-", 16) == 0) {
+            sched->moe->pregate[atoi(t->name + 16)] = sched->graph.nodes[i];
+        }
+    }
+    // pools whose weight pointer went stale with a rebuilt graph are refreshed
+    // from the split-time registry (prefetch dereferences p->weight->data)
+    for (auto & kv : sched->moe->weights) {
+        auto it = sched->moe->pools.find(kv.first);
+        if (it != sched->moe->pools.end() && it->second) {
+            it->second->weight = kv.second;
+        }
+    }
+    static bool reported = false;
+    if (sched->moe->debug && !reported) {
+        reported = true;
+        fprintf(stderr, "moe-pool: pre-gate nodes in graph: %zu (of %d nodes)\n",
+            sched->moe->pregate.size(), sched->graph.n_nodes);
+    }
+}
+
+// Layer `layer` has just had its router read back (a synchronization point
+// the scheduler pays anyway). If the graph carries this layer's pre-gate
+// prediction, move the predicted experts of layer+1 into that layer's pools on
+// the prefetch backend, so they arrive while this layer computes. Only for
+// single-token batches: a prefill batch predicts nearly everything.
+static void sched_moe_prefetch_next(ggml_backend_sched_t sched, int layer, ggml_backend_t split_backend, int k) {
+    auto & st = *sched->moe;
+    if (layer < 0 || st.pregate.empty()) {
+        return;
+    }
+    auto pg_it = st.pregate.find(layer);
+    if (pg_it == st.pregate.end()) {
+        return;
+    }
+    const struct ggml_tensor * pg = pg_it->second;
+    if (pg->data == nullptr || pg->type != GGML_TYPE_F32 || pg->ne[1] != 1) {
+        return;
+    }
+    // rank the next layer's n_expert scores on the host (partial sort of ~256 floats)
+    const int64_t n = pg->ne[0];
+    const int64_t m = std::min<int64_t>(n, (int64_t) k + st.pregate_extra);
+    if (m <= 0) {
+        return;
+    }
+    st.scores.resize((size_t) n);
+    ggml_backend_synchronize(split_backend);
+    ggml_backend_tensor_get(pg, st.scores.data(), 0, (size_t) n * sizeof(float));
+    st.pred.resize((size_t) n);
+    for (int64_t i = 0; i < n; i++) {
+        st.pred[i] = (int32_t) i;
+    }
+    std::partial_sort(st.pred.begin(), st.pred.begin() + m, st.pred.end(),
+        [&](int32_t a, int32_t b) { return st.scores[a] > st.scores[b]; });
+
+    for (auto & kv : st.pools) {
+        sched_moe_pool * p = kv.second.get();
+        if (p == nullptr || p->layer != layer + 1 || p->backend_id < 0) {
+            continue;
+        }
+        ggml_backend_t pf = st.prefetch_backend[p->backend_id];
+        if (pf == nullptr) {
+            pf = ggml_backend_dev_init(ggml_backend_get_device(sched->backends[p->backend_id]), nullptr);
+            if (pf == nullptr) {
+                return;
+            }
+            st.prefetch_backend[p->backend_id] = pf;
+        }
+        if (p->ev == nullptr) {
+            p->ev = ggml_backend_event_new(ggml_backend_get_device(pf));
+        }
+        // prefetched slots get a fresh slot_last (evicted last by the next
+        // serve) but no pin: the next serve may still take them for a real
+        // miss. Within this call, slots just filled are excluded by the same
+        // fresh stamp.
+        const uint64_t next_tick = p->tick + 1;
+        int issued = 0;
+        for (int64_t i = 0; i < m; i++) {
+            const int32_t e = st.pred[i];
+            if (e < 0 || e >= (int32_t) p->weight->ne[2]) {
+                continue;
+            }
+            auto w = p->where.find(e);
+            if (w != p->where.end()) {
+                p->slot_last[w->second] = next_tick;
+                continue;
+            }
+            int slot = -1;
+            uint64_t oldest = UINT64_MAX;
+            for (int s = 0; s < p->cap; s++) {
+                if (p->slot_last[s] < next_tick && p->slot_pin[s] != p->tick && p->slot_last[s] < oldest) {
+                    oldest = p->slot_last[s];
+                    slot = s;
+                }
+            }
+            if (slot < 0) {
+                break;
+            }
+            if (p->slot_expert[slot] >= 0) {
+                p->where.erase(p->slot_expert[slot]);
+            }
+            p->slot_expert[slot] = e;
+            p->slot_last[slot] = next_tick;
+            p->where[e] = slot;
+            ggml_backend_tensor_set_async(pf, &p->pool,
+                (const uint8_t *) p->weight->data + (size_t) e * p->expert_size,
+                (size_t) slot * p->expert_size, p->expert_size);
+            issued++;
+        }
+        if (issued > 0 && p->ev) {
+            ggml_backend_event_record(p->ev, pf);
+            p->ev_pending = true;
+            p->prefetched += issued;
+        }
+    }
+}
+
+// Serve one MoE weight input of a split from its pool. Returns true when the
+// split's MUL_MAT_ID now reads the pool and every expert it needs is resident
+// or in flight; false when the batch needs more experts than the pool holds,
+// in which case the node is pointed back at the staging copy and the caller
+// takes the original path.
+static bool sched_moe_pool_serve(ggml_backend_sched_t sched, struct ggml_backend_sched_split * split,
+                                 struct ggml_tensor * input, struct ggml_tensor * input_cpy,
+                                 const struct ggml_tensor * ids_tensor, const std::vector<int32_t> & ids,
+                                 const std::vector<ggml_bitset_t> & used_ids, int64_t n_expert, size_t expert_size,
+                                 ggml_backend_t split_backend, int split_backend_id) {
+    sched_moe_pool * p = sched_moe_pool_get(sched, input, sched->bufts[split_backend_id], expert_size, n_expert);
+    if (p == nullptr) {
+        // the split's copy is only a one-expert placeholder now, so there is
+        // no path back to the upstream full copy: say what to change instead
+        GGML_ABORT("expert pool: cannot allocate a pool for '%s' (%zu bytes per expert); "
+                   "lower GGML_MOE_POOL_BYTES / GGML_MOE_POOL_EXPERTS or free device memory",
+                   input->name, expert_size);
+    }
+    int n_used = 0;
+    for (int64_t e = 0; e < n_expert; e++) {
+        if (ggml_bitset_get(used_ids.data(), e)) {
+            n_used++;
+        }
+    }
+    const bool fits = n_used <= p->cap;
+    struct ggml_tensor * stg = nullptr;
+    if (!fits) {
+        // prefill-sized batch: copy the used experts by index into the shared
+        // staging view (the per-split copy is only a one-expert placeholder now)
+        stg = sched_moe_staging(sched, p, input, split_backend_id);
+        if (stg == nullptr) {
+            return false;
+        }
+    }
+    for (int j = 0; j < split->graph.n_nodes; j++) {
+        struct ggml_tensor * nd = split->graph.nodes[j];
+        if (nd->op != GGML_OP_MUL_MAT_ID ||
