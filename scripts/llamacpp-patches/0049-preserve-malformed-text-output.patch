+static void test_raw_parse_fallback() {
+    auto parser = build_chat_peg_parser([](common_chat_peg_builder & p) {
+        return p.literal("<answer>") +
+               p.content(p.until("</answer>")) +
+               p.literal("</answer>") +
+               p.end();
+    });
+
+    common_chat_parser_params strict;
+    strict.format = COMMON_CHAT_FORMAT_PEG_NATIVE;
+
+    const std::string malformed = "<answer>OK</answer><think>";
+    bool strict_threw = false;
+    try {
+        (void) common_chat_peg_parse(parser, malformed, /*is_partial=*/false, strict);
+    } catch (const std::runtime_error &) {
+        strict_threw = true;
+    }
+    GGML_ASSERT(strict_threw && "structured parser failures must remain fail-closed by default");
+
+    auto fallback = strict;
+    fallback.allow_raw_content_fallback = true;
+    auto msg = common_chat_peg_parse(parser, malformed, /*is_partial=*/false, fallback);
+    assert_equals(std::string("OK<think>"), msg.content);
+
+    // A generation prompt belongs to the server-side parser state and must not
+    // leak into a salvaged answer.
+    fallback.generation_prompt = "<answer>";
+    msg = common_chat_peg_parse(parser, "OK</answer><think>", /*is_partial=*/false, fallback);
+    assert_equals(std::string("OK<think>"), msg.content);
+
+    // If the parser rejects its own generation prompt, preserve only the model
+    // bytes rather than exposing or dropping that prompt.
+    fallback.generation_prompt = "<wrong-prefix>";
+    msg = common_chat_peg_parse(parser, "RAW", /*is_partial=*/false, fallback);
+    assert_equals(std::string("RAW"), msg.content);
+}
+
+static void test_raw_parse_fallback_request_scope() {
+    auto tmpls = read_templates("models/templates/Qwen-Qwen3-0.6B.jinja");
+    server_chat_params opt;
+    opt.tmpls     = std::move(tmpls);
+    opt.use_jinja = true;
+
+    auto parse_flag = [&](json body) {
+        std::vector<raw_buffer> out_files;
+        auto llama_params = oaicompat_chat_params_parse(body, opt, out_files);
+        return llama_params.at("idletoken_raw_parse_fallback").get<bool>();
+    };
+    auto messages = json::array({json{{"role", "user"}, {"content", "hello"}}});
+
+    assert_equals(true, parse_flag(json{{"messages", messages}}));
+    assert_equals(false, parse_flag(json{
+        {"messages", messages},
+        {"response_format", json{{"type", "json_object"}}},
+    }));
+    assert_equals(false, parse_flag(json{
+        {"messages", messages},
+        {"grammar", "root ::= \"OK\""},
+    }));
+    assert_equals(false, parse_flag(json{
+        {"messages", messages},
+        {"tools", json::array({json{
+            {"type", "function"},
+            {"function", json{
+                {"name", "lookup"},
+                {"description", "Lookup a value"},
+                {"parameters", json{{"type", "object"}, {"properties", json::object()}}},
+            }},
+        }})},
+    }));
+}
